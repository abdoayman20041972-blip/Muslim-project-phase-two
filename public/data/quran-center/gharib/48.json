{"1":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"إِنَّا فَتَحْنَا لَكَ فَتْحًا مُبِينًا","meaning":"قضينا لك قضاءً عظيمًا"}]}],"4":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"هُوَ الَّذِي أَنْزَلَ السَّكِينَةَ فِي قُلُوبِ الْمُؤْمِنِينَ","meaning":"السكون والطمأنينة"}]}],"9":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَتُعَزِّرُوهُ","meaning":"تعظموه"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَتُعَزِّرُوهُ وَتُوَقِّرُوهُ","meaning":"تعزّروه: تعظّموه.."}]}],"12":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَكُنْتُمْ قَوْمًا بُورًا","meaning":"هَلْكَى"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَكُنْتُمْ قَوْمًا بُورًا","meaning":"هلكى"}]}],"25":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَالْهَدْيَ مَعْكُوفًا","meaning":"محبوسًا"},{"text":"أَنْ يَبْلُغَ مَحِلَّهُ","meaning":"مَنْحَرَه"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَالْهَدْيَ مَعْكُوفًا أَنْ يَبْلُغَ مَحِلَّهُ","meaning":"محبوسا واحدها فى قول أبى عمرو بن العلاء هدية مثل جدية السّرج والرّحل وهما البدادان"},{"text":"فَتُصِيبَكُمْ مِنْهُمْ مَعَرَّةٌ","meaning":"جناية كجناية العرّ وهو الجرب.."},{"text":"لَوْ تَزَيَّلُوا","meaning":"لو انمازوا.."}]}],"29":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَاسْتَغْلَظَ","meaning":"غلُظ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَاسْتَغْلَظَ","meaning":"غلظ.."},{"text":"فَاسْتَوى عَلى سُوقِهِ","meaning":"الساق حاملة الشجرة"},{"text":"أَخْرَجَ شَطْأَهُ","meaning":"أخرج فراخه يقال: قد أشطأ الزرع فهو مشطىء إذا فرخ"}]}]}
