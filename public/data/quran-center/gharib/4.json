{"1":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَبَثَّ مِنْهُمَا رِجَالا كَثِيرًا وَنِسَاءً","meaning":"نشرَ في الأرض"}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"عليكم","meaning":"ألم نغلب عليكم بالموالاة لكم"}]}],"3":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَإِنْ خِفْتُمْ أَلَّا تُقْسِطُوا","meaning":"وإن أيقنتم ألّا تعدلوا."},{"text":"فَإِنْ خِفْتُمْ أَلَّا تَعْدِلُوا","meaning":"» يريد أيقنتم، ولا علم لى بهذا لأنه قرآن، فإنما نحكيه عن رب العالمين"},{"text":"ذلِكَ أَدْنى أَلَّا تَعُولُوا","meaning":"أي أقرب ألا تجوروا، تقول: علت علىّ أي جرت علىّ."}]}],"4":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَآتُوا النِّساءَ صَدُقاتِهِنَّ نِحْلَةً","meaning":"أي مهورهن عن طيب نفس بالفريضة بذلك."}]}],"6":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَمَنْ كَانَ فَقِيرًا فَلْيَأْكُلْ بِالْمَعْرُوفِ","meaning":"يقتصد ولا يسرف"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَابْتَلُوا الْيَتامى","meaning":"أي اختبروهم."}]}],"9":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"قَوْلا سَدِيدًا","meaning":"قصْدًا"}]}],"11":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَقْرَبُ لَكُمْ نَفْعًا","meaning":"أدنى نفعا لكم."}]}],"25":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَآتُوهُنَّ أُجُورَهُنَّ","meaning":"أعطوهن مهورهن"},{"text":"وَمَنْ لَمْ يَسْتَطِعْ مِنْكُمْ طَوْلا","meaning":"لم يجد سعة"},{"text":"وَلا مُتَّخِذَاتِ أَخْدَانٍ","meaning":"متخذات أصدقاء"},{"text":"ذَلِكَ لِمَنْ خَشِيَ الْعَنَتَ مِنْكُمْ","meaning":"خشي على نفسه الفجور"}]}],"26":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"سُنَنَ الَّذِينَ مِنْ قَبْلِكُمْ","meaning":"أي سبل الذين من قبلكم."}]}],"28":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يُرِيدُ اللَّهُ أَنْ يُخَفِّفَ عَنْكُمْ","meaning":"إيجاب."}]}],"30":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"وَكَانَ ذَلِكَ عَلَى اللَّهِ يَسِيرًا","meaning":"سهلًا"}]}],"33":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"والّذين عاقدت أيمانكم","meaning":"عاقدة، حالفه."}]}],"34":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَلا تَبْغُوا عَلَيْهِنَّ","meaning":"أي لا تعللوا عليهن بالذنوب"}]}],"39":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَأَنْفَقُوا مِمَّا رَزَقَهُمُ اللَّهُ","meaning":"أي أعطوا فى وجوه الخير."}]}],"40":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مِثْقَالُ ذَرَّةٍ","meaning":"وزنُ ذرةٍ، وهي: النملة الحمراء الصغيرة"}]}],"42":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لَوْ تُسَوَّى بِهِمُ الأَرْضُ","meaning":"يكونون ترابا، فيستوون معها حتى يصيروا وهي شيئا واحدا"}]}],"43":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَتَيَمَّمُوا","meaning":"تعمدوا"},{"text":"صَعِيدًا طَيِّبًا","meaning":"ترابا نظيفا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلا جُنُبًا إِلَّا عابِرِي سَبِيلٍ","meaning":"معناه فى هذا الموضع: لا تقربوا المصلّى جنبا إلّا عابر سبيل يقطعه، ولا يقعد فيه"}]}],"44":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"نَصِيبًا مِنَ الْكِتَابِ","meaning":"حظا"},{"text":"نَصِيبًا","meaning":"حظا"}]}],"46":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنَ الَّذِينَ هادُوا يُحَرِّفُونَ الْكَلِمَ عَنْ مَواضِعِهِ","meaning":"هادوا فى هذا الموضع: اليهود، والكلم: جماعة كلمة، يحرّفون: يقلّبون ويغيّرون."}]}],"47":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنْ قَبْلِ أَنْ نَطْمِسَ وُجُوهًا","meaning":"أي نسوّيها حتى تعود كأقفائهم"}]}],"48":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"افْتَرى إِثْمًا عَظِيمًا","meaning":"أي تخلّقه."}]}],"49":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"اللَّهَ يُزَكِّي","meaning":"يُطَهِّر"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَلَمْ تَرَ إِلَى الَّذِينَ","meaning":"ليس هذا رأى عين، هذا تنبيه فى معنى: ألم تعرف."}]}],"51":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بِالْجِبْتِ وَالطَّاغُوتِ","meaning":"كلّ معبود من حجر أو مدر أو صورة أو شيطان فهو جبت وطاغوت."}]}],"54":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَمْ يَحْسُدُونَ النَّاسَ","meaning":"معناها: أيحسدون الناس."}]}],"55":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَكَفى بِجَهَنَّمَ سَعِيرًا","meaning":"أي وقودا."}]}],"56":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"سَوْفَ نُصْلِيهِمْ نَارًا","meaning":"نَشْويهم في نار"},{"text":"ليَذُوقوا العَذَابَ","meaning":"ليُبْلِغَ في أَلَمِهِمْ"}]}],"59":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"ذَلِكَ خَيْرٌ وَأَحْسَنُ تَأْوِيلا","meaning":"وأحسن عاقبة"},{"text":"وَأَحْسَنُ تَأْوِيلا","meaning":"أحسن عاقبة"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَإِنْ تَنازَعْتُمْ فِي شَيْءٍ","meaning":"أي اختلفتم."},{"text":"وَأُولِي الْأَمْرِ مِنْكُمْ","meaning":"أي ذوى الأمر"}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"ذَلِكَ خَيْرٌ وَأَحْسَنُ تَأْوِيلًا","meaning":"إِنَّ رَدَّكم ما اختلفتم فيه إِلى ما أَتى من عند اللَّه وترككم التَحارُب"},{"text":"تأويل","meaning":"شيء يستقر لك في هذه الحال"}]}],"65":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"شَجَرَ بَيْنَهُمْ","meaning":"أي اختلط."}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"حَتَّى يُحَكِّمُوكَ فِيمَا شَجَرَ بَيْنَهُمْ","meaning":"فيما وقع من الاختلاف بينهم"}]}],"66":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلَوْ أَنَّا كَتَبْنا عَلَيْهِمْ","meaning":"معناه: قضينا عليهم."},{"text":"ما فَعَلُوهُ إِلَّا قَلِيلٌ مِنْهُمْ","meaning":"ما فعلوه: استثناء قليل من كثير، فكأنه"}]}],"77":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لِمَ كَتَبْتَ عَلَيْنَا الْقِتالَ","meaning":"معناها: لم فرضته علينا."}]}],"78":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فِي بُرُوجٍ مُشَيَّدَةٍ","meaning":"قصور عالية"},{"text":"وَإِ