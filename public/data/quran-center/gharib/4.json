:[{"text":"فَلا جُنَاحَ عَلَيْهِمَا أَنْ يُصْلِحَا","meaning":"يتصالحا"}]}],"139":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"أَيَبْتَغُونَ عِنْدَهُمُ الْعِزَّةَ","meaning":"أيبْتَغِي المنافقون عند الكافرين العزة"}]}],"155":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"طَبَعَ اللَّهُ عَلَيْها","meaning":"أي ختم."}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"قُلُوبُنَا غُلْفٌ","meaning":"أوعية للعلم"}]}],"171":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لا تَغْلُوا فِي دِينِكُمْ","meaning":"لا تفرطوا فيه"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَرُوحٌ مِنْهُ","meaning":"أحياه الله فجعله روحا."},{"text":"وَلا تَقُولُوا ثَلاثَةٌ","meaning":"أي لا تقولوا: هم ثلاثة. َنْ يَسْتَنْكِفَ الْمَسِيحُ"}]}],"173":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَأَمَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحاتِ فَيُوَفِّيهِمْ أُجُورَهُمْ","meaning":"الألف مفتوحة وكذلك كل شىء فى القرآن إذا كان تمام كلامه بالفاء، وإذا كان تخييرا فألف"}]}]}
