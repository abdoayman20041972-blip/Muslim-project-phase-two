{"1":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَيْلٌ لِلْمُطَفِّفِينَ","meaning":"المطفّف الذي لا يوفى"}]}],"3":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَإِذَا كَالُوهُمْ أَوْ وَزَنُوهُمْ","meaning":"كالُوا لهم، [أ] وْ وَزَنوا لهم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَإِذا كالُوهُمْ أَوْ وَزَنُوهُمْ","meaning":"إذا كالوا لهم أو وزنوا لهم"}]}],"9":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مَرْقُومٌ","meaning":"مكتوب.."}]}],"14":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"كَلا بَلْ رَانَ عَلَى قُلُوبِهِمْ","meaning":"غلب"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"كَلَّا بَلْ رانَ عَلى قُلُوبِهِمْ","meaning":"غلب على قلبه والخمر ترين على عقل السكران والموت يرين على الميّت"}]}],"24":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"نَضْرَةَ النَّعِيمِ","meaning":"مصدر"}]}],"25":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"رَحِيقٍ","meaning":"الرحيق"},{"text":"مَخْتُومٍ","meaning":"له ختام. عاقبة ريح."}]}],"36":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"هَلْ ثُوِّبَ الْكُفَّارُ","meaning":"هل جوزى"}]}]}
