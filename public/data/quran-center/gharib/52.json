{"1":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَالطُّورِ","meaning":"هو الجبل فى كلام العرب.."}]}],"2":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَكِتابٍ مَسْطُورٍ","meaning":"أي مكتوب وقال رؤبة"}]}],"3":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فِي رَقٍّ","meaning":"أي فى ورق.."}]}],"4":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَالْبَيْتِ الْمَعْمُورِ","meaning":"الكثير الغاشية"}]}],"9":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَوْمَ تَمُورُ السَّماءُ مَوْرًا","meaning":"أي تكفأ"}]}],"12":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الَّذِينَ هُمْ فِي خَوْضٍ يَلْعَبُونَ","meaning":"الخوض الفتنة والاختلاط.."}]}],"13":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَوْمَ يُدَعُّونَ إِلَى نَارِ جَهَنَّمَ دَعًّا","meaning":"يُدفعون"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَوْمَ يُدَعُّونَ إِلى نارِ جَهَنَّمَ","meaning":"أي يدفعون، يقال: دعت فى قفاه أي دفعت وفى آية أخرى"}]}],"15":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَفَسِحْرٌ هذا","meaning":"ليس باستفهام بل هو توعّد.."}]}],"21":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنْ عَمَلِهِمْ مِنْ شَيْءٍ","meaning":"مجازها: ما ألتناهم شيئا والعرب تفعل هذا تزيد"}]}],"23":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لا لَغْوٌ فِيهَا وَلا تَأْثِيمٌ","meaning":"لا تَذهبُ بعقولهم فيَلْغُوا أو يَرفُثوا فيأثموا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَتَنازَعُونَ فِيها كَأْسًا","meaning":"يتعاطون أي يتداولون"}]}],"24":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"كَأَنَّهُمْ لُؤْلُؤٌ مَكْنُونٌ","meaning":"مصون.."}]}],"27":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"عَذابَ السَّمُومِ","meaning":"عذاب النار.."}]}],"38":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَمْ لَهُمْ سُلَّمٌ يَسْتَمِعُونَ فِيهِ","meaning":"هى السلّم وهو السلّم"}]}],"41":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَمْ عِنْدَهُمُ الْغَيْبُ فَهُمْ يَكْتُبُونَ","meaning":"فهم يخبرون بما شاءوا ويثبتون ما شاءوا.."}]}],"44":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"سَحَابٌ مَرْكُومٌ","meaning":"رُكام: بعضُه على بعض"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَإِنْ يَرَوْا كِسْفًا مِنَ السَّماءِ ساقِطًا","meaning":"أي قطعا وواحد الكسف كسفة مثل سدرة وسدر"},{"text":"سَحابٌ مَرْكُومٌ","meaning":"بعضه على بعض ركام.."}]}]}
