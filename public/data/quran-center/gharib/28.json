{"3":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مِنْ نَبَإِ مُوسَى","meaning":"من خَبَرِه"}]}],"4":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَجَعَلَ أَهْلَهَا شِيَعًا","meaning":"فِرَقًا وأصْنافًا في الخدمة"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِنَّ فِرْعَوْنَ عَلا فِي الْأَرْضِ","meaning":"أي عظم وشرف وغلب عليها وطغى.."},{"text":"وَجَعَلَ أَهْلَها شِيَعًا","meaning":"أي فرقا متفرقين"}]}],"7":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَأَلْقِيهِ فِي الْيَمِّ","meaning":"في البحر"}]}],"9":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَقالَتِ امْرَأَتُ فِرْعَوْنَ قُرَّتُ عَيْنٍ لِي وَلَكَ","meaning":"ومجازه مجاز المختصر الذي فيه ضمير كقولك: هذا قرة عين لى ولك وعلى هذا التفسير وقعت"}]}],"10":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَأَصْبَحَ فُؤادُ أُمِّ مُوسى فارِغًا","meaning":"مجازه: فارغا من الحزن لعلمها أنه لم يغرق"}]}],"12":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَحَرَّمْنَا عَلَيْهِ الْمَرَاضِعَ","meaning":"منعناه أن يرضع [منهن] و\"المراضع\": جمع \"مُرْضِع\""},{"text":"يَكْفُلُونَهُ","meaning":"يَضُمُّونه إليهم"}]}],"14":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَاسْتَوَى","meaning":"اسْتَحْكَم وانتهى شبابُه واستقرَّ: فلم تكن فيه زيادةٌ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بَلَغَ أَشُدَّهُ","meaning":"بلغ أي انتهى وموضع أشدّه موضع جميع ولا واحد له من لفظه"},{"text":"وَاسْتَوى","meaning":"أي استحكم وتمّ.."}]}],"15":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"هَذَا مِنْ شِيعَتِهِ","meaning":"من أصحابه"},{"text":"وَهَذَا مِنْ عَدُوِّهِ","meaning":"من أعدائه"},{"text":"فَقَضَى عَلَيْهِ","meaning":"قتله"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَقَضى عَلَيْهِ","meaning":"أي فقتله وأتى على نفسه.."}]}],"17":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَلَنْ أَكُونَ ظَهِيرًا","meaning":"أي معينا خائفا.."}]}],"19":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَنْ يَبْطِشَ بِالَّذِي هُوَ عَدُوٌّ لَهُما","meaning":"الطاء مكسورة ومضمومة لغتان.."}]}],"20":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَسْعَى","meaning":"يُسرِعُ [في مشيه]"},{"text":"إِنَّ الْمَلأَ يَأْتَمِرُونَ","meaning":"يَهِمُّون بك"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِنَّ الْمَلَأَ يَأْتَمِرُونَ بِكَ","meaning":"مجازه يهمون بك ويتوامرون فيك ويتشاورون"}]}],"22":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"تِلْقَاءَ مَدْيَنَ","meaning":"تِجَاهَ مدينَ ونحوها"}]}],"23":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَجَدَ عَلَيْهِ أُمَّةً مِنَ النَّاسِ يَسْقُونَ","meaning":"جماعةً"},{"text":"وَوَجَدَ مِنْ دُونِهِمُ امْرَأتَيْنِ تَذُودَانِ","meaning":"تكُفَّان غَنَمهما"},{"text":"قَالَ مَا خَطْبُكُمَا","meaning":"ما أمرُكما"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَجَدَ عَلَيْهِ أُمَّةً مِنَ النَّاسِ يَسْقُونَ","meaning":"أي جماعة.."},{"text":"تَذُودانِ","meaning":"مجازه: تمنعان وتردان وتطردان"},{"text":"قالَ ما خَطْبُكُما","meaning":"أي ما أمركما وحالكما وشأنكما"}]}],"28":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَلا عُدْوانَ عَلَيَّ","meaning":"وهو من العدا والتعدي والعدو واحد كله وهو الظلم.."}]}],"29":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"أَوْ جَذْوَةٍ مِنَ النَّارِ","meaning":"قطعةٍ منها"},{"text":"فَلَمَّا قُضِيَ","meaning":"فَرَغ [رسول الله ﷺ] من [قراءة القرآن و] تأويله"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"آنَسَ مِنْ جانِبِ الطُّورِ نارًا","meaning":"أي أبصر"}]}],"30":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"شاطِئِ الْوادِ الْأَيْمَنِ","meaning":"شطّ الوادي هو ضغة الوادي وعدوته وعدوتا وعدوتاه"}]}],"32":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"اسْلُكْ يَدَكَ فِي جَيْبِكَ","meaning":"أدْخِلْ يدَك، ي"}]}],"34":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَأَرْسِلْهُ مَعِيَ رِدْءًا","meaning":"مُعينًا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"هُوَ أَفْصَحُ مِنِّي لِسانًا","meaning":"لأن موسى كانت فى لسانه عقدة"},{"text":"رِدْءًا","meaning":"أي معينا"}]}],"35":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"سَنَشُدُّ عَضُدَكَ بِأَخِيكَ","meaning":"أي سنقويك به ونعينك به يقال إذا أعز رجل رجلا ومنعه: قد شد فلان على عضد فلان وهو من عاضدته على أمره أي عاونته"}]}],"37":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"عاقِبَةُ الدَّارِ","meaning":"وعاقبة الأمر أي آخره"}]}],"38":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"صَرْحًا","meaning":"قصرًا عاليًا"}]}],"41":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَئِمَّةً يَدْعُونَ إِلَى النَّارِ","meaning":"والإمام يكون فى الخير وفى الشر.."}]}],"42":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنَ الْمَقْبُوحِينَ","meaning":"مجازه: المهلكين"}]}],"43":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"لَعَلَّهُمْ يَتَذَكرُونَ","meaning":"لَعَلًهُمْ يَعْتَبِرْونَ"}]}],"44":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بِجانِبِ الْغَرْبِيِّ","meaning":"وهو حيث تغرب الشمس والنجوم والقمر.."}]}],"45":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلكِنَّا أَنْشَأْنا قُرُونًا","meaning":"أي خلقنا قرونا أي أمما.."},{"text":"الْعُمُرُ","meaning":"والعمر واحد وهما لغتان وهما مثل الضّعف والضّعف والمكث والمكث"},{"text":"ثاوِيًا فِي أَهْلِ مَدْيَنَ","meaning":"أي مقيما"}]}],"47":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلَوْلا أَنْ تُصِيبَهُمْ مُصِيبَةٌ","meaning":"وهى من كل نقمة وعذاب، نقمة بكسر القاف:."},{"text":"بِما قَدَّمَتْ أَيْدِيهِمْ","meaning":"مجازه: بما كانوا اكتسبوا وليس هاهنا.."}]}],"50":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَإِنْ لَمْ يَسْتَجِيبُوا لَكَ","meaning":"مجازه: فإن لم يجيبوك، وقال الغنوي"}]}],"51":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلَقَدْ وَصَّلْنَا لَهُمُ الْقَوْلَ","meaning":"أتْبَعنا بعضه بعضًا، فاتَّصل عندهم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلَقَدْ وَصَّلْنا لَهُمُ الْقَوْلَ","meaning":"أي أتممناه"}]}],"53":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَإِذا يُتْلى عَلَيْهِمْ","meaning":"أي يقرأ عليهم.."}]}],"54":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَيَدْرَؤُنَ بِالْحَسَنَةِ السَّيِّئَةَ","meaning":"مجازه: يدفعون السيّء بالحسن.."}]}],"55":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَإِذا سَمِعُوا اللَّغْوَ أَعْرَضُوا عَنْهُ","meaning":"مجازه هاهنا الفحش والقبيح.."}]}],"57":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"أَوَلَمْ نُمَكِّنْ لَهُمْ حَرَمًا آمِنًا","meaning":"ألم نُسْكِنْهُم إيَّاه ونجعله مكانًا لهم؟!"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يُجْبى إِلَيْهِ ثَمَراتُ كُلِّ شَيْءٍ","meaning":"مجازه يجمع كما يجبى الماء فى الجابية فيجمع للواردة"}]}],"58":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"بَطِرَتْ مَعِيشَتَهَا","meaning":"أشِرَت"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بَطِرَتْ مَعِيشَتَها","meaning":"مجازها أنها أشرت وطغت وبغت"}]}],"61":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"ثُمَّ هُوَ يَوْمَ الْقِيَامَةِ مِنَ الْمُحْضَرِينَ","meaning":"محضَرِي النارِ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنَ الْمُحْضَرِينَ","meaning":"أي من المشهدين.."}]}],"62":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَيَوْمَ يُنادِيهِمْ","meaning":"مجازه: يوم"}]}],"63":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"الَّذِينَ حَقَّ عَلَيْهِمُ الْقَوْلُ","meaning":"وَجَبتْ عليهم الحُجةُ، فوجب العذابُ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الَّذِينَ حَقَّ عَلَيْهِمُ الْقَوْلُ","meaning":"مجازه: وجب عليهم العقاب.."},{"text":"إِيَّانا يَعْبُدُونَ","meaning":"مجازه: مجاز إياك نعبد لأنه بدأ بالكناية قبل الفعل.."}]}],"66":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَعَمِيَتْ عَلَيْهِمُ الأَنْبَاءُ","meaning":"عَمُوا عنها -من شدة الهول يومئذٍ- فلم يُجيبوا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَعَمِيَتْ عَلَيْهِمُ الْأَنْباءُ","meaning":"مجازه: فخفيت عليهم الأخبار، يقال"}]}],"68":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مَا كَانَ لَهُمُ الْخِيَرَةُ","meaning":"لا يُرسل اللَّهُ الرسلَ على اختيارهم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَتَعالى عَمَّا يُشْرِكُونَ","meaning":"مجازه: عن الذين يشركون به."}]}],"75":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَنَزَعْنا مِنْ كُلِّ أُمَّةٍ شَهِيدًا","meaning":"مجازه: وأحضرنا من كل أمة، لها موضعان أحدهما: من كل أمة نبىّ"}]}],"76":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لا تَفْرَحْ","meaning":"أي لا تأشر ولا تمرح"}]}],"77":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلا تَنْسَ نَصِيبَكَ مِنَ الدُّنْيَا","meaning":"لا تترُك حظَّك منها"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلا تَنْسَ نَصِيبَكَ مِنَ الدُّنْيا","meaning":"مجازه: لا تدع حظّك وطلب الرزق الحلال منها.."}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"لا تنس نصيبك من الدنيا","meaning":"لا تنس أن تعمل به لآخرتك"}]}],"82":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَيْكَأَنَّ اللَّهَ","meaning":"مجازه: ألم تر أن الله يبسط الرزق"}]}],"85":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"إِنَّ الَّذِي فَرَضَ عَلَيْكَ الْقُرْآنَ","meaning":"أوجب عليك العمل به"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِنَّ الَّذِي فَرَضَ عَلَيْكَ الْقُرْآنَ","meaning":"مجازه: أنزل عليك.."}]}],"88":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"كُلُّ شَيْءٍ هالِكٌ إِلَّا وَجْهَهُ","meaning":"مجازه: إلّا هو وما استثنوه من جميع فهو منصوب وهذا المعنى بين النفختين"}]}]}
