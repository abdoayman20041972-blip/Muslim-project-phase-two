{"3":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"تَعالى جَدُّ رَبِّنا","meaning":"علا ملك ربّنا وسلطانه.."}]}],"4":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"عَلَى اللَّهِ شَطَطًا","meaning":"جَوْرًا في المقال"}]}],"6":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَزَادُوهُمْ رَهَقًا","meaning":"ضلالا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"رَهَقًا","meaning":"سفها وطغيانا.."}]}],"9":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"رَصَدًا","meaning":"حَفَظَةً تمنع من الاستماع"}]}],"11":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"كُنَّا طَرائِقَ قِدَدًا","meaning":"واحد الطرائق الطريقة واحد القدد قدّة أي ضروبا أو أجناسا.."}]}],"12":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَأَنَّا ظَنَنَّا أَنْ لَنْ نُعْجِزَ اللَّهَ","meaning":"اسْتَيْقَنَّا"}]}],"13":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَلا يَخَافُ بَخْسًا","meaning":"نقصًا من الثواب"},{"text":"وَلا رَهَقًا","meaning":"ظلمًا"}]}],"14":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَأُولَئِكَ تَحَرَّوْا رَشَدًا","meaning":"تَوَخَّوْهُ وأمُّوه"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"تَحَرَّوْا رَشَدًا","meaning":"توخّوا وعمدوا"}]}],"17":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَسْلُكْهُ عَذَابًا صَعَدًا","meaning":"عذابًا شاقًّا"}]}],"18":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَأَنَّ الْمَسَاجِدَ لِلَّهِ","meaning":"السُّجود لله"}]}],"19":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"كَادُوا يَكُونُونَ عَلَيْهِ لِبَدًا","meaning":"أي يَلْبُدون به [ويَتَراكبُون]:"}]}]}
