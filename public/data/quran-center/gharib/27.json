{"6":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَإِنَّكَ لَتُلَقَّى الْقُرْآنَ","meaning":"أي تأخذه عنه ويلقى عليك.."}]}],"7":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِنِّي آنَسْتُ نارًا","meaning":"أي أبصرت وأحسست بها.."}]}],"10":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"كَأَنَّها جَانٌّ","meaning":"وهى جنس من الحيّات.."}]}],"17":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَهُمْ يُوزَعُونَ","meaning":"يدفعون"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَهُمْ يُوزَعُونَ","meaning":"أي يدفعون فيستحث آخرهم ويحبس أولهم، وفى آية أخرى:."}]}],"18":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"قالَتْ نَمْلَةٌ يا أَيُّهَا النَّمْلُ ادْخُلُوا مَساكِنَكُمْ","meaning":"هذا من الحيوان الذي خرج مخرج الآدميّين، والعرب قد تفعل ذلك"}]}],"19":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"رَبِّ أَوْزِعْنِي","meaning":"ألهِمْني"},{"text":"قَالَ رَبِّ أَوْزِعْنِي","meaning":"ألهمْني"}]}],"21":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"أَوْ لَيَأْتِيَنِّي بِسُلْطَانٍ مُبِينٍ","meaning":"بعُذرٍ بَيِّنٍ"}]}],"22":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَمَكَثَ غَيْرَ بَعِيدٍ","meaning":"أي غير طويل، كاف"}]}],"23":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلَهَا عَرْشٌ عَظِيمٌ","meaning":"سرير"}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"وَأُوتِيَتْ مِنْ كُلِّ شَيْءٍ","meaning":"من كل شيء يؤتاه مِثْلُهَا وعلى هَذا"}]}],"25":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"الَّذِي يُخْرِجُ الْخَبْءَ فِي السَّمَاوَاتِ وَالأَرْضِ","meaning":"المستَتِرَ فيهما"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَلَّا يَسْجُدُوا لِلَّهِ","meaning":"مجازه الأمر، وهذه الياء التي قبل الألف."},{"text":"الَّذِي يُخْرِجُ الْخَبْءَ فِي السَّماواتِ وَالْأَرْضِ","meaning":"ما خبأت فى نفسك أي ما أسررت.."}]}],"37":[{"book":"غريب القرآن","author":"ابن قتيبة","wo