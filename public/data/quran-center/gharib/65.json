{"1":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لا تَدْرِي لَعَلَّ اللَّهَ يُحْدِثُ بَعْدَ ذَلِكَ أَمْرًا","meaning":"لعل الرجلَ يرغب فيها قبل انقضاء العدَّة، فيتزوجَها"}]}],"3":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لِكُلِّ شَيْءٍ قَدْرًا","meaning":"منتهى.."}]}],"4":[{"book":"التبيان في تفسير غريب القرآن","author":"ابن الهائم (ت ٨١٥هـ)","words":[{"text":"اللَّائِي","meaning":"واحدها التي والذي جميعا، واللاتي: جمع التي لا غير"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَأُولاتُ الْأَحْمالِ","meaning":"واحدها ذات.."}]}],"6":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مِنْ وُجْدِكُمْ","meaning":"بقدر سعتكم"},{"text":"وَأْتَمِرُوا بَيْنَكُمْ بِمَعْرُوفٍ","meaning":"هُمُّوا به، واعزموا عليه"},{"text":"وَإِنْ تَعَاسَرْتُمْ","meaning":"تضايقتم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنْ وُجْدِكُمْ","meaning":"من سعتكم، من الجدة."}]}],"7":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَمَنْ قُدِرَ عَلَيْهِ رِزْقُهُ","meaning":"ضُيِّقَ"}]}],"12":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"وَأَنَّ اللَّهَ قَدْ أَحَاطَ بِكُلِّ شَيْءٍ عِلْمًا","meaning":"قد علم كل شيء عِلْمًا"}]}]}
