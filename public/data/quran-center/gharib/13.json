{"2":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بِغَيْرِ عَمَدٍ","meaning":"متحرك الحروف بالفتحة، وبعضهم يحركها بالضمة لأنها جميع عمود وهو القياس لأن كل كلمة هجاؤها أربعة أحرف الثالث"},{"text":"كُلٌّ يَجْرِي","meaning":"مرفوع على الاستئناف وعلى"}]}],"3":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَهُوَ الَّذِي مَدَّ الْأَرْضَ","meaning":"أي بسطها فى الطول والعرض"}]}],"4":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَنَخِيلٌ صِنْوانٌ وَغَيْرُ صِنْوانٍ","meaning":"أي يكون أصله واحدا وفرعه متفرق، وواحده صنو والاثنان صنوان النون مجرورة فى موضع الرفع والنصب والجر كنون"},{"text":"وَنُفَضِّلُ بَعْضَها عَلى بَعْضٍ فِي الْأُكُلِ","meaning":"فى الثمرة والأكل."},{"text":"وَفِي الْأَرْضِ قِطَعٌ مُتَجاوِراتٌ","meaning":"أي متدانيات متقاربات غير جنات"}]}],"6":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَيَسْتَعْجِلُونَكَ بِالسَّيِّئَةِ","meaning":"بالعقوبة"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"خَلَتْ مِنْ قَبْلِهِمُ الْمَثُلاتُ","meaning":"واحدتها مثلة ومجازها مجاز الأمثال."}]}],"8":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَما تَزْدادُ","meaning":"أي ما تحدث وتحدث."}]}],"10":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَسارِبٌ بِالنَّهارِ","meaning":"مجازه: سالك فى سربه، أي مذاهبه"}]}],"12":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يُرِيكُمُ الْبَرْقَ خَوْفًا وَطَمَعًا","meaning":"أي ترهبونه وتطمعون أن يحييكم وأن يغيثكم."},{"text":"وَيُنْشِئُ السَّحابَ","meaning":"أي يبدأ السحاب"}]}],"13":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"شَدِيدُ الْمِحالِ","meaning":"أي العقوبة"}]}],"14":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِلَّا كَباسِطِ كَفَّيْهِ إِلَى الْماءِ لِيَبْلُغَ فاهُ","meaning":"مجازه: إن الذي يبسط كفّه ليقبض على الماء حتى يؤديه إلى فيه لا يتم له ذلك ولا تسقه"}]}],"15":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بِالْغُدُوِّ وَالْآصالِ","meaning":"أي بالعشي، واحدها: أصل وواحد الأصل أصيل وهو ما بين العصر إلى مغرب الشمس"}]}],"17":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَاحْتَمَلَ السَّيْلُ زَبَدًا رابِيًا","meaning":"مجازه: فاعل من ربا يربو. أي ينتفخ."}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"زَبَدٌ مِثْلُهُ","meaning":"مثل زَبَد الماءِ"}]}],"18":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الْمِهادُ","meaning":"الفراش"}]}],"19":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أُولُوا الْأَلْبابِ","meaning":"أي ذوو العقول، واحدها لبّ [وأولو: واحدها ذو.]"}]}],"22":[{"book":"التبيان في تفسير غريب القرآن","author":"ابن الهائم (ت ٨١٥هـ)","words":[{"text":"يَدْرَؤُنَ","meaning":"يدفعون."}]},{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَيَدْرَءُونَ بِالْحَسَنَةِ السَّيِّئَةَ","meaning":"يدفعون السيئة بالحسنة، كأنهم إذا سفهَ عليهم حلموا"}]}],"24":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"عُقْبَى الدَّارِ","meaning":"عاقبة الدار."}]}],"26":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَيَقْدِرُ","meaning":"يضيِّق عليه"}]}],"27":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مَنْ أَنابَ","meaning":"من تاب."}]}],"28":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"وَتَطْمَئِنُ قُلُوبُهُمْ بِذِكْرِ اللَّهِ","meaning":"إذا ذكر الله بوحدانيته آمنوا به غير"}]}],"29":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"طُوبى لَهُمْ وَحُسْنُ مَآبٍ","meaning":"أي منقلب."}]}],"30":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"خَلَتْ مِنْ قَبْلِها أُمَمٌ","meaning":"أي مضت قرون من قبلها وملل."}]}],"31":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بَلْ لِلَّهِ الْأَمْرُ جَمِيعًا","meaning":"فمجازه: لو سيّرت به الجبال لسارت، أو قطّعت به الأرض لتقطعت، ولو كلّم به الموتى لنشرت"},{"text":"قارِعَةٌ","meaning":"أي داهية مهلكة، وي"}]}],"32":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَأَمْلَيْتُ لِلَّذِينَ كَفَرُوا","meaning":"أمهلتهم وأَطَلْت لهم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَأَمْلَيْتُ","meaning":"أي أطلت لهم، ومنه الملىّ والملاوة من الدهر، ومنه تمليت حينا"}]}],"33":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَفَمَنْ هُوَ قائِمٌ عَلى كُلِّ نَفْسٍ","meaning":"أي دائم قوام عدل."}]}],"38":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لِكُلِّ أَجَلٍ كِتَابٌ","meaning":"وقت قد كُتِب"}]}],"39":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَمْحُوا اللَّهُ ما يَشاءُ","meaning":"محوت تمحو، وتمحى: لغة."}]}],"41":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"نَنْقُصُهَا مِنْ أَطْرَافِهَا","meaning":"بموت العلماء والعُبَّاد"},{"text":"لا مُعَقِّبَ لِحُكْمِهِ","meaning":"لا يَتَعَقَّبُه أحدٌ بتغيير ولا نقص"}]}]}
