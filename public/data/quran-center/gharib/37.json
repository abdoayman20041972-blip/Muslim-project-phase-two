{"3":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَالتَّالِياتِ ذِكْرًا","meaning":"أي القارئات والتالي القارئ."}]}],"6":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بِزِينَةٍ الْكَواكِبِ","meaning":"فمجازها: وحفظناها"}]}],"7":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَحِفْظًا مِنْ كُلِّ شَيْطانٍ مارِدٍ","meaning":"لم تعمل الباء فيها التي هى فى"}]}],"9":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلَهُمْ عَذَابٌ وَاصِبٌ","meaning":"دائمٌ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"دُحُورًا","meaning":"مصدر"},{"text":"عَذابٌ واصِبٌ","meaning":"أي دائم"}]}],"11":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَاسْتَفْتِهِمْ","meaning":"سَلْهم"},{"text":"مِنْ طِينٍ لازِبٍ","meaning":"لاصقٍ لازمٍ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَاسْتَفْتِهِمْ","meaning":"أي فسلهم.."},{"text":"مِنْ طِينٍ لازِبٍ","meaning":"مجازها مجاز"}]}],"14":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَإِذَا رَأَوْا آيَةً يَسْتَسْخِرُونَ","meaning":"يَسْخَرون"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَسْتَسْخِرُونَ","meaning":"ويسخرون سواء"}]}],"18":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَأَنْتُمْ داخِرُونَ","meaning":"صاغرون أشدّ الصغر، صاغر: داخر.."}]}],"20":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"هذا يَوْمُ الدِّينِ","meaning":"الثواب والحساب، تقول العرب: كما تدين تدان.."}]}],"22":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"احْشُرُوا الَّذِينَ ظَلَمُوا وَأَزْوَاجَهُمْ","meaning":"أشكالَهم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"احْشُرُوا الَّذِينَ","meaning":"مخرج المختصر.."}]}],"23":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَاهْدُوهُمْ إِلى صِراطِ الْجَحِيمِ","meaning":"تقول العرب: هديت المرأة إلى زوجها أي دللتها ومنهم من يقول: أهديتها، جعلها من الهدية إليه"}]}],"26":[{"book":"مجاز القرآن","author":"أبو ع