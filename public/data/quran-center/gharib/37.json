ماء الحارِّ يشربونه عليها"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ثُمَّ إِنَّ لَهُمْ عَلَيْها لَشَوْبًا مِنْ حَمِيمٍ","meaning":"تقول العرب: كل شىء خلطته بغيره فهو مشوب."}]}],"69":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَلْفَوْا آباءَهُمْ ضالِّينَ","meaning":"وجدوا.."}]}],"70":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يُهْرَعُونَ","meaning":"يستحثون من خلفهم"}]}],"78":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَتَرَكْنَا عَلَيْهِ","meaning":"أبقينا عليه ذِكْرًا حسنًا"}]}],"89":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"إِنِّي سَقِيمٌ","meaning":"سأسْقَم لا محالة"}]}],"93":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَرَاغَ عَلَيْهِمْ ضَرْبًا","meaning":"مال عليهم يضربُهم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَراغَ عَلَيْهِمْ ضَرْبًا بِالْيَمِينِ","meaning":"أي أجال عليهم ضربا للآلهة.."}]}],"94":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَأَقْبَلُوا إِلَيْهِ يَزِفُّونَ","meaning":"تقول العرب للنعامة: تزفّ وهو أول عدوها وآخر مشيها"}]}],"97":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَأَلْقُوهُ فِي الْجَحِيمِ","meaning":"في النار"}]}],"102":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَلَمَّا بَلَغَ مَعَهُ السَّعْيَ","meaning":"بلغ أن يَنْصرفَ معه ويُعينَه"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَلَمَّا بَلَغَ مَعَهُ السَّعْيَ","meaning":"أي أدرك ما أن يسعى على أهله أدرك وأعانه.."}]}],"103":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَلَمَّا أَسْلَمَا","meaning":"اسْتَسْلما لأمر الله"}]}],"107":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَفَدَيْنَاهُ بِذِبْحٍ عَظِيمٍ","meaning":"بكبشٍ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَفَدَيْناهُ بِذِبْحٍ عَظِيمٍ","meaning":"الذبح المذبوح والذّبح الفعل تقول العرب: قد كان بين بنى فلان وبين بنى فلان ذبح عظيم قتلى كثيرة.."}]}],"119":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَتَرَكْنا عَلَيْهِما فِي الْآخِرِينَ","meaning":"حكاية أي تركناهم"}]}],"125":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"أَتَدْعُونَ بَعْلا","meaning":"ربًّا"}]}],"127":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَإِنَّهُمْ لَمُحْضَرُونَ","meaning":"مجازها: لمهلكون.."}]}],"128":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِلَّا عِبادَ اللَّهِ","meaning":"استثناء."}]}],"140":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"إِلَى الْفُلْكِ الْمَشْحُونِ","meaning":"السفينة المملوءة"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِذْ أَبَقَ إِلَى الْفُلْكِ الْمَشْحُونِ","meaning":"فزع إلى الفلك.."}]}],"141":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَسَاهَمَ","meaning":"فقارَعَ"},{"text":"فَكَانَ مِنَ الْمُدْحَضِينَ","meaning":"من المَقْرُوعِين"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَساهَمَ فَكانَ مِنَ الْمُدْحَضِينَ","meaning":"تقول العرب: أدحض الله حجته أي أبطلها والدّحض الماء والزّلق"}]}],"142":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَهُوَ مُلِيمٌ","meaning":"مذنبٌ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَهُوَ مُلِيمٌ","meaning":"تقول العرب: ألام فلان فى أمره وذلك إذا أتى أمرا يلام عليه"}]}],"146":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"شَجَرَةً مِنْ يَقْطِينٍ","meaning":"كل شجرة لا تقوم على ساق فهى يقطين نحو الدبّا والحنظل والبطّيخ"}]}],"147":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَأَرْسَلْنَاهُ إِلَى مِائَةِ أَلْفٍ أَوْ يَزِيدُونَ","meaning":"ويزيدون"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِلى مِائَةِ أَلْفٍ أَوْ يَزِيدُونَ","meaning":"أو هاهنا ليس بشكّ وهى فى موضع آخر"}]}],"163":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"إِلا مَنْ هُوَ صَالِ الْجَحِيمِ","meaning":"من قُضِيَ عليه أن يَصْلَى الجحيمَ"}]}],"166":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَإِنَّا لَنَحْنُ الْمُسَبِّحُونَ","meaning":"المُصلُّون"}]}]}
