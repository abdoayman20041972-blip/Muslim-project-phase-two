{"1":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"اقْرَأْ بِاسْمِ رَبِّكَ","meaning":"مجازه: اقرأ اسم ربك.."}]}],"6":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"كَلَّا","meaning":"ليس الأمر على ما عليه أبوجهل"}]}],"8":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الرُّجْعى","meaning":"المرجع"}]}],"15":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لَنَسْفَعًا بِالنَّاصِيَةِ","meaning":"لَنَأْخُذَنَّ بها"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لَنَسْفَعًا بِالنَّاصِيَةِ","meaning":"لنأخذن بالناصية"}]}],"16":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ناصِيَةٍ كاذِبَةٍ","meaning":"بدل فجرّها.."}]}],"17":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَلْيَدْعُ نادِيَهُ","meaning":"أهل مجلسه.."}]}],"19":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبْ","meaning":"وتقرَّب إلى ربِّك بالطاعة"}]}]}
