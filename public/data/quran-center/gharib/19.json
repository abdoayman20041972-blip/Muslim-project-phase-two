{"5":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَكانَتِ امْرَأَتِي عاقِرًا","meaning":"أي لا تلد، وكذلك لفظ المذكّر مثل الأنثى"},{"text":"فَهَبْ لِي مِنْ لَدُنْكَ وَلِيًّا","meaning":"أي من عندك ولدا ووارثا وعضدا رضيّا يرثنى يرفعه قوم على الصفة، مجازه: هب لى وليا وارثا"}]}],"8":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مِنَ الْكِبَرِ عِتِيًّا","meaning":"يَبَسًا"}]}],"9":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"هُوَ عَلَيَّ هَيِّنٌ","meaning":"أي أهون."}]}],"11":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"أَنْ سَبِّحُوا","meaning":"صلُّو"}]}],"13":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَحَنَانًا","meaning":"رحمة"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَحَنانًا مِنْ لَدُنَّا","meaning":"أي رحمة"}]}],"16":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِذِ انْتَبَذَتْ مِنْ أَهْلِها","meaning":"اعتزلت وننحّت"},{"text":"مَكانًا شَرْقِيًّا","meaning":"مما يلى المشرق وهو عند العرب خير من الغربي الذي بلى المغرب."}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"مَكَانًَا شَرْقيًا","meaning":"نحو المشرق"}]}],"22":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مَكانًا قَصِيًّا","meaning":"أي بعيدا."}]}],"23":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَأَجَاءَهَا الْمَخَاضُ","meaning":"جَاءَ بِهَا وألْجَأَهَا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَكُنْتُ نَسْيًا مَنْسِيًّا","meaning":"وهو ما نسى من عصا أو أداوة أو غير ذلك"}]}],"25":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَهُزِّي إِلَيْكِ بِجِذْعِ النَّخْلَةِ","meaning":"مجازه: هزى إليك جذع النخلة، الياء من حروف الزوائد، وقال"}]}],"26":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"نَذَرْتُ لِلرَّحْمَنِ صَوْمًا","meaning":"صمتا"}]}],"46":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لأَرْجُمَنَّكَ","meaning":"لأَشتمنَّك"},{"text":"وَاهْجُرْنِي مَلِيًّا","meaning":"حينًا طويلا"}]}],"50":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَجَعَلْنَا لَهُمْ لِسَانَ صِدْقٍ عَلِيًّا","meaning":"ذكرًا حسنا عاليا"}]}],"58":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَاجْتَبَيْنا","meaning":"أي اخترنا."},{"text":"وَبُكِيًّا","meaning":"جمع باك"}]}],"59":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"فَسَوْفَ يَلْقَوْنَ غَيًّا","meaning":"فَسَوْفَ يلقون مُجازَاةَ الغَى كما"}]}],"62":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لا يَسْمَعُونَ فِيهَا لَغْوًا","meaning":"باطلا من الكلام"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لا يَسْمَعُونَ فِيها لَغْوًا","meaning":"أي هذرا وباطلا"}]}],"68":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"حَوْلَ جَهَنَّمَ جِثِيًّا","meaning":"جميع جاث"}]}],"69":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"عِتِيًّا","meaning":"مصدر عتوت تعتو."}]}],"72":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"ثم ننجي الذين اتقَوْا","meaning":"نخرج المتقين من جملة من ندخله النار"}]}],"73":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"خَيْرٌ مَقَامًا","meaning":"منزلا"},{"text":"وَأَحْسَنُ نَدِيًّا","meaning":"مجلسا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَأَحْسَنُ نَدِيًّا","meaning":"أي مجلسا والنّدى والنادي واحد"}]}],"74":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَرِءْيًا","meaning":"وهو ما ظهر عليه ورأيته عليه."}]}],"75":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَلْيَمْدُدْ لَهُ الرَّحْمَنُ مَدًّا","meaning":"يَمُدّ له في ضَلالته"}]}],"77":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَفَرَأَيْتَ الَّذِي كَفَرَ بِآياتِنا","meaning":"إذا استفهموا ب"}]}],"82":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَيَكُونُونَ عَلَيْهِمْ ضِدًّا","meaning":"أعداء يوم القيامة"}]}],"83":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"تَؤُزُّهُم