{"1":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"أَوْفُوا بِالْعُقُودِ","meaning":"بالعهود"}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"غَيْرَ مُحِلِّي الصَّيْدِ","meaning":"أُحلَّتْ لكم هذه لا مُحِلينَ الصيْدَ (وَأَنْتُمْ حُرُمٌ)"}]}],"2":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَبْتَغُونَ فَضْلا مِنْ رَبِّهِمْ","meaning":"يريدون فضلا من الله، أي رزقًا بالتجارة"},{"text":"وَإِذَا حَلَلْتُمْ","meaning":"خرجتم من إحرامكم"},{"text":"وَلا يَجْرِمَنَّكُمْ","meaning":"لا يكسبنكم"}]}],"3":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"غَيْرَ مُتَجَانِفٍ لإِثْمٍ","meaning":"منحرف مائل إلى ذلك"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ذلِكُمْ فِسْقٌ","meaning":"أي كفر."},{"text":"وَرَضِيتُ لَكُمُ الْإِسْلامَ دِينًا","meaning":"أي اخترت لكم."},{"text":"غَيْرَ مُتَجانِفٍ لِإِثْمٍ","meaning":"أي غير متعوّج مائل إليه، وكل منحرف، وكل أعوج فهو أجنف."}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"الن","meaning":"المفارقة قلَّت أو كثرتْ"}]}],"4":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مُكَلِّبِينَ","meaning":"أصحاب كلاب، وقال طفيل الغنوى"}]}],"6":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَوْ عَلى سَفَرٍ","meaning":"أو فى سفر."},{"text":"مِنْ حَرَجٍ","meaning":"أي ضيق."},{"text":"وَإِنْ كُنْتُمْ جُنُبًا فَاطَّهَّرُوا","meaning":"والواحد والإثنين والجميع فى الذكر والأنثى لفظه واحد: هو جنب، وهى جنب، وهما جنب، وهم جنب، وهنّ جنب."}]}],"8":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"قَوَّامِينَ لِلَّهِ شُهَداءَ بِالْقِسْطِ","meaning":"أي قائمين بالعدل، يقومون به، ويدومون عليه."}]}],"9":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لَهُمْ مَغْفِرَةٌ وَأَجْرٌ عَظِيمٌ","meaning":"فارتفعتا على القطع من أول الآية والفعل الذي فى أولهما، وعملت فيهما"}]}],"12":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَبَعَثْنا مِنْهُمُ اثْنَيْ عَشَرَ نَقِيبًا","meaning":"أي ضامنا ينقب عليهم وهو الأمين والكفيل على القوم."}]}],"13":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَنَسُوا حَظًّا مِمَّا ذُكِّرُوا بِهِ","meaning":"تركوا نصيبًا مما أُمروا به"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يُحَرِّفُونَ الْكَلِمَ","meaning":"يزيلون."},{"text":"وَنَسُوا حَظًّا مِمَّا ذُكِّرُوا بِهِ","meaning":"أي نصيبهم من الدين."},{"text":"قُلُوبَهُمْ قاسِيَةً","meaning":"أي يابسة صلبة من الخير وقال"}]}],"21":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"الَّتِي كَتَبَ اللَّهُ لَكُمْ","meaning":"جعلها لكم وأمركم أن تدخلوها"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الَّتِي كَتَبَ اللَّهُ لَكُمْ","meaning":"أي جعل الله لكم وقضاها."}]}],"23":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"عَلَيْهم","meaning":"لأن أكسبهم السَّخْطةَ"}]}],"25":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَافْرُقْ بَيْنَنا وَبَيْنَ الْقَوْمِ الْفاسِقِينَ","meaning":"أي باعد وافصل وميّز، وأصله: فعلت خفيفة من فعّلت ثقيلة"}]}],"26":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَلا تَأْسَ","meaning":"لا تحزن"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَتِيهُونَ فِي الْأَرْضِ","meaning":"أي يحورن ويحارون ويضلون."}]}],"27":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَاتْلُ عَلَيْهِمْ نَبَأَ ابْنَيْ آدَمَ","meaning":"خبرهما"}]}],"28":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بَسَطْتَ إِلَيَّ يَدَكَ","meaning":"أي مددت."}]}],"31":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"سَوْأَةَ أَخِيهِ","meaning":"أي فرج أخيه."}]}],"32":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مَنْ قَتَلَ نَفْسًا بِغَيْرِ نَفْسٍ أَوْ فَسادٍ فِي الْأَرْضِ","meaning":"مجازه: أو بغير فساد فى الأرض."},{"text":"لَمُسْرِفُونَ","meaning":"أي: لمفسدون معتدون."}]}],"33":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يُحارِبُونَ اللَّهَ وَرَسُولَهُ","meaning":"والمحاربة هاهنا: الكفر"}]}],"35":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَابْتَغُوا إِلَيْهِ الْوَسِيلَةَ","meaning":"أي القربة، أي اطلبوا، واتخذوا ذلك بطاعته، ويقال: توسلت إليه تقربت، وقال"}]}],"38":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَالسَّارِقُ وَالسَّارِقَةُ فَاقْطَعُوا أَيْدِيَهُما","meaning":"» (٥/ ٤١)، فى موضع يديهما. ومن مجاز ما جاء لا جماع له من لفظه فلفظ الواحد منه"},{"text":"نَكالًا مِنَ اللَّهِ","meaning":"أي عقوبة وتنكيلا."}]}],"41":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَمِنَ الَّذِينَ هادُوا سَمَّاعُونَ لِلْكَذِبِ","meaning":"وهو هاهنا من الذين تهوّدوا، فصاروا يهودا."}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"يُحَرِّفُونَ الْكَلِمَ مِنْ بَعْدِ مَوَاضِعِهِ","meaning":"من بعد أن وضَعه"},{"text":"وَإِنْ لَمْ تُؤْتَوْهُ فَاحْذَرُوا","meaning":"احذروا إِن أفتاكم النبي - ﷺ - بغير ما حدَّدْنَا لكم"}]}],"42":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَاحْكُمْ بَيْنَهُمْ بِالْقِسْطِ","meaning":"بالعدل"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَاحْكُمْ بَيْنَهُمْ بِالْقِسْطِ","meaning":"أي بالعدل"}]}],"44":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"بِمَا اسْتُحْفِظُوا","meaning":"استُودِعُوا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بِمَا اسْتُحْفِظُوا مِنْ كِتابِ اللَّهِ","meaning":"أي بما استودعوا، يقال استحفظته شيئا: أي استودعته"}]}],"48":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَمُهَيْمِنًا عَلَيْهِ","meaning":"أمينا عليه"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَمُهَيْمِنًا عَلَيْهِ","meaning":"أي مصدّقا مؤتمنا على القرآن وشاهدا عليه."},{"text":"لِكُلٍّ جَعَلْنا مِنْكُمْ شِرْعَةً","meaning":"أي سنة"}]}],"52":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بِالْفَتْحِ","meaning":"أي بالنّصر."}]}],"56":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَإِنَّ حِزْبَ اللَّهِ هُمُ الْغالِبُونَ","meaning":"أي أنصار الله"}]}],"64":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَأَلْقَيْنا بَيْنَهُمُ الْعَداوَةَ وَالْبَغْضاءَ","meaning":"أي جعلنا."},{"text":"كُلَّما أَوْقَدُوا نارًا لِلْحَرْبِ","meaning":"أي كلما نصبوا حربا."}]}],"66":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنْهُمْ أُمَّةٌ","meaning":"أي جماعة."}]}],"67":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَاللَّهُ يَعْصِمُكَ مِنَ النَّاسِ","meaning":"يمنعك منهم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَعْصِمُكَ مِنَ النَّاسِ","meaning":"يمنعك"}]}],"68":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لَسْتُمْ عَلى شَيْءٍ","meaning":"أي ليس فى أيديكم حجة ولا حق ولا بيان."},{"text":"فَلا تَأْسَ","meaning":"أي لا تحزن."}]}],"71":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"عَمُوا وَصَمُّوا كَثِيرٌ مِنْهُمْ","meaning":"مجازه على وجهين، أحدهما أن بعض العرب يظهرون كناية الاسم فى آخر الفعل مع إظهار الاسم الذي بعد"}]}],"75":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"ثُمَّ انْظُرْ","meaning":"انظر بعد البيان"}]}],"89":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بِاللَّغْوِ","meaning":"أي بالذي هو فضل: لا والله، وبلى والله، ما لم تحلفوا على حقّ تذهبون به"}]}],"93":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فِيمَا طَعِمُوا","meaning":"شربوا من الخمر قَبْلَ نزول التحريم"}]}],"94":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لَيَبْلُوَنَّكُمُ اللَّهُ بِشَيْءٍ مِنَ الصَّيْدِ","meaning":"أي ليختبرنكم وليبتلينكم."}]}],"95":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"أَوْ عَدْلُ ذَلِكَ صِيَامًا","meaning":"مثلُه"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لِيَذُوقَ وَبالَ أَمْرِهِ","meaning":"أي نكال أمره، وعذابه"},{"text":"وَمَنْ عادَ فَيَنْتَقِمُ اللَّهُ مِنْهُ","meaning":"رفع لأنه مجازات فيه، فمجازه فمن عاد فإن الله ينتقم منه، وعاد: فى موضع يعود"}]}],"103":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ما جَعَلَ اللَّهُ مِنْ بَحِيرَةٍ وَلا سائِبَةٍ","meaning":"أي: ما حرّم الله البحيرة التي كان أهل الجاهلية يحرّمونها، وكانوا يحرّمون وبرها وظهرها ولحمها» ولبنها على النساء"},{"text":"وَصِيلَةٍ","meaning":"فلا يذبح الذكر، يترك ذبحه من أجل أخته وإن كانتا اثنتين تركنا، فلم تذبحا وإذا ولدت سبعة أبطن"},{"text":"يَفْتَرُونَ عَلَى اللَّهِ الْكَذِبَ","meaning":"أي يختلقون الكذب على الله."}]}],"106":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"إِنِ ارْتَبْتُمْ","meaning":"شككتم"}]}],"110":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَإِذْ عَلَّمْتُكَ الْكِتابَ وَالْحِكْمَةَ","meaning":"أي علمتك."}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"القدس","meaning":"الذي يتطهر منه"}]}],"111":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَإِذْ أَوْحَيْتُ إِلَى الْحَوارِيِّينَ","meaning":"أي ألقيت فى قلوبهم، وقد فرغنا من تفسيرهم فى موضع قبل هذا"}]}],"112":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"هَلْ يَسْتَطِيعُ رَبُّكَ","meaning":"أي هل يريد ربك."}]}],"114":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"تَكُونُ لَنا عِيدًا لِأَوَّلِنا وَآخِرِنا","meaning":"مجاز العيد هاهنا: عائدة من الله علينا، وحجة وبرهان."},{"text":"وَآيَةً مِنْكَ","meaning":"أي: علما وعلامة."}]}],"116":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"اتَّخِذُونِي وَأُمِّي إِلهَيْنِ","meaning":"إذا أشركوا فعل ذكر مع فعل أنثى غلّب فعل الذّكر وذكّروهما."},{"text":"أَأَنْتَ قُلْتَ لِلنَّاسِ اتَّخِذُونِي وَأُمِّي","meaning":"هذا باب تفهيم"}]}],"117":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"أمرتني به","meaning":"اعبدوا"}]}],"118":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"إِنْ تُعَذِّبْهُمْ","meaning":"إِن تعذبْ من كفر منهم"}]}]}
