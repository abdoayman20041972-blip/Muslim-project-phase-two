{"3":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"لِقَوْمٍ يَعْلَمُونَ","meaning":"بيَّنا لمن يعلم"}]}],"8":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"غَيْرُ مَمْنُونٍ","meaning":"غير مقطوع"}]}],"10":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَقَدَّرَ فِيها أَقْواتَها","meaning":"واحدها قوت وهى الأرزاق وما احتيج إليه.."}]}],"11":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"قالَتا أَتَيْنا طائِعِينَ","meaning":"هذا مجاز الموات والحيوان الذي يشبّه تقدير فعله بفعل الآدميين.."}]}],"12":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَزَيَّنَّا السَّماءَ الدُّنْيا بِمَصابِيحَ وَحِفْظًا","meaning":"مجاز نصبها كنصب المصادر.."}]}],"16":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَأَرْسَلْنا عَلَيْهِمْ رِيحًا صَرْصَرًا","meaning":"الشديدة الصوت العاصف"},{"text":"نَحِساتٍ","meaning":"ذوات نحوس أي مشاييم"}]}],"17":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَأَمَّا ثَمُودُ فَهَدَيْنَاهُمْ","meaning":"دعوناهم ودلَلْناهم"}]}],"19":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يُوزَعُونَ","meaning":"يدفعون مجازها يفعلون من وزعت"}]}],"30":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"إِنَّ الَّذِينَ قَالُوا رَبُّنَا اللَّهُ ثُمَّ اسْتَقَامُوا","meaning":"آمنوا، ثم استقاموا على طاعة الله"}]}],"32":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"نُزُلا مِنْ غَفُورٍ رَحِيمٍ","meaning":"رزقًا"}]}],"47":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنْ أَكْمامِها","meaning":"أي أوعيتها واحدها كمّة وهو ما كانت فيه وكم وكمّة واحد وجمعها أكمام وأكمّة.."}]}],"49":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"قَنُوطٌ","meaning":"فعول من قنط ومجازهما واحد.."}]}],"54":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِرْيَةٍ","meaning":"ومرية"}]}]}
