{"1":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَالْقُرْآنِ ذِي الذِّكْرِ","meaning":"ذي الشرف"}]}],"3":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلاتَ حِينَ مَنَاصٍ","meaning":"لاتَ حين مَهْرَبٍ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَنادَوْا وَلاتَ حِينَ مَناصٍ","meaning":"إنما هى"}]}],"5":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِنَّ هذا لَشَيْءٌ عُجابٌ","meaning":"مجازه مجاز عجيب وقد تحوّل العرب"}]}],"10":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَلْيَرْتَقُوا فِي الأَسْبَابِ","meaning":"في أبواب السماء، إن كانوا صادقين"}]}],"15":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ما لَها مِنْ فَواقٍ","meaning":"من فتحها"}]}],"16":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"عَجِّلْ لَنا قِطَّنا","meaning":"القطّ: الكتاب"}]}],"17":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ذَا الْأَيْدِ","meaning":"ذا القوة وبعض العرب تقول آد"}]}],"21":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"تَسَوَّرُوا الْمِحْرَابَ","meaning":"صَعِدوا"}]}],"22":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلا تُشْطِطْ","meaning":"لا تَجُرْ علينا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"قالُوا لا تَخَفْ خَصْمانِ","meaning":"رجع إلى معنى الواحد منه.."},{"text":"وَلا تُشْطِطْ","meaning":"أي لا تسرف"}]}],"23":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَقَالَ أَكْفِلْنِيهَا","meaning":"ضُمَّهَا إليَّ واجعلني كافِلَها"},{"text":"وَعَزَّنِي فِي الْخِطَابِ","meaning":"غلبني في القول"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَقالَ أَكْفِلْنِيها","meaning":"مجازه مجاز"},{"text":"وَعَزَّنِي فِي الْخِطابِ","meaning":"أي صار أعزّ منى فيه"},{"text":"وَلِيَ نَعْجَةٌ واحِدَةٌ","meaning":"مجازها مجاز امرأة"}]}],"24":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"بِسُؤَالِ نَعْجَتِكَ إِلَى نِعَاجِهِ","meaning":"مضمومةً إلى نعاجه؛ فاختُصر"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بِسُؤالِ نَعْجَتِكَ","meaning":"مصدر"},{"text":"الْخُلَطاءِ","meaning":"الشركاء."}]}],"28":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَمْ نَجْعَلُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحاتِ كَالْمُفْسِدِينَ فِي الْأَرْضِ","meaning":"ليس لها جواب استفهام فخرجت مخرج التوعد.."}]}],"31":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِذْ عُرِضَ عَلَيْهِ بِالْعَشِيِّ الصَّافِناتُ الْجِيادُ","meaning":"من الخيل، والصافن الذي يجمع بين يديه"}]}],"32":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِنِّي أَحْبَبْتُ حُبَّ الْخَيْرِ عَنْ ذِكْرِ رَبِّي","meaning":"مجازه أحببته: حبّا ثم أضاف الحب إلى الخير.."},{"text":"حَتَّى تَوارَتْ بِالْحِجابِ","meaning":"المعنى للشمس وهى مضمرة."}]}],"33":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَطَفِقَ مَسْحًا بِالسُّوقِ وَالأَعْنَاقِ","meaning":"أقْبَل يمسَحُ بضرْبِ سوقِها وأعناقِها"}]}],"35":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"هَبْ لِي مُلْكًا لا يَنْبَغِي لِأَحَدٍ مِنْ بَعْدِي","meaning":"لا يكون لأحد من بعدي"}]}],"36":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"رُخَاءً","meaning":"رِخْوَةً ليِّنةً"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"حَيْثُ أَصابَ","meaning":"حيث أراد يقال: أصاب الله بك خيرا أي أراد الله بك خيرا"}]}],"38":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الْأَصْفادِ","meaning":"الأغلال واحدها صفد، والصفد أيضا الغطاء"}]}],"39":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَوْ أَمْسِكْ بِغَيْرِ حِسابٍ","meaning":"سبيلها سبيلان فأحدهما بغير جزاء والآخر بغير ثواب وبغير منّة ولا قلة"}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"فامنن","meaning":"فاعْطِ منه"}]}],"42":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"ارْكُضْ بِرِجْلِكَ","meaning":"اضرب الأَرضَ برجلك"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"هذا مُغْتَسَلٌ بارِدٌ","meaning":"وضوء غسول وهو ما اغتسلت به من الماء."},{"text":"وَشَرابٌ","meaning":"أي وتشرب منه والموضع الذي يغتسل فيه يسمّى مغتسلا.."},{"text":"ارْكُضْ بِرِجْلِكَ","meaning":"وهو مختصر والركض هو الدفع بالرجل وهى حركة الرجل، يقال: ركضنى الدابة ويقال: لم تركض ثوبك برجلك"}]}],"44":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَخُذْ بِيَدِكَ ضِغْثًا","meaning":"وهو ملء الكف من الشجر أو الحشيش والشّماريخ وما أشبه ذلك"}]}],"47":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الْأَخْيارِ","meaning":"والخيار واحد مثل الشّرار والأشرار.."}]}],"52":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَتْرابٌ","meaning":"أسنان واحدها [ترب] .."}]}],"58":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَآخَرُ مِنْ شَكْلِهِ","meaning":"مِن نحوِه"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنْ شَكْلِهِ","meaning":"من ضربه ما أنت من شكلى ما أنت من ضربى والشكل من المرأة ما علقت مما تحسّن به"}]}],"59":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"هذا فَوْجٌ","meaning":"والفوج الفرقة.."},{"text":"لا مَرْحَبًا بِهِمْ","meaning":"تقول العرب للرجل: لا مرحبا بك أي لا رحبت عليك أي لا اتسعت"}]}],"61":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مَنْ قَدَّمَ لَنَا هَذَا","meaning":"من سَنَّه وشَرَعه"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَزِدْهُ عَذابًا ضِعْفًا","meaning":"أي مضعّفا إليه مثله.."}]}],"83":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِلَّا عِبادَكَ مِنْهُمُ الْمُخْلَصِينَ","meaning":"الذين أخلصهم الله والمخلصين الذين أخلصوا.."}]}]}
