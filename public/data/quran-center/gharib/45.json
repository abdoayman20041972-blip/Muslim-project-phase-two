{"14":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لِلَّذِينَ لا يَرْجُونَ أَيَّامَ اللَّهِ","meaning":"لا يخافون.."}]}],"18":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"ثُمَّ جَعَلْنَاكَ عَلَى شَرِيعَةٍ","meaning":"على مِلَّة"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"عَلى شَرِيعَةٍ","meaning":"على طريقة وسنة.."}]}],"20":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"هذا بَصائِرُ لِلنَّاسِ","meaning":"مجازها: هذا القرآن بصائر للناس.."}]}],"21":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"سَواءً مَحْياهُمْ وَمَماتُهُمْ","meaning":"أي سواء حياة الكافر ومماته هو كافر حياته ومماته والمؤمن مؤمن حياته ومماته.."}]}],"28":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَتَرى كُلَّ أُمَّةٍ جاثِيَةً","meaning":"على الركب"}]}],"29":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"إِنَّا كُنَّا نَسْتَنْسِخُ مَا كُنْتُمْ تَعْمَلُونَ","meaning":"نكتب"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِنَّا كُنَّا نَسْتَنْسِخُ ما كُنْتُمْ تَعْمَلُونَ","meaning":"أي نثبت.."}]}],"32":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"قُلْتُمْ مَا نَدْرِي مَا السَّاعَةُ إِنْ نَظُنُّ إِلا ظَنًّا وَمَا نَحْنُ بِمُسْتَيْقِنِينَ","meaning":"ما نعلم ذلك إلا ظنًّا وحَدْسًا وما نستيقنه"}]}]}
