{"2":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَوْمَ تَرَوْنَها تَذْهَلُ كُلُّ مُرْضِعَةٍ","meaning":"أي تسلو وتنسى"}]}],"5":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَتَرَى الأَرْضَ هَامِدَةً","meaning":"مَيِّتَةً يابسةً"},{"text":"وَأَنْبَتَتْ مِنْ كُلِّ زَوْجٍ بَهِيجٍ","meaning":"من كل جنس حسن، يُبْهِجُ، أي يَشْرح"},{"text":"اهْتَزَّتْ","meaning":"اهتزت بالنبات"},{"text":"مِنْ كُلِّ زَوْجٍ بَهِيجٍ","meaning":"من كل جنسٍ حسن يُبْتَهج به"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنْ مُضْغَةٍ مُخَلَّقَةٍ","meaning":"أي مخلوقة.."},{"text":"أَرْذَلِ الْعُمُرِ","meaning":"مجازه أن يذهب العقل ويخرف.."},{"text":"وَتَرَى الْأَرْضَ هامِدَةً","meaning":"أي يابسة لا نبات فيها"},{"text":"زَوْجٍ بَهِيجٍ","meaning":"أي حسن قشيب جديد"}]}],"7":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَأَنَّ اللَّهَ يَبْعَثُ","meaning":"أي يجىء.."}]}],"9":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"ثَانِيَ عِطْفِهِ","meaning":"متكبر مُعرض"}]}],"11":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَمِنَ النَّاسِ مَنْ يَعْبُدُ اللَّهَ عَلى حَرْفٍ","meaning":"كل شاك فى شىء فهو على حرف لا يثبت ولا يدوم"}]}],"13":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لَبِئْسَ الْمَوْلَى","meaning":"الوَليّ"},{"text":"وَلَبِئْسَ الْعَشِيرُ","meaning":"الصاحب والخليل"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلَبِئْسَ الْعَشِيرُ","meaning":"الخليط المعاشر.."},{"text":"لَبِئْسَ الْمَوْلى","meaning":"مجازه هاهنا ابن العم"}]}],"15":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مَنْ كَانَ يَظُنُّ أَنْ لَنْ يَنْصُرَهُ اللَّهُ","meaning":"لن يرزقه الله"},{"text":"فَلْيَمْدُدْ بِسَبَبٍ إِلَى السَّمَاءِ","meaning":"بحبل إلى سقف البيت"},{"text":"ثُمَّ لِيَقْطَعْ فَلْيَنْظُرْ هَلْ يُذْهِبَنَّ كَيْدُهُ","meaning":"حِيلتُه غيظَه لِيَجْهَد جهْده، وقد ذكرت ذلك في تأويل المشكل بأكثر من هذا التفسير"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مَنْ كانَ يَظُنُّ أَنْ لَنْ يَنْصُرَهُ اللَّهُ","meaning":"مجازه أن لن يرزقه الله وأن لن يعطيه الله"},{"text":"فَلْيَمْدُدْ بِسَبَبٍ إِلَى السَّماءِ","meaning":"أي بحبل.."}]}],"19":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يُصَبُّ مِنْ فَوْقِ رُءُوسِهِمُ الْحَمِيمُ","meaning":"الماء الحار"}]}],"20":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يُصْهَرُ بِهِ","meaning":"يذاب به"}]}],"23":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلِباسُهُمْ فِيها حَرِيرٌ","meaning":"مجازه لبوسهم"}]}],"25":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَمَنْ يُرِدْ فِيهِ بِإِلْحَادٍ","meaning":"من يرد فيه إلحادا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَمَنْ يُرِدْ فِيهِ بِإِلْحادٍ","meaning":"مجازه ومن يرد فيه إلحادا والباء من حروف الزوائد وهو الزيغ والجور والعدل عن الحق وفى آية أخرى"},{"text":"سَواءً الْعاكِفُ فِيهِ","meaning":"أي المقيم فيه"}]}],"26":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَإِذْ بَوَّأْنَا لإِبْرَاهِيمَ مَكَانَ الْبَيْتِ","meaning":"جعلنا له بيتًا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَإِذْ بَوَّأْنا لِإِبْراهِيمَ","meaning":"مجازه من قوله: ليتنى كنت قبله قد بوّأت مضجعا"}]}],"27":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَأْتُوكَ رِجَالا","meaning":"رَجَّالةً، جمع رَاجِل، مثل صاحب وصِحَاب"},{"text":"وَعَلَى كُلِّ ضَامِرٍ","meaning":"رُكْبَانًا على ضُمْرٍ من طول السفر"},{"text":"مِنْ كُلِّ فَجٍّ عَمِيقٍ","meaning":"بعيد غامض"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَأَذِّنْ فِي النَّاسِ بِالْحَجِّ يَأْتُوكَ رِجالًا وَعَلى كُلِّ ضامِرٍ","meaning":"قوم يفتحون أول الحجّ وقوم يكسرونه وواحد الرجال راجل بمنزلة صاحب والجميع صحاب وتاجر والجميع تجار والقائم والجميع"},{"text":"يَأْتِينَ مِنْ كُلِّ فَجٍّ عَمِيقٍ","meaning":"أي بعيد"}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"وَعَلَى كُل ضَامِرٍ يَأتِيَن","meaning":"يأتوك رِجَالًا ورُكبَانلً"}]}],"28":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنْ بَهِيمَةِ الْأَنْعامِ","meaning":"خرجت مخرج"}]}],"30":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الزُّورِ","meaning":"الكذب.."}]}],"31":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"سَحِيقٍ","meaning":"والسحيق البعيد وهو من قولهم أبعده الله وأسحقه وسحقته الرّيح، ومنه نخلة سحوق أي طوبلة"}]}],"34":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"جَعَلْنَا مَنْسَكًا","meaning":"عيدًا"}]}],"36":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَإِذَا وَجَبَتْ جُنُوبُهَا","meaning":"سقطت"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَاذْكُرُوا اسْمَ اللَّهِ عَلَيْها صَوافَّ","meaning":"أي مصطفّة وتصفّ بين أيديها"},{"text":"وَأَطْعِمُوا الْقانِعَ وَالْمُعْتَرَّ","meaning":"مجازه السائل الذي قنع إليكم تقدير فعله: ذهب يذهب ومعناه سأل وخضع"},{"text":"فَإِذا وَجَبَتْ جُنُوبُها","meaning":"أي سقطت، ومنها وجوب الشمس إذا سقطت لتغيب، وقال أوس بن حجر"}]}],"40":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لَهُدِّمَتْ صَوامِعُ وَبِيَعٌ وَصَلَواتٌ","meaning":"مجازها مصلّيات"},{"text":"الَّذِينَ أُخْرِجُوا مِنْ دِيارِهِمْ بِغَيْرِ حَقٍّ إِلَّا أَنْ يَقُولُوا رَبُّنَا اللَّهُ","meaning":"مجازه مجاز المختصر الذي فيه ضمير كقولك: إلا أنهم يقولون الحق.."}]}],"42":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ وَعادٌ","meaning":"قوم، يذكّر ويؤنّث.."}]}],"44":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَكَيْفَ كَانَ نَكِيرِ","meaning":"إنْكاري"}]}],"45":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَكَأَيِّنْ مِنْ قَرْيَةٍ","meaning":"الياء من فكأيّن مثقلة وهى قراءة الستة ويخففها آخرون"}]}],"48":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَكَأَيِّنْ مِنْ قَرْيَةٍ","meaning":"أي كم من أهل قرية: هِيَ أَشَدُّ قُوَّةً مِنْ قَرْيَتِكَ الَّتِي أَخْرَجَتْكَ يريد: [أخرجك] أهلها"}]}],"55":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"وَلَا يَزَالُ الَّذِينَ كَفَرُوا فِي مِرْيَةٍ مِنْهُ","meaning":"في شك مِنه"},{"text":"حَتَّى تَأْتِيَهُمُ السَّاعَةُ بَغْتَةً","meaning":"مفاجأة"}]}],"72":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَكادُونَ يَسْطُونَ","meaning":"أي يفرطون عليه ومنه السطوة.."}]}],"74":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ما قَدَرُوا اللَّهَ حَقَّ قَدْرِهِ","meaning":"مجازه ما عرفوا الله حق معرفته، ولا وصفوه مبلغ صفته.."}]}],"78":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَمَا جَعَلَ عَلَيْكُمْ فِي الدِّينِ مِنْ حَرَجٍ","meaning":"ضيق"},{"text":"لِيَكُونَ الرَّسُولُ شَهِيدًا عَلَيْكُمْ","meaning":"قد بلغكم"},{"text":"فَنِعْمَ الْمَوْلَى","meaning":"الوَلِيّ"}]}]}
