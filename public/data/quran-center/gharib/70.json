{"9":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَتَكُونُ الْجِبَالُ كَالْعِهْنِ","meaning":"كالصوف"}]}],"11":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يُبَصَّرُونَهُمْ","meaning":"يُعَرَّفُونهم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنْ عَذابِ يَوْمِئِذٍ","meaning":"فمن جرّ الميم أضاف العذاب إلى اليوم إلى إذ ومن فتح الميم جعل الميم حرفا من وسطه كلمة"}]}],"36":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مُهْطِعِينَ","meaning":"مسرعين.."}]}],"37":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"عِزِينَ","meaning":"جماع عزة مثل ثبة وثبين وهى جماعات فى تفرقة"}]}],"42":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَذَرْهُمْ يَخُوضُوا وَيَلْعَبُوا","meaning":"مجازه: الوعيد.."}]}],"43":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"كَأَنَّهُمْ إِلى نُصُبٍ يُوفِضُونَ","meaning":"النصب الواحد، يوفضون يسرعون"}]}],"44":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"تَرْهَقُهُمْ ذِلَّةٌ","meaning":"تغشاهم ذِلًةٌ"}]}]}
