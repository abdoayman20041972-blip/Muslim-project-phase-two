{"2":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الزَّانِيَةُ وَالزَّانِي فَاجْلِدُوا كُلَّ واحِدٍ مِنْهُما","meaning":"مرفوعا من حيث رفع"}]}],"8":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَيَدْرَؤُا عَنْهَا الْعَذابَ","meaning":"مجازه، عنها الحدّ والرجم.."}]}],"11":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَالَّذِي تَوَلَّى كِبْرَهُ","meaning":"[عُظْمَهُ]"}]}],"12":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لَوْلا إِذْ سَمِعْتُمُوهُ ظَنَّ الْمُؤْمِنُونَ وَالْمُؤْمِنَاتُ بِأَنْفُسِهِمْ خَيْرًا","meaning":"بأمثالهم من المسلمين"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ظَنَّ الْمُؤْمِنُونَ وَالْمُؤْمِناتُ بِأَنْفُسِهِمْ خَيْرًا","meaning":"أي بأهل دينهم وبأمثالهم.."}]}],"15":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"إِذْ تَلَقَّوْنَهُ","meaning":"تَقْبَلُونه"}]}],"22":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلا يَأْتَلِ أُولُو الْفَضْلِ مِنْكُمْ","meaning":"لا يحلِف"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلا يَأْتَلِ أُولُوا الْفَضْلِ مِنْكُمْ","meaning":"مجازه ولا يفتعل من آليت: أقسمت، وله موضع آخر من ألوت بالواو"}]}],"27":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"حَتَّى تَسْتَأْنِسُوا","meaning":"حتى تستأذنوا"}]}],"31":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلا يَضْرِبْنَ بِأَرْجُلِهِنَّ لِيُعْلَمَ مَا يُخْفِينَ مِنْ زِينَتِهِنَّ","meaning":"لا يضربن بإحدى الرِّجلين على الأخرى ليصيب الخلخالُ الخلْخَالَ، فيعلم أن عليها خلْخَالَيْن"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"غَيْرِ أُولِي الْإِرْبَةِ","meaning":"مجازه مجاز الإربة الذين لهم فى النساء إربة وحاجة، وكان النبي ﷺ أملكهم"}]}],"32":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَالصَّالِحِينَ مِنْ عِبَادِكُمْ","meaning":"من عبيدكم"}]}],"33":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَالَّذِينَ يَبْتَغُونَ الْكِتَابَ","meaning":"يريدون المُكَاتَبَةَ من العبيد والإماء، على أنفسهم"},{"text":"وَآتُوهُمْ مِنْ مَالِ اللَّهِ","meaning":"أعطوهم، أو ضَعُوا عنهم شيئًا مما يلزمهم"}]}],"35":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فِيهَا مِصْبَاحٌ","meaning":"سراجٌ"},{"text":"لا شَرْقِيَّةٍ وَلا غَرْبِيَّةٍ","meaning":"ليستْ في مَشْرَُقَةٍ أبدًا، فلا يصيبها ظلٌّ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يُوقَدُ مِنْ شَجَرَةٍ مُبارَكَةٍ زَيْتُونَةٍ لا شَرْقِيَّةٍ وَلا غَرْبِيَّةٍ","meaning":"مجازه لا بشرقية تضحى للشمس ولا تصيب ظلا ولا بغربية فى الظل ولا يصيبها الشرق ولكنها شرقية وغربية"}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"غربيَّة","meaning":"تصيبها الشمس بالغداة"}]}],"37":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"تَتَقَلَّبُ فِيهِ الْقُلُوبُ وَالأَبْصَارُ","meaning":"تتقلب عمَّا كانت عليه في الدنيا: من الشك والكفر؛ وتتفتَّحُ فيه الأبصارُ من الأغْطية"}]}],"40":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لُجِّيٍّ","meaning":"مضاف إلى اللجة وهى معظم البحر.."}]}],"43":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يُزْجِي سَحَابًا","meaning":"يَسُوقُه"},{"text":"فَتَرَى الْوَدْقَ","meaning":"المطرَ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَلَمْ تَرَ أَنَّ اللَّهَ يُزْجِي سَحابًا","meaning":"أي يسوق.."},{"text":"فَتَرَى الْوَدْقَ","meaning":"أي القطر والمطر"},{"text":"يَخْرُجُ مِنْ خِلالِهِ","meaning":"أي من بين السحاب، يقال: من خلاله ومن خلله، قال زيد الخيل"}]}],"45":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَمِنْهُمْ مَنْ يَمْشِي عَلى بَطْنِهِ","meaning":"فهذا من التشبيه لأن المشي لا يكون على البطن إنما يكون لمن له قوائم فإذا خلطوا ماله قوائم"}]}],"49":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَأْتُوا إِلَيْهِ مُذْعِنِينَ","meaning":"مُقِرِّين خاضعين"}]}],"53":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"قُلْ لا تُقْسِمُوا طاعَةٌ مَعْرُوفَةٌ","meaning":"مرفوعتان، لأنهما كلامان لم يقع الأمر عليهما فينصبهما، مجاز"}]}],"54":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَإِنَّمَا عَلَيْهِ","meaning":"على الرسول"}]}],"56":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لَعَلَّكُمْ تُرْحَمُونَ","meaning":"واجبة من الله.."}]}],"58":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لَيْسَ عَلَيْكُمْ وَلا عَلَيْهِمْ جُنَاحٌ بَعْدَهُنَّ","meaning":"بعد هذه الأوقات"}]}],"61":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لَيْسَ عَلَيْكُمْ جُنَاحٌ أَنْ تَأْكُلُوا جَمِيعًا","meaning":"مُجْتَمِعِين"},{"text":"أَوْ أَشْتَاتًا","meaning":"مُفتَرِقين"},{"text":"لَيْسَ عَلَى الأَعْمَى حَرَجٌ","meaning":"إثم في ترك الغزو"},{"text":"أَشْتَاتًا","meaning":"فِرقًا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلا عَلَى الْمَرِيضِ حَرَجٌ","meaning":"وأصله الضّيق.."},{"text":"أَوْ ما مَلَكْتُمْ مَفاتِحَهُ","meaning":"أو ما ملكتم إنفاذه وإخراجه لا يزاحم فى شىء منه.."},{"text":"أَشْتاتًا","meaning":"شتّى وشتّات واحد.."}]}],"63":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"قَدْ يَعْلَمُ اللَّهُ الَّذِينَ يَتَسَلَّلُونَ مِنْكُمْ لِوَاذًا","meaning":"من يَسْتَتِرُ بصاحبه في اسْتِلالِهِ، ويخرجُ"}]}]}
