{"3":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"فَلَمَّا نَبَّأَتْ بِهِ","meaning":"فلما خَبَّرت به عائشةَ"}]}],"4":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَقَدْ صَغَتْ قُلُوبُكُمَا","meaning":"عَدَلَتْ ومالتْ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَقَدْ صَغَتْ قُلُوبُكُما","meaning":"قد عدلت ومالت"}]}],"8":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"تَوْبَةً نَصُوحًا","meaning":"تَنصَحون فيها لله، ولا تُدْهِنون"}]}],"12":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَكانَتْ مِنَ الْقانِتِينَ","meaning":"مجاز لفظ خبرها مجاز الذكور إذا كان مع المؤنث مذكّر."}]}]}
