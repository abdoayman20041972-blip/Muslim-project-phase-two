{"2":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَجِلَتْ قُلُوبُهُمْ","meaning":"أي خافت وفزعت، وقال معن بن أوس"}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"قلُوبُهُم","meaning":"فَزِعَتْ لذلك"}]}],"5":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"كَما أَخْرَجَكَ رَبُّكَ مِنْ بَيْتِكَ بِالْحَقِّ","meaning":"مجازها مجاز القسم، كقولك: والذي أخرجك ربك لأن"}]}],"7":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"غَيْرَ ذاتِ الشَّوْكَةِ","meaning":"مجاز الشوكة: الحد، يقال: ما أشد شوكة بنى فلان أي حدهم"}]}],"9":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بِأَلْفٍ مِنَ الْمَلائِكَةِ مُرْدِفِينَ","meaning":"مجازه: مجاز فاعلين، من أردفوا أي جاءوا بعد قوم قبلهم وبعضهم"}]}],"11":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَيُثْبِتُ","meaning":"يدعه ثابتًا فلا ينسخهُ، وهو المُحْكَمُ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"النُّعاسَ أَمَنَةً مِنْهُ","meaning":"وهى مصدر بمنزلة أمنت أمنة وأمانا [وأمنا]، كلهن سواء."},{"text":"وَيُثَبِّتَ بِهِ الْأَقْدامَ","meaning":"مجازه: يفرغ عليهم الصبر وينزله عليهم فيثبتون لعدوهم."},{"text":"رِجْزَ الشَّيْطانِ","meaning":"أي لطخ الشيطان، وما يدعو إليه من الكفر."}]}],"12":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَاضْرِبُوا فَوْقَ الأَعْنَاقِ","meaning":"الأعناق"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَاضْرِبُوا مِنْهُمْ كُلَّ بَنانٍ","meaning":"وهى أطراف الأصابع واحدتها بنانة"},{"text":"فَاضْرِبُوا فَوْقَ الْأَعْناقِ","meaning":"مجازه: على الأعناق، يقال: ضربته فوق الرأس وضربته على الرأس"}]}],"17":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَما رَمَيْتَ إِذْ رَمَيْتَ وَلكِنَّ اللَّهَ رَمى","meaning":"مجازه: ما ظفرت ولا أصبت ولكن الله أيّدك وأظفرك وأصاب بك ونصرك"}]}],"20":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلا تَوَلَّوْا عَنْهُ وَأَنْتُمْ تَسْمَعُونَ","meaning":"مجازه: ولا تدبروا عنه ولا تعرضوا عنه فتدعوا أمره."}]}],"24":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"اسْتَجِيبُوا لِلَّهِ","meaning":"مجازه: أجيبوا الله"},{"text":"إِذا دَعاكُمْ لِما يُحْيِيكُمْ","meaning":"مجازه: للذى يهديكم ويصلحكم وينجيكم من الكفر والعذاب."}]}],"25":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"منكم","meaning":"أشَد تَسَفُلًا"}]}],"29":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَجْعَلْ لَكُمْ فُرْقَانًا","meaning":"مَخْرَجًا"}]}],"32":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَأَمْطِرْ عَلَيْنا حِجارَةً مِنَ السَّماءِ","meaning":"مجازه أن كل شىء من العذاب فهو أمطرت بالألف وإن كان من الرحمة فهو مطرت."}]}],"40":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَنِعْمَ النَّصِيرُ","meaning":"الناصر"}]}],"42":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"إِذْ أَنْتُمْ بِالْعُدْوَةِ الدُّنْيَا","meaning":"الدنيا منكم"}]}],"46":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَتَذْهَبَ رِيحُكُمْ","meaning":"دَوْلَتُكم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَتَذْهَبَ رِيحُكُمْ","meaning":"مجازه: وتنقطع دولتكم."}]}],"48":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"نَكَصَ عَلَى عَقِبَيْهِ","meaning":"رجع القَهْقَرى"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"نَكَصَ عَلى عَقِبَيْهِ","meaning":"مجازه: رجع من حيث جاء."}]}],"50":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلَوْ تَرى إِذْ يَتَوَفَّى الَّذِينَ كَفَرُوا الْمَلائِكَةُ يَضْرِبُونَ وُجُوهَهُمْ وَأَدْبارَهُمْ وَذُوقُوا عَذابَ الْحَرِيقِ","meaning":"مجازه مجاز المختصر المضمر فيه وهو بمعنى ويقولون ذوقوا عذاب الحريق، والعرب تفعل ذلك"}]}],"57":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَإِمَّا تَثْقَفَنَّهُمْ","meaning":"تظفر بهم"}]}],"58":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَإِمَّا تَخافَنَّ مِنْ قَوْمٍ خِيانَةً فَانْبِذْ إِلَيْهِمْ عَلى سَواءٍ","meaning":"مجاز"}]}],"59":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلا يَحْسَبَنَّ الَّذِينَ كَفَرُوا سَبَقُوا","meaning":"فاتوا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِنَّهُمْ لا يُعْجِزُونَ","meaning":"لا يفوتون."}]}],"61":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَإِنْ جَنَحُوا لِلسَّلْمِ","meaning":"مالوا للصلح"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَإِنْ جَنَحُوا لِلسَّلْمِ","meaning":"أي رجعوا إلى المسالمة، وطلبوا الصلح وهو السلم مكسورة ومفتوحة ومتحركة الحروف بالفتحة واحد"}]}],"67":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"حَتَّى يُثْخِنَ فِي الْأَرْضِ","meaning":"مجازه: حتى يغلب ويغالب ويبالغ."}]}]}
