{"7":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَالْجِبَالَ أَوْتَادًا","meaning":"أوتادًا للأرض"}]}],"9":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا","meaning":"راحةً لأبدانكم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَجَعَلْنا نَوْمَكُمْ سُباتًا","meaning":"ليس بموت، رجل مسبوت فيه روح.."}]}],"13":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَجَعَلْنَا سِرَاجًا وَهَّاجًا","meaning":"وَقَّادًا؛ يعني: الشمسَ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَهَّاجًا","meaning":"الوهاج الوقّاد.."}]}],"16":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَلْفافًا","meaning":"ملتفّة"}]}],"18":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"فَتَأْتُونَ أَفْوَاجًا","meaning":"تأتي كل أمة مع إمَامِهِم"}]}],"24":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لا يَذُوقُونَ فِيهَا بَرْدًا","meaning":"نَوْمًا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بَرْدًا وَلا شَرابًا","meaning":"نوما ولا شرابا"}]}],"25":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَغَسَّاقًا","meaning":"صديدًا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"حَمِيمًا","meaning":"ماء."},{"text":"وَغَسَّاقًا","meaning":"وهو ما همى أي سال"}]}],"27":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"إِنَّهُمْ كَانُوا لا يَرْجُونَ حِسَابًا","meaning":"لا يخافون"}]}],"28":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"كِذَّابًا","meaning":"أشدّ من الكذب وهما مصدر المكاذبة"}]}],"34":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَكَأْسًا دِهَاقًا","meaning":"مُتْرَعَةً مَلأى"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"كَأْسًا دِهاقًا","meaning":"ملا.."}]}],"36":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"عَطاءً حِسابًا","meaning":"أي جزاء ويجىء: حسابا كافيا، يقال: أعطانى ما أحسبنى أي كفانى"}]}],"38":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَوْمَ يَقُومُ الرُّوحُ وَالْمَلائِكَةُ صَفًّا","meaning":"صُفُوفًا"}]}]}
