{"4":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"قَدْ عَلِمْنَا مَا تَنْقُصُ الأَرْضُ مِنْهُمْ","meaning":"تأكلُ من لحومهم إذا ماتوا"}]}],"5":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَهُمْ فِي أَمْرٍ مَرِيجٍ","meaning":"مختلط، يقال: قد مريج أمر الناس اختلط وأهمل قال أبو ذؤيب"}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"بِالْحَقِّ","meaning":"بالمَوْتِ الذي خلق له"}]}],"6":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَمَا لَهَا مِنْ فُرُوجٍ","meaning":"صدوع"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ما لَها مِنْ فُرُوجٍ","meaning":"أي فتوق واحدها فرج"}]}],"7":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنْ كُلِّ زَوْجٍ بَهِيجٍ","meaning":"أي حسن.."}]}],"8":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"تَبْصِرَةً وَذِكْرى لِكُلِّ عَبْدٍ مُنِيبٍ","meaning":"نصبها كنصب المصادر.."}]}],"10":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَالنَّخْلَ بَاسِقَاتٍ","meaning":"طوالا"},{"text":"لَهَا طَلْعٌ نَضِيدٌ","meaning":"منضودٌ: بعضُه فوق بعض"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَالنَّخْلَ باسِقاتٍ","meaning":"طوال"},{"text":"طَلْعٌ نَضِيدٌ","meaning":"منضود"}]}],"11":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"كَذلِكَ الْخُرُوجُ","meaning":"يوم القيامة"}]}],"12":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَأَصْحابُ الرَّسِّ","meaning":"المعدن وكل ركيّة لم تطو"}]}],"15":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"بَلْ هُمْ فِي لَبْسٍ","meaning":"في شكٍّ"},{"text":"مِنْ خَلْقٍ جَدِيدٍ","meaning":"من البعث"}]}],"16":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَقْرَبُ إِلَيْهِ مِنْ حَبْلِ الْوَرِيدِ","meaning":"وريداه فى حلقه والحبل حبل العاتق"}]}],"18":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"عَتِيدٌ","meaning":"ثابت لازم"}]}],"22":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"ف