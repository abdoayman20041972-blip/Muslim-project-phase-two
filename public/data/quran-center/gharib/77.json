{"1":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"عُرْفًا","meaning":"متتابعة"}]}],"2":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَالْعاصِفاتِ عَصْفًا","meaning":"الريح.."}]}],"8":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَإِذَا النُّجُومُ طُمِسَتْ","meaning":"ذهب ضوءها: كما يُطمَسُ الأثرُ حتى يذهبَ"}]}],"9":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَإِذَا السَّمَاءُ فُرِجَتْ","meaning":"فُتِحَتْ"}]}],"25":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"أَلَمْ نَجْعَلِ الأَرْضَ كِفَاتًا","meaning":"تضمُّكم فيها"}]}],"33":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"جمالات صفر","meaning":"سود، جمل أصفر أسود.."}]}],"36":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ","meaning":"مرفوعة."}]}]}
