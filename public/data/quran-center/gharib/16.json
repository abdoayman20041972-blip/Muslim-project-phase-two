{"5":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فِيها دِفْءٌ وَمَنافِعُ","meaning":"أي ما استدفئ به من أوبارها. ومنافع سوى ذلك."}]}],"6":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"حِينَ تُرِيحُونَ","meaning":"بالعشي"},{"text":"وَحِينَ تَسْرَحُونَ","meaning":"بالغداة."}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"وَحِينَ تَسْرَحُونَ","meaning":"حين تُخَلونها للرعْي"}]}],"7":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"بِشِقِّ الأَنْفُسِ","meaning":"بمشقة"}]}],"9":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَعَلَى اللَّهِ قَصْدُ السَّبِيلِ وَمِنْها جائِرٌ","meaning":"السبيل: لفظه لفظ الواحد، وهو فى موضع الجميع فكأنه: ومن السبيل سبيل جائر، وبعضهم يؤنث السبيل."}]}],"10":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فِيهِ تُسِيمُونَ","meaning":"تَرْعَون"}]}],"13":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَما ذَرَأَ لَكُمْ","meaning":"أي ما خلق لكم."}]}],"15":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَأَلْقى فِي الْأَرْضِ رَواسِيَ","meaning":"أي جعل فيها جبالا ثوابت قد رست."},{"text":"أَنْ تَمِيدَ بِكُمْ","meaning":"مجازه: أن لا تميل بكم."}]}],"21":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَيَّانَ يُبْعَثُونَ","meaning":"مجازه: متى يحيّون."}]}],"26":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَأَتَى اللَّهُ بُنْيانَهُمْ مِنَ الْقَواعِدِ","meaning":"مجازه مجاز المثل والتشبيه والقواعد الأساس. إذا استأصلوا شيئا"}]}],"28":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَأَلْقَوُا السَّلَمَ","meaning":"أي صالحوا وسالموا والسّلم والسّلم والسلام واحد."}]}],"44":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَالزُّبُرِ","meaning":"وهى الكتب واحدها: زبور"}]}],"47":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَوْ يَأْخُذَهُمْ عَلى تَخَوُّفٍ","meaning":"مجازه: على تنقّص"}]}],"48":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"