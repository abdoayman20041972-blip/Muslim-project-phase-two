{"7":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَإِذا بَرِقَ الْبَصَرُ","meaning":"إذا شق البصر وقال الكلابى"}]}],"8":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَخَسَفَ الْقَمَرُ","meaning":"وكسف القمر واحد، ذهب ضوءه.."}]}],"9":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَجُمِعَ الشَّمْسُ وَالْقَمَرُ","meaning":"لتذكير القمر.."}]}],"11":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"كَلا لا وَزَرَ","meaning":"لا ملجأَ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لا وَزَرَ","meaning":"لا جبل"}]}],"15":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مَعاذِيرَهُ","meaning":"ما اعتذر به [من] شىء.."}]}],"18":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَإِذَا قَرَأْنَاهُ","meaning":"جمعناهُ"},{"text":"فَاتَّبِعْ قُرْآنَهُ","meaning":"جَمْعه"}]}],"22":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وُجُوهٌ يَوْمَئِذٍ نَاضِرَةٌ","meaning":"مُشرقةٌ"}]}],"24":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَوُجُوهٌ يَوْمَئِذٍ بَاسِرَةٌ","meaning":"عابسةٌ مقطِّبةٌ"}]}],"25":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فاقِرَةٌ","meaning":"الفاقرة الداهية وهو الوسم الذي يفقر على الأنف"}]}],"26":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بَلَغَتِ التَّراقِيَ","meaning":"صارت النفس من تراقيه.."}]}],"27":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَقِيلَ مَنْ راقٍ","meaning":"من يرقى.."}]}],"29":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَالْتَفَّتِ السَّاقُ بِالسَّاقِ","meaning":"مثل شمرت عن ساقها.."}]}],"31":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَلا صَدَّقَ وَلا صَلَّى","meaning":"لم يصدق ولم يصل"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَلا صَدَّقَ وَلا صَلَّى","meaning":"لم يصدق فى الدنيا ولم يصل"}]}],"33":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَتَمَطَّى","meaning":"جاء يمشى الم