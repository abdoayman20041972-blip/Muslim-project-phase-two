{"1":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَالذَّارِياتِ ذَرْوًا","meaning":"هى الريح وناس يقولون: المذريات للريح، ذر وأذرت لغتان.."}]}],"2":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَالْحامِلاتِ وِقْرًا","meaning":"السحاب.."}]}],"3":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَالْجَارِيَاتِ يُسْرًا","meaning":"السفن تجري في الماء جريًا سهلا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَالْجارِياتِ يُسْرًا","meaning":"السّفن.."}]}],"4":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَالْمُقَسِّماتِ أَمْرًا","meaning":"الملائكة.."}]}],"7":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَالسَّماءِ ذاتِ الْحُبُكِ","meaning":"الطرائق ومنها سمى حباك الحائط الإطار وحباك الحمام طرائق على جناحيه، وطرائق الماء حبكه وقال زهير"}]}],"9":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يُؤْفَكُ عَنْهُ مَنْ أُفِكَ","meaning":"[يُصرفُ عنهُ و] يُحرَمُه من حُرمه يعني: القرآن"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يُؤْفَكُ عَنْهُ مَنْ أُفِكَ","meaning":"يدفع عنه ويحرمه كما تؤفك الأرض.."}]}],"10":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"قُتِلَ الْخَرَّاصُونَ","meaning":"لُعنَ الكَذَّابون الذين"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"قُتِلَ الْخَرَّاصُونَ","meaning":"المتكّهنون.."}]}],"14":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"ذُوقُوا فِتْنَتَكُمْ","meaning":"ذُوقوا عذابكم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ذُوقُوا فِتْنَتَكُمْ","meaning":"تم الكلام ثم جاء هذا بعد ائتناف.."}]}],"17":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَهْجَعُونَ","meaning":"ينامون"}]}],"18":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَبِالأَسْحَارِ هُمْ يَسْتَغْفِرُونَ","meaning":"يصلون"}]}],"26":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَراغَ إِلى أَهْلِهِ","meaning":"عدل"}]}],"28":[{"book":"مجاز القرآ