{"4":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"عَلَّمَهُ الْبَيَانَ","meaning":"الكلام"}]}],"5":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"الشَّمْسُ وَالْقَمَرُ بِحُسْبَانٍ","meaning":"بحسابٍ ومنازلَ لا يَعْدُونها"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الشَّمْسُ وَالْقَمَرُ بِحُسْبانٍ","meaning":"جميع حساب مثل شهبان وشهاب"}]}],"6":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَالنَّجْمُ وَالشَّجَرُ يَسْجُدانِ","meaning":"الشجر ما كان على ساق والنجم ما نجم من الأرض ولم يكن على ساق ومجازها على الأشجار وثنّى"}]}],"7":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَوَضَعَ الْمِيزَانَ","meaning":"العدل في الأرض"}]}],"8":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"أَلا تَطْغَوْا فِي الْمِيزَانِ","meaning":"ألا تجورُوا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَلَّا تَطْغَوْا فِي الْمِيزانِ","meaning":"أن لا تظلموا وتنقصوا.."}]}],"9":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَأَقِيمُوا الْوَزْنَ بِالْقِسْطِ","meaning":"بالعدل"},{"text":"وَلا تُخْسِرُوا الْمِيزَانَ","meaning":"لا تَنقُصوا الوزن"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلا تُخْسِرُوا","meaning":"أي لا تظلموا وتنقصوا، بالقسط والعدل.."}]}],"10":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَضَعَها لِلْأَنامِ","meaning":"للخلق.."}]}],"11":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"ذَاتُ الأَكْمَامِ","meaning":"ذات الكُفُرَّى قبل أن ينفتق"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَالنَّخْلُ ذاتُ الْأَكْمامِ","meaning":"واحدها كمّ.."}]}],"12":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَالْحَبُّ ذُو الْعَصْفِ وَالرَّيْحانُ","meaning":"تخرج له عصيفة وهى أذنته أعلاه وهو الهبوذ"}]}],"13":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَبِأَيِّ آلاءِ رَبِّكُما تُكَذِّبانِ","meaning":"أي فبأى نعمه، واحدها ألى، تقديرها قفى وقال بعضهم: تقديرها معى"}]}],"14":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"كَالْفَخَّارِ","meaning":"الفخار ما طبخ بالنار.."}]}],"15":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنْ مارِجٍ مِنْ نارٍ","meaning":"من خلط من النار"}]}],"17":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"رَبُّ الْمَشْرِقَيْنِ وَرَبُّ الْمَغْرِبَيْنِ","meaning":"أي مشرق الشتاء ومشرق الصيف، فإذا"}]}],"19":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مَرَجَ الْبَحْرَيْنِ يَلْتَقِيانِ","meaning":"مجازها مجاز قولك مرجت دابتك، خليت عنها وتركتها.."}]}],"24":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الْجَوارِ الْمُنْشَآتُ","meaning":"المجريات"}]}],"31":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"سَنَفْرُغُ لَكُمْ أَيُّهَ الثَّقَلانِ","meaning":"سنحاسبكم، لم يشغله شىء"}]}],"33":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لا تَنْفُذُونَ إِلا بِسُلْطَانٍ","meaning":"إلا بمُلكٍ وقَهرٍ"}]}],"35":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"شُواظٌ","meaning":"وشواظ واحد وهو النار التي تؤجج لا دخان فيها"},{"text":"وَنُحاسٌ","meaning":"ونحاس والنحاس الدخان"}]}],"37":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَكَانَتْ وَرْدَةً كَالدِّهَانِ","meaning":"حمراءَ في لون الفرس الوَرْدة"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَكانَتْ وَرْدَةً كَالدِّهانِ","meaning":"من لونها، جمع دهن، تمور كالدهن صافية، وردة لونها كلون الورد وهو الجلّ.."}]}],"41":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يُعْرَفُ الْمُجْرِمُونَ بِسِيمَاهُمْ","meaning":"بعلامات فيهم، يقال"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يُعْرَفُ الْمُجْرِمُونَ بِسِيماهُمْ","meaning":"علاماتهم فى الأصل أعلامهم.."}]}],"44":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَبَيْنَ حَمِيمٍ آنٍ","meaning":"بلغ إناه فى شدة الحر وكل مدرك آن وفى آية أخرى."}]}],"48":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ذَواتا أَفْنانٍ","meaning":"أي أغصان.."}]}],"54":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنْ إِسْتَبْرَقٍ","meaning":"يسمّى المتاع الصيني الذي ليس له صفاقة الديباج ولا خفّة الفرند إستبرقا"},{"text":"وَجَنَى الْجَنَّتَيْنِ دانٍ","meaning":"ما يجتنى قريبا لا يعنّى الجاني.."}]}],"56":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"قاصِراتُ الطَّرْفِ","meaning":"لا تطمح أبصارهن.."}]}],"70":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فِيهِنَّ خَيْراتٌ حِسانٌ","meaning":"امرأة خيرة ورجل خير والجميع خيرات ورجل أخيار وخيار"}]}],"72":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"حُورٌ مَقْصُوراتٌ فِي الْخِيامِ","meaning":"الحوراء: الشديدة بياض بياض العين والشديدة سواد سواد العين، مقصورات: أي خدّرن فى الخيام والخيام البيوت والهوادج أيضا"}]}],"76":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"رَفْرَفٍ خُضْرٍ","meaning":"فرش والبسط أيضا رفارف وتقول العرب لكل شىء من البسط.."},{"text":"عَبْقَرِيٍّ","meaning":"ويرون أنها أرض يوشّى فيها"}]}]}
