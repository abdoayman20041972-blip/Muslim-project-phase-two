{"4":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فِي كَبَدٍ","meaning":"في شدةِ غَلَبَةٍ، ومكابدةٍ لأمور الدنيا والآخرة"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"خَلَقْنَا الْإِنْسانَ فِي كَبَدٍ","meaning":"فى شدّة"}]}],"6":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مَالا لُبَدًا","meaning":"كثيرًا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مالًا لُبَدًا","meaning":"فعل من التلبّد وهو المال الكثير بعضه على بعض.."}]}],"10":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"النَّجْدَيْنِ","meaning":"الطريقين فى ارتفاع، نجد الخير ونجد الشر.."}]}],"11":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَلا اقْتَحَمَ الْعَقَبَةَ","meaning":"فلا هو اقتحم العقبة"}]}],"13":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَكُّ رَقَبَةٍ","meaning":"عِتقُها وفكُّها من الرِّق"}]}],"14":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"ذِي مَسْغَبَةٍ","meaning":"ذي مجاعة: [و\"السَّغَْب\": الجوع؛ و\"الساغِب\": الجائع]"}]}],"15":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَتِيمًا ذَا مَقْرَبَةٍ","meaning":"ذا قَرابةٍ"}]}],"16":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ","meaning":"ذا فقرٍ، كأنه لَصِق بالتراب [من الفقر]"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِسْكِينًا ذا مَتْرَبَةٍ","meaning":"قد لزق بالتراب.."}]}],"20":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"نَارٌ مُؤْصَدَةٌ","meaning":"مُطْبَقَةٌ [مُغْلَقة]"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"نارٌ مُؤْصَدَةٌ","meaning":"مطبقة"}]}]}
