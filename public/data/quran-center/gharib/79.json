{"1":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَالنَّازِعاتِ غَرْقًا","meaning":"النجوم تنزع تطلع ثم تغيب فيه وهى."}]}],"2":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"النَّاشِطاتِ نَشْطًا","meaning":"كالحمار الناشط ينشط من بلد إلى بلد والهموم تنشط صاحبها"}]}],"3":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَالسَّابِحَاتِ سَبْحًا","meaning":"الملائكة؛ جعل نزولها كالسِّباحة"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَالسَّابِحاتِ سَبْحًا","meaning":"هى أيضا النجوم"}]}],"6":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَوْمَ تَرْجُفُ الرَّاجِفَةُ","meaning":"أي القيامة.."}]}],"7":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"تَتْبَعُهَا الرَّادِفَةُ","meaning":"تَرْدَفُها أخرى"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"تَتْبَعُهَا الرَّادِفَةُ","meaning":"كل شىء بعد شىء يردفه فهو الرادفة الصيحة الثانية.."}]}],"8":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ","meaning":"[تَجِفُ و] تَخْفِق وتَجِب"}]}],"10":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَإِنَّا لَمَرْدُودُونَ فِي الْحافِرَةِ","meaning":"من حيث [جئنا]، كما"}]}],"12":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ","meaning":"رجعةٌ يُخْسَرُ فيها"}]}],"14":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الساهرة","meaning":"الفلاة ووجه الأرض"}]}],"16":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الْمُقَدَّسِ","meaning":"المبارك.."},{"text":"طُوىً","meaning":"وطوى مضمومة ومكسورة فمن لم ينوّن جعله اسما مؤنثا ومن نوّن جعله ثنى طوى جعله مرتين مصدر"}]}],"29":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"أَغْطَشَ لَيْلَهَا","meaning":"جعله مظلمًا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَغْطَشَ لَيْلَها","meaning":"أظلم وكل أغطش لا يبصر.."}]}],"39":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"الْمَأْوَى","meaning":"هي الْمَأْوَى له"}]}]}
