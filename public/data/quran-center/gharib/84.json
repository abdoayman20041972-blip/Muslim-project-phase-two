{"2":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَحُقَّتْ","meaning":"حُقَّ لها"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَأَذِنَتْ لِرَبِّها وَحُقَّتْ","meaning":"أذنت: استمعت"}]}],"6":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"إِنَّكَ كَادِحٌ","meaning":"عامل ناصب في معيشتك؛"}]}],"11":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَسَوْفَ يَدْعُو ثُبُورًا","meaning":"بالثبور، وهو: الهلكة"}]}],"14":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ظَنَّ أَنْ لَنْ يَحُورَ","meaning":"أن لن يرجع.."}]}],"17":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ما وَسَقَ","meaning":"ما علا فلم يمتنع منه شىء فإذا جلّل الليل الجبال والأشجار والبحار والأرض فأجمعت له فقد وسقها"}]}],"18":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَالْقَمَرِ إِذَا اتَّسَقَ","meaning":"امتلأ في الليالي البيض"}]}],"19":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لَتَرْكَبُنَّ طَبَقًا عَنْ طَبَقٍ","meaning":"حالا بعد حال"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لَتَرْكَبُنَّ طَبَقًا عَنْ طَبَقٍ","meaning":"أي لتركبنّ سنة الأولين وسنة من كان قبلكم.."}]}],"23":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَاللَّهُ أَعْلَمُ بِمَا يُوعُونَ","meaning":"يَجمعون في صدورهم وقلوبهم ي"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَعْلَمُ بِما يُوعُونَ","meaning":"كما يوعى المتاع، ووعته أذنى.."}]}],"25":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَجْرٌ غَيْرُ مَمْنُونٍ","meaning":"ليس فيه منّ ويجىء أيضا"}]}]}
