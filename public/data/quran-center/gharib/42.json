{"7":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَتُنْذِرَ يَوْمَ الْجَمْعِ","meaning":"تنذرهم بيوم الجمع، هو يوم القيامة"}]}],"11":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَذْرَؤُكُمْ فِيهِ","meaning":"يخلقكم في الرحم أو في الزوج"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَذْرَؤُكُمْ فِيهِ","meaning":"يخلقكم.."}]}],"14":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَما تَفَرَّقُوا إِلَّا مِنْ بَعْدِ ما جاءَهُمُ الْعِلْمُ بَغْيًا بَيْنَهُمْ","meaning":"نصبها على مجاز نصب المصادر.."}]}],"17":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"اللَّهُ الَّذِي أَنْزَلَ الْكِتَابَ بِالْحَقِّ وَالْمِيزَانَ","meaning":"العدل"}]}],"18":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مُشْفِقُونَ مِنْهَا","meaning":"خائفون"}]}],"20":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مَنْ كَانَ يُرِيدُ حَرْثَ الآخِرَةِ","meaning":"عمل الآخرة"}]}],"21":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"شَرَعُوا لَهُمْ","meaning":"ابتدعوا لهم"},{"text":"وَلَوْلا كَلِمَةُ الْفَصْلِ","meaning":"القضاء السابق الفصل: بأن الجزاء يوم القيامة"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"شَرَعُوا لَهُمْ مِنَ الدِّينِ","meaning":"ابتدعوا"}]}],"22":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"وَهُوَ وَاقِعٌ بِهِمْ","meaning":"وثواب كسْبِهِمْ وَاقِعٌ بِهِمْ"}]}],"23":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَمَنْ يَقْتَرِفْ حَسَنَةً","meaning":"يكتسبْ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ذلِكَ الَّذِي يُبَشِّرُ اللَّهُ عِبادَهُ","meaning":"معناها يبشّر"}]}],"26":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَيَسْتَجِيبُ الَّذِينَ آمَنُوا","meaning":"يجيبهم؛ كما"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَيَسْتَجِيبُ الَّذِينَ آمَنُوا","meaning":"أي يجيب الذين آمنوا.."}]}],"28":[{"book":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي (ت ٥٩٧هـ)","words":[{"text":"الرحمة","meaning":"المطر"}]}],"33":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَيَظْلَلْنَ رَوَاكِدَ عَلَى ظَهْرِهِ","meaning":"سواكنَ على ظهر البحر"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِنْ يَشَأْ يُسْكِنِ الرِّيحَ فَيَظْلَلْنَ","meaning":"المعنى للجوارى.."},{"text":"رَواكِدَ","meaning":"سواكن.."}]}],"34":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَوْ يُوبِقْهُنَّ","meaning":"يهلكهن."}]}],"38":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَأَمْرُهُمْ شُورَى بَيْنَهُمْ","meaning":"يَتَشاورون فيه"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَالَّذِينَ اسْتَجابُوا لِرَبِّهِمْ","meaning":"أجابوا.."}]}],"43":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِنَّ ذلِكَ لَمِنْ عَزْمِ الْأُمُورِ","meaning":"ما عزمت عليه"}]}],"45":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَنْظُرُونَ مِنْ طَرْفٍ خَفِيٍّ","meaning":"قد غَضُّوا أبصارهم من الذلِّ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنْ طَرْفٍ خَفِيٍّ","meaning":"لا يفتح عينه إنما ينظر ببعضها.."}]}],"49":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَهَبُ لِمَنْ يَشاءُ إِناثًا","meaning":"أي أنثى"},{"text":"وَيَهَبُ لِمَنْ يَشاءُ الذُّكُورَ","meaning":"أي ذكرا.."}]}],"50":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَوْ يُزَوِّجُهُمْ ذُكْرانًا وَإِناثًا","meaning":"أنثى وأنثى وذكرا وذكرا أو ذكرا وأنثى."}]}],"51":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"أَوْ يُرْسِلَ رَسُولا","meaning":"ملَكًا ["}]}]}
