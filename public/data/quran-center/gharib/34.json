{"2":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مَا يَلِجُ فِي الأَرْضِ","meaning":"يَدخلُ"},{"text":"وَمَا يَعْرُجُ فِيهَا","meaning":"يصعَدُ"},{"text":"يَعْلَمُ مَا يَلِجُ فِي الأَرْضِ","meaning":"يدخلُ فيها"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَعْلَمُ ما يَلِجُ فِي الْأَرْضِ","meaning":"أي يدخل ويغيب فيها"}]}],"3":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لا يَعْزُبُ عَنْهُ مِثْقالُ ذَرَّةٍ","meaning":"أي لا يشذّ ولا يغيب مث"}]}],"5":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَالَّذِينَ سَعَوْا فِي آياتِنا مُعاجِزِينَ","meaning":"أي مسابقين"}]}],"9":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِنْ نَشَأْ نَخْسِفْ بِهِمُ الْأَرْضَ أَوْ نُسْقِطْ عَلَيْهِمْ كِسَفًا مِنَ السَّماءِ","meaning":"أي قطعا، واحدتها كسفة، على تقدير سدرة وسدر.."}]}],"10":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يا جِبالُ أَوِّبِي مَعَهُ","meaning":"مجازه مجاز المختصر الذي فيه ضمير: وقلنا جبال أوّبى معه، والتأويب أن يبيت فى أهله"}]}],"11":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَقَدِّرْ فِي السَّرْدِ","meaning":"في النَّسْج، أي لا تَجعل المساميرَ دِقاقًا فَتَقْلَقَ ولا غِلاظًا فتكسِّرَ الحَلَقَ"}]}],"12":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلِسُلَيْمانَ الرِّيحَ","meaning":"منصوبة، عمل فيها"},{"text":"غُدُوُّها شَهْرٌ وَرَواحُها شَهْرٌ","meaning":"مجازه مجاز المختصر المضمر فيه غدوّها كأنه غدوّها مسيرة شهر ورواحها مسيرة شهر.."}]}],"13":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَجِفانٍ كَالْجَوابِ","meaning":"واحدتها جابية وهى الحوض الذي يجبى فيه الماء"},{"text":"وَقُدُورٍ راسِياتٍ","meaning":"عظام"}]}],"14":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"تَبَيَّنَتِ الْجِنُّ","meaning":"علمتْ وظهر لها العجزُ"}]}],"15":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لَقَدْ كانَ لِسَبَإٍ فِي مَسْكَنِهِمْ","meaning":"ينوّن"}]}],"16":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"سَيْلَ الْعَرِمِ","meaning":"واحدها عرمة"},{"text":"أُكُلٍ خَمْطٍ","meaning":"والخمط كل شجرة ذى شوك والأكل هو الجنى.."}]}],"18":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَقَدَّرْنَا فِيهَا السَّيْرَ","meaning":"جعلنا ما بيْنَ القريةِ والقريةِ مقدارًا واحدًا"}]}],"19":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَجَعَلْنَاهُمْ أَحَادِيثَ","meaning":"عظة ومُعْتَبَرًا"},{"text":"وَمَزَّقْنَاهُمْ كُلَّ مُمَزَّقٍ","meaning":"فرَّقناهم في كل وجه"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"رَبَّنا باعِدْ بَيْنَ أَسْفارِنا","meaning":"مجازه مجاز الدّعاء وقرأه قوم"},{"text":"وَمَزَّقْناهُمْ كُلَّ مُمَزَّقٍ","meaning":"أي قطعناهم وفرقناهم.."}]}],"20":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلَقَدْ صَدَّقَ عَلَيْهِمْ إِبْلِيسُ ظَنَّهُ","meaning":"مخفف ومثقل ومجازه أنه وجد ظنه بهم صادقا.."}]}],"21":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِلَّا لِنَعْلَمَ مَنْ يُؤْمِنُ بِالْآخِرَةِ","meaning":"مجازه: إلّا لنميز.."}]}],"22":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنْ ظَهِيرٍ","meaning":"أي من معين.."}]}],"26":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"ثُمَّ يَفْتَحُ بَيْنَنَا بِالْحَقِّ","meaning":"يقضي"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ثُمَّ يَفْتَحُ بَيْنَنا بِالْحَقِّ","meaning":"أي يحكم بيننا.."}]}],"28":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَما أَرْسَلْناكَ إِلَّا كَافَّةً لِلنَّاسِ","meaning":"أي إلّا عامّا.."}]}],"29":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مَتى هذَا الْوَعْدُ","meaning":"والوعيد والميعاد واحد.."}]}],"33":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"هَلْ يُجْزَوْنَ إِلَّا ما كانُوا يَعْمَلُونَ","meaning":"مجازها هاهنا مجاز الإيجاب وليس باستفهام، مجازه: ما يجزون إلّا ما كانوا يعملون.."}]}],"34":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِلَّا قالَ مُتْرَفُوها","meaning":"كفّارها المتكبرون.."}]}],"36":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"قُلْ إِنَّ رَبِّي يَبْسُطُ الرِّزْقَ لِمَنْ يَشاءُ وَيَقْدِرُ","meaning":"يبسط: يوسّع ويكثّر."}]}],"37":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"تُقَرِّبُكُمْ عِنْدَنَا زُلْفَى","meaning":"قُرْبَى ومنزلةً عندنا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَما أَمْوالُكُمْ وَلا أَوْلادُكُمْ بِالَّتِي تُقَرِّبُكُمْ عِنْدَنا زُلْفى","meaning":"مجاز."}]}],"40":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَيَوْمَ يَحْشُرُهُمْ جَمِيعًا ثُمَّ يَقُولُ لِلْمَلائِكَةِ أَهؤُلاءِ إِيَّاكُمْ كانُوا يَعْبُدُونَ","meaning":"مجاز الألف هاهنا مجاز الإيجاب والإخبار والتقرير وليست بألف الاستفهام بل هى تقرير للذين عبدوا الملائكة وأبس لهم"}]}],"45":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَكَيْفَ كانَ نَكِيرِ","meaning":"أي تغييرى وعقوبتى.."}]}],"46":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مَثْنَى","meaning":"أي اثنين اثنين"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مَثْنى وَفُرادى","meaning":"اثنين اثنين وفردا فردا ولا ينوّن فى مثنى، زعم النحويون لأنه صرف عن وجهه.."}]}],"48":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَقْذِفُ بِالْحَقِّ","meaning":"يلقيه إلى أنبيائه صلوات الله عليهم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"قُلْ إِنَّ رَبِّي يَقْذِفُ بِالْحَقِّ عَلَّامُ الْغُيُوبِ","meaning":"أي يأتى بالحقّ.."}]}],"51":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَأُخِذُوا مِنْ مَكَانٍ قَرِيبٍ","meaning":"قريبٍ على الله؛ يعني القبورَ"}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"فَلَا فَوْتَ","meaning":"فلا فوت لهم"}]}],"52":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَنَّى لَهُمُ","meaning":"أي كيف لهم وأين.."},{"text":"التَّناوُشُ","meaning":"يجعله من لم يهمزه"}]}],"53":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَيَقْذِفُونَ بِالْغَيْبِ","meaning":"بالظنِّ أن التوبةَ تنفعُهم"}]}]}
