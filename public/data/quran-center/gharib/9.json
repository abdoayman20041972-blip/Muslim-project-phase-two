{"2":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَسِيحُوا فِي الأَرْضِ أَرْبَعَةَ أَشْهُرٍ","meaning":"اذهبوا آمنين أربعة أشهر أو أقل [من كانت مدة عهده إلى أكثر من أربعة أشهر أو أقل] فإن"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَسِيحُوا فِي الْأَرْضِ","meaning":"مجازه: سيروا وأقبلوا وأدبروا"}]}],"12":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"منهم","meaning":"نن بعد ما كادوا يَقْفِلون مِنْ غَزْوَتهِم للشدةِ"}]}],"18":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلَمْ يَخْشَ إِلَّا اللَّهَ فَعَسى أُولئِكَ أَنْ يَكُونُوا مِنَ الْمُهْتَدِينَ","meaning":"عسى هاهنا واجبة من الله."}]}],"25":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"فِي مَوَاطِنَ كَثيرةٍ","meaning":"في أمكنةٍ"}]}],"29":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلا يَدِينُونَ دِينَ الْحَقِّ","meaning":"مجازه: لا يطيعون الله طاعة الحق، وكل من أطاع مليكا فقد دان له"}]}],"30":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يُضاهِؤُنَ قَوْلَ الَّذِينَ كَفَرُوا مِنْ قَبْلُ","meaning":"ومجاز المضاهات مجاز التشبيه."}]}],"34":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَالَّذِينَ يَكْنِزُونَ الذَّهَبَ وَالْفِضَّةَ وَلا يُنْفِقُونَها","meaning":"صار الخبر عن أحدهما، ولم يقل"}]}],"36":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الدِّينُ الْقَيِّمُ","meaning":"مجازه: القائم أي المستقيم، خرج مخرج سيّد، وهو من ساد يسود"},{"text":"وَقاتِلُوا الْمُشْرِكِينَ كَافَّةً","meaning":"أي عامة، يقال: جاءونى كافة، أي جميعا"}]}],"40":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَأَيَّدَهُ","meaning":"قواه بملائكة"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِنَّ اللَّهَ مَعَنا","meaning":"أي ناصرنا وحافظنا."}]}],"47":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مَا زَادُوكُمْ إِلا خَبَالا","meaning":"شرا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِلَّا خَبالًا","meaning":"الخبال: الفساد."},{"text":"وَلَأَوْضَعُوا خِلالَكُمْ","meaning":"أي لأسرعوا خلالكم أي بينكم، وأصله من التخلل."},{"text":"وَفِيكُمْ سَمَّاعُونَ لَهُمْ","meaning":"أي مطيعون لهم سامعون."}]}],"50":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"إِنْ تُصِبْكَ حَسَنَةٌ تَسُؤْهُمْ","meaning":"ظفر"},{"text":"وَإِنْ تُصِبْكَ مُصِيبَةٌ","meaning":"نكبة يفرحوا بها"},{"text":"يَقُولُوا قَدْ أَخَذْنَا أَمْرَنَا مِنْ قَبْلُ","meaning":"أخذنا الوَثيقَةَ فلم نخرج"}]}],"51":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِلَّا ما كَتَبَ اللَّهُ لَنا","meaning":"إلا ما قضى الله لنا وعلينا."}]}],"52":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَنْ يُصِيبَكُمُ اللَّهُ بِعَذابٍ","meaning":"أي أن يميتكم."}]}],"53":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَنْفِقُوا طَوْعًا أَوْ كَرْهًا","meaning":"مفتوح ومضموم سواء."}]}],"54":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"كُسالى","meaning":"وكسالى مضمومة ومفتوحة وهى جميع كسلان، وإن شئت كسل."}]}],"55":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَتَزْهَقَ أَنْفُسُهُمْ","meaning":"أي تخرج وتموت وتهلك"}]}],"57":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لَوَلَّوْا إِلَيْهِ","meaning":"لرجعوا عنك إليه"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَجْمَحُونَ","meaning":"يجمح أي يطمح يريد أن يسرع."}]}],"61":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَيَقُولُونَ هُوَ أُذُنٌ","meaning":"يقبل كل ما قيل له"},{"text":"قُلْ أُذُنُ خَيْرٍ لَكُمْ","meaning":"يقبل منكم ما تقولون له خيرًا لكم إن كان ذاك كما تقولون ولكنه"},{"text":"يُؤْمِنُ بِاللَّهِ وَيُؤْمِنُ لِلْمُؤْمِنِينَ","meaning":"يصدِّق الله ويصدق المؤمنين"}]}],"67":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"نَسُوا اللَّهَ فَنَسِيَهُمْ","meaning":"تركوا أمر الله فتركهم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَيَقْبِضُونَ أَيْدِيَهُمْ","meaning":"أي يمسكون أيديهم عن الصدقة والخير، يقال: قبض فلان عنا يده أي منعنا"}]}],"69":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَاسْتَمْتَعُوا بِخَلاقِهِمْ","meaning":"أي بنصيبهم ودينهم ودنياهم."}]}],"86":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أُولُوا الطَّوْلِ مِنْهُمْ","meaning":"أي ذوو الغنى والسّعة."}]}],"87":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"رَضُوا بِأَنْ يَكُونُوا مَعَ الْخَوالِفِ","meaning":"يجوز أن يكون الخوالف هاهنا النساء، ولا يكادون يجمعون الرجال على تقدير فواعل، غير أنهم قد"}]}],"88":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَأُولئِكَ لَهُمُ الْخَيْراتُ","meaning":"وهى جميع خيرة، ومعناها الفاضلة فى كل شىء"}]}],"90":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَجاءَ الْمُعَذِّرُونَ مِنَ الْأَعْرابِ","meaning":"أي من معذّر وليس بجادّ إنما يظهر غير ما فى نفسه ويعرض ما لا يفعله."}]}],"92":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"تَوَلَّوْا وَأَعْيُنُهُمْ تَفِيضُ مِنَ الدَّمْعِ","meaning":"والعرب إذا بدأت بالأسماء قبل الفعل جعلت أفعالها على العدد فهذا المستعمل"}]}],"98":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَتَّخِذُ مَا يُنْفِقُ مَغْرَمًا","meaning":"غُرْمًا وخُسْرَانًا"}]}],"101":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مَرَدُوا عَلَى النِّفاقِ","meaning":"أي عتوا ومرّنوا عليه"}]}],"106":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَآخَرُونَ مُرْجَوْنَ لِأَمْرِ اللَّهِ","meaning":"أي مؤخرون، يقال: أرجأتك، أي أخرتك"}]}],"110":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِلَّا أَنْ تَقَطَّعَ قُلُوبُهُمْ","meaning":"إلا هاهنا غاية."}]}],"117":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"رَؤُفٌ","meaning":"فعول من الرأفة"}]}],"122":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَلَوْلا نَفَرَ مِنْ كُلِّ فِرْقَةٍ مِنْهُمْ","meaning":"مجازه: فهلّا، وقد فرغنا منها فى غير موضع."}]}]}
