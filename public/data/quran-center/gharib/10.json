{"2":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"قَدَمَ صِدْقٍ عِنْدَ رَبِّهِمْ","meaning":"مجازه: سابقة صدق عند ربهم"}]}],"3":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يُدَبِّرُ الأَمْرَ","meaning":"يَقْضي القضاء"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ثُمَّ اسْتَوى عَلَى الْعَرْشِ","meaning":"مجازه: ظهر على العرش وعلا عليه"}]}],"4":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِلَيْهِ مَرْجِعُكُمْ جَمِيعًا وَعْدَ اللَّهِ حَقًّا","meaning":"وعد الله: منصوب لأنه مصدر فى موضع"},{"text":"لَهُمْ شَرابٌ مِنْ حَمِيمٍ","meaning":"كل حار فهو حميم"},{"text":"وَعَمِلُوا الصَّالِحاتِ بِالْقِسْطِ","meaning":"أي بالعدل."}]}],"5":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"جَعَلَ الشَّمْسَ ضِياءً","meaning":"وصفها بالمصدر، والعرب قد تصف المؤنثة بالمصدر وتسقط الهاء"}]}],"11":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لَقُضِيَ إِلَيْهِمْ أَجَلُهُمْ","meaning":"مجازه: لفرغ ولقطع ونبذ إليهم، وقال أبو ذؤيب"}]}],"12":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مَرَّ كَأَنْ لَمْ يَدْعُنا","meaning":"أي استمر فمضى."}]}],"16":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"عُمُرًا","meaning":"أي حينا طويلا، مجازه من قولهم: مضى علينا حين من الدهر، والعمر والعمر والعمر ثلاث لغات."}]}],"21":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَإِذَا أَذَقْنَا النَّاسَ رَحْمَةً","meaning":"نعمةً"}]}],"22":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَنَّهُمْ أُحِيطَ بِهِمْ","meaning":"مجازه: دنوا للهلاك، وي"}]}],"24":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَجَعَلْناها حَصِيدًا","meaning":"اى مستاصلين، والحصيد من الزرع والنبات المجذوذ من أصله وهو يقع أيضًا لفظه على لفظ الجميع من الزرع"}]}],"40":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"وَمِنْهُمْ مَنْ لَا يُؤْمِنُ بِهِ","meaning":"منهم من يشك ولا يُصَدِّقُ"}]}],"54":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَأَسَرُّوا النَّدَامَةَ","meaning":"أي أظهروها، ي"}]}],"61":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَمَا يَعْزُبُ عَنْ رَبِّكَ","meaning":"ما يبعد ولا يغيب"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِذْ تُفِيضُونَ فِيهِ","meaning":"أي تكثرون وتلغطون وتخلطون."},{"text":"مِثْقالِ ذَرَّةٍ","meaning":"أي زنة نملة صغيرة"}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"إِذْ تُفِيضُونَ فِيهِ","meaning":"إذ تَنْتَشِرُونَ فيه"}]}],"71":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ثُمَّ لا يَكُنْ أَمْرُكُمْ عَلَيْكُمْ غُمَّةً","meaning":"مجازها: ظلمة وضيق"}]}],"75":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِلى فِرْعَوْنَ وَمَلَائِهِ","meaning":"أي أشراف قومه."}]}],"78":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَجِئْتَنا لِتَلْفِتَنا عَمَّا وَجَدْنا عَلَيْهِ آباءَنا","meaning":"أي لتصرفنا عنه وتميلنا وتلوينا عنه"}]}],"87":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"بيوتكم قبلة","meaning":"صلوا في بيوتكم لتأمنوا من الخوف لأنهم آمنوا على خوف من فرعون"}]}],"88":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"اطْمِسْ عَلى أَمْوالِهِمْ","meaning":"أي أذهب أموالهم"},{"text":"وَاشْدُدْ عَلى قُلُوبِهِمْ","meaning":"مجازه هاهنا كمجاز"},{"text":"فَلا يُؤْمِنُوا","meaning":"جزم، لأنه دعاء عليهم، أي فلا يؤمننّ."}]}],"90":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَأَتْبَعَهُمْ فِرْعَوْنُ","meaning":"لحقهم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَأَتْبَعَهُمْ فِرْعَوْنُ","meaning":"مجازه: تبعهم، هما سواء."}]}],"92":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَالْيَوْمَ نُنَجِّيكَ بِبَدَنِكَ","meaning":"مجازه: نلقيك"},{"text":"لِتَكُونَ لِمَنْ خَلْفَكَ آيَةً","meaning":"أي علامة، ومجاز خلفك: بعدك."}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"نُنْجِى","meaning":"إذا أهلكت قرية أنجى الله الأنبياء"}]}],"98":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِلَّا قَوْمَ يُونُسَ","meaning":"مجاز"}]}],"108":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَإِنَّما يَضِلُّ عَلَيْها","meaning":"مجازه: يضل لها أي لنفسه، وهداه لنفسه."}]}]}
