{"2":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَأَصْلَحَ بَالَهُمْ","meaning":"حالَهم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَأَصْلَحَ بالَهُمْ","meaning":"حالهم.."}]}],"4":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"حَتَّى تَضَعَ الْحَرْبُ أَوْزَارَهَا","meaning":"يضعَ أهل الحرب السلاحَ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَإِمَّا مَنًّا بَعْدُ وَإِمَّا فِداءً","meaning":"نصبهما لأنهما فى موضع فعلهما مجازها فإما أن تمنّوا وإما أن تفادوا مثل سقيا ورعيا إنما هو سقيت"}]}],"6":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"عَرَّفَها لَهُمْ","meaning":"بيّنها لهم وعرفهم منازلهم"}]}],"10":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"دَمَّرَ اللَّهُ عَلَيْهِمْ","meaning":"أهلكهم اللَّه"}]}],"11":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مَوْلَى الَّذِينَ آمَنُوا","meaning":"وليُّهم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بِأَنَّ اللَّهَ مَوْلَى الَّذِينَ آمَنُوا","meaning":"ولىّ الذين آمنوا.."}]}],"12":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَالنَّارُ مَثْوًى لَهُمْ","meaning":"منزلٌ لهم"}]}],"16":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَمِنْهُمْ مَنْ يَسْتَمِعُ إِلَيْكَ حَتَّى إِذا خَرَجُوا مِنْ عِنْدِكَ","meaning":"من هاهنا فى موضع جميع.."}]}],"18":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَهَلْ يَنْظُرُونَ إِلا السَّاعَةَ أَنْ تَأْتِيَهُمْ بَغْتَةً","meaning":"هل ينظرون؟"}]}],"25":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"سَوَّلَ لَهُمْ","meaning":"زيّن لهم.."}]}],"30":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فِي لَحْنِ الْقَوْلِ","meaning":"فى فحوى القول، يقال: فلان ألحن بحجته من فلان"}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"وَلَتَعْرِفَنَّهُمْ فِي لَحْنِ الْقَوْلِ","meaning":"في فحوى القَوْلِ"}]}],"31":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"حَتَّى نَعْلَمَ الْمُجاهِدِينَ مِنْكُمْ وَالصَّابِرِينَ","meaning":"حتى نميّز."}]}],"35":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَلا تَهِنُوا","meaning":"لا تضعُفوا"},{"text":"وَتَدْعُوا إِلَى السَّلْمِ","meaning":"الصلح"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَلا تَهِنُوا","meaning":"وهن يهن."},{"text":"وَلَنْ يَتِرَكُمْ أَعْمالَكُمْ","meaning":"لن ينقصكم لن يظلمكم وترتنى حقى ظلمتنى.."}]}]}
