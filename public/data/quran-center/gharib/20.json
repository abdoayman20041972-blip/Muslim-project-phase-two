{"12":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بِالْوادِ الْمُقَدَّسِ طُوىً","meaning":"يكسر أوله قوم وبضمه قوم كمجاز قوله: ألا يا سلمى يا هند هند بنى بدر"}]}],"15":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"أَكَادُ أُخْفِيهَا","meaning":"أسترها من نفسي"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَكادُ أُخْفِيها","meaning":"له موضعان موضع كتمان وموضع إظهار كسائر حروف الأضداد"}]}],"16":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَتَرْدَى","meaning":"تَهلِك"}]}],"18":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَأَهُشُّ بِها عَلى غَنَمِي","meaning":"أي أختبط بها فأضرب بها الأغصان ليسقط ورقها على غنمى فتأكله"},{"text":"مَآرِبُ أُخْرى","meaning":"واحدتها مأربة ومأربة، الراء مفتوحة ويضمها قوم، ومعناها حوائج وهى من قولهم: لا أرب لى فيها"}]}],"21":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"سَنُعِيدُها سِيرَتَهَا الْأُولى","meaning":"أي خلقتها التي كانت عليها قبل ذلك وقد يجعلون أيضا بينها وبين الذي قبلها"}]}],"22":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَاضْمُمْ يَدَكَ إِلَى جَنَاحِكَ","meaning":"إلى جَيْبِك"},{"text":"مِنْ غَيْرِ سُوءٍ","meaning":"من غير بَرَص"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَاضْمُمْ يَدَكَ إِلى جَناحِكَ","meaning":"مجازه: إلى ناحية جنبك، والجناحان هما الناحيتان"},{"text":"تَخْرُجْ بَيْضاءَ مِنْ غَيْرِ سُوءٍ","meaning":"أي تخرج نقيّة شديدة البياض من غير برص، والسوء كل داء معضل من جذام أو برص"}]}],"23":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لِنُرِيَكَ مِنْ آياتِنَا الْكُبْرى","meaning":"مجازها مقدّم ومؤخر، أي لنريك الكبرى من آياتنا، أي من عجائبنا"}]}],"27":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَاحْلُلْ عُقْدَةً مِنْ لِسَانِي","meaning":"رُتَّةً كانت في لسانه"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَاحْلُلْ عُقْدَةً مِنْ لِسانِي","meaning":"مجاز العقدة"}]}],"39":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلِتُصْنَعَ عَلَى عَيْنِي","meaning":"لترَبَّى بِمَرْأًى مني، على مَحَبَّتِي فيك"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَاقْذِفِيهِ فِي الْيَمِّ","meaning":"أي ارمى به فى البحر، واليمّ معظّم البحر"},{"text":"وَلِتُصْنَعَ عَلى عَيْنِي","meaning":"مجازه ولتغذى"},{"text":"وَأَلْقَيْتُ عَلَيْكَ مَحَبَّةً مِنِّي","meaning":"مجازه: جعلت لك محبة منى فى صدور الناس، ويقول الرجل إذا أحب أخاه: ألقيت عليك رحمتى، ى محبتى"}]}],"40":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"عَلَى مَنْ يَكْفُلُهُ","meaning":"يَضُمه"},{"text":"وَفَتَنَّاكَ فُتُونًا","meaning":"اختبرناك"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَفَتَنَّاكَ فُتُونًا","meaning":"مجازه: وابتليناك."}]}],"42":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلا تَنِيَا","meaning":"لا تَضْعُفَا ولا تَفْتُرا"}]}],"45":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَنْ يَفْرُطَ عَلَيْنا","meaning":"مجازه أن يقدم علينا ببسط وعقوبة ويعجل علينا، وكل متقدّم أو متعجّل فارط"}]}],"46":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِنَّنِي مَعَكُما","meaning":"مجازه أعينكما.."}]}],"50":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"رَبُّنَا الَّذِي أَعْطَى كُلَّ شَيْءٍ خَلْقَهُ","meaning":"أعطى كل ذكر خَلْقا مثله من الإناث"},{"text":"ثُمَّ هَدَى","meaning":"هدى الذكر لإتيان الأنثى"}]}],"51":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَمَا بَالُ الْقُرُونِ الأُولَى","meaning":"فما حالها"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَما بالُ الْقُرُونِ الْأُولى","meaning":"أي ما خبر الأمم الأولى وما حديثهم.."}]}],"54":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لأُولِي النُّهَى","meaning":"أولي العقول"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لِأُولِي النُّهى","meaning":"مجازه لذوى الحجى واحدتها نهية، أي أحلام وعقول وانتهى إلى عقول أمرهم ورأيهم ومجاز قولهم لذى حجى"}]}],"58":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مَكَانًا سُوًى","meaning":"وسطًا بين قريتين"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مَكانًا سُوىً","meaning":"يضم أوله ويكسر وهو منقوص يجرى مجرى عدى وعدى، والمعنى النّصف، والوسط فيما بين القريتين"}]}],"59":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مَوْعِدُكُمْ يَوْمُ الزِّينَةِ","meaning":"مجازه يوم العيد.."},{"text":"وَأَنْ يُحْشَرَ النَّاسُ ضُحًى","meaning":"أي يساق الناس فيجتمعون من كل فجّ.."}]}],"60":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَجَمَعَ كَيْدَهُ","meaning":"حِيَله"}]}],"61":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَيُسْحِتَكُمْ بِعَذَابٍ","meaning":"يُهلككم ويَسْتَأْصِلكم"},{"text":"وَقَدْ خَابَ مَنِ افْتَرَى","meaning":"كذب"}]}],"62":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَأَسَرُّوا النَّجْوَى","meaning":"تَرَاجَعُوا الكلام"}]}],"63":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بِطَرِيقَتِكُمُ","meaning":"مجازه بسنتكم ودينكم وما أنتم عليه"}]}],"64":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"ثُمَّ ائْتُوا صَفًّا","meaning":"جميعًا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ثُمَّ ائْتُوا صَفًّا","meaning":"أي صفوفا وله موضع آخر من قولهم: هل أتيت الصفّ اليوم يعنى المصلّى الذي يصلى فيه"}]}],"69":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلا يُفْلِحُ السَّاحِرُ حَيْثُ أَتَى","meaning":"حيث كان"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلا يُفْلِحُ السَّاحِرُ حَيْثُ أَتى","meaning":"أي حيث كان.."}]}],"71":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لَكَبِيرُكُمُ","meaning":"أي معلمكم"}]}],"72":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَاقْضِ ما أَنْتَ قاضٍ","meaning":"مجازه: اصنع ما أنت صانع وأنفذ ما أنت منفذ فقد قضى قضاؤك، وقال أبو ذؤيب"}]}],"77":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَنْ أَسْرِ بِعِبادِي","meaning":"وقوم يجعلونه بغير ألف فيقولون: سريت وهو سرى الليل أي سير الليل.."},{"text":"طَرِيقًا فِي الْبَحْرِ يَبَسًا","meaning":"متحرك الحروف بالفتحة والمعنى يابسا"}]}],"81":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَقَدْ هَوَى","meaning":"هلك"}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"فَقَد هَوَى","meaning":"هَلكَ وصار إلى الهاوِيةِ"}]}],"87":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلَكِنَّا حُمِّلْنَا أَوْزَارًا مِنْ زِينَةِ الْقَوْمِ","meaning":"أحمالا من حُليّهم"}]}],"91":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لَنْ نَبْرَحَ عَلَيْهِ عاكِفِينَ","meaning":"مجازه لن نزال"}]}],"95":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَما خَطْبُكَ","meaning":"أي ما بالك وشأنك"}]}],"96":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَنَبَذْتُهَا","meaning":"قذفتُها في العِجْل"},{"text":"وَكَذَلِكَ سَوَّلَتْ لِي نَفْسِي","meaning":"زَيَّنَتْ لي"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَقَبَضْتُ قَبْضَةً","meaning":"أي أخذت ملء جمع كفّى وقبضت قبضة أي. تناولت بأطراف أصابعى."},{"text":"سَوَّلَتْ لِي نَفْسِي","meaning":"أي زينت له وأغوته، يقال: إنك لتسول لفلان سوء عمله، أي تزين له"}]}],"97":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"أَنْ تَقُولَ لا مِسَاسَ","meaning":"لا تخالط أحدا"},{"text":"وَإِنَّ لَكَ مَوْعِدًا","meaning":"يوم القيامة"},{"text":"ظَلْتَ عَلَيْهِ عَاكِفًا","meaning":"مُقيمًا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لا مِساسَ","meaning":"إذا كسرت الميم دخلها النصب والجرّ والرفع بالتنوين فى مواضعهن وهى هاهنا منفية فلذلك نصبتها بغير تنوين"},{"text":"الَّذِي ظَلْتَ عَلَيْهِ عاكِفًا","meaning":"يفتح أوله قوم إذا ألقوا منه إحدى اللامين ويجزمون اللام الباقية لأنهم يدعونها على حالها فى التضعيف قبل"}]}],"98":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَسِعَ كُلَّ شَيْءٍ عِلْمًا","meaning":"وسع علمه كل شيء"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَسِعَ كُلَّ شَيْءٍ عِلْمًا","meaning":"مجازه: أحاط به علما وعلمه"}]}],"100":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَحْمِلُ يَوْمَ الْقِيَامَةِ وِزْرًا","meaning":"إثمًا"}]}],"101":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"خالِدِينَ فِيهِ وَساءَ لَهُمْ","meaning":"ذلك الوزر"}]}],"102":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَنَحْشُرُ الْمُجْرِمِينَ يَوْمَئِذٍ زُرْقًا","meaning":"بِيض العيون من العمى: قد ذهب السَّوَادُ والنَّاظِرُ"}]}],"103":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَتَخافَتُونَ بَيْنَهُمْ","meaning":"يتسارّون"}]}],"104":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"إِذْ يَقُولُ أَمْثَلُهُمْ طَرِيقَةً","meaning":"رأيًا"}]}],"106":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَيَذَرُها قاعًا صَفْصَفًا","meaning":"أي مستويا أملس.."}]}],"108":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَتَّبِعُونَ الدَّاعِيَ لا عِوَجَ","meaning":"لا يَعْدِلُون عنه ولا يُعَرِّجون في اتباعهم"},{"text":"وَخَشَعَتِ الأَصْوَاتُ","meaning":"خَفِيتْ"},{"text":"فَلا تَسْمَعُ إِلا هَمْسًا","meaning":"إلا صوتًا خفيًّا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَلا تَسْمَعُ إِلَّا هَمْسًا","meaning":"أي صوتا خفيا"}]}],"111":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَعَنَتِ الْوُجُوهُ","meaning":"ذَلَّتْ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَعَنَتِ الْوُجُوهُ لِلْحَيِّ الْقَيُّومِ","meaning":"فهى تعنو عنوّا أي استأسرت فهى عوان لربّها، واحدها عان بمنزلة الأسير العاني لأسره، أي ذليل"}]}],"112":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلا هَضْمًا","meaning":"نَقِصَةً"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلا هَضْمًا","meaning":"أي ولا نقيصة"}]}],"113":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَصَرَّفْنا فِيهِ مِنَ الْوَعِيدِ","meaning":"مجازه بيّنا.."}]}],"114":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلا تَعْجَلْ بِالْقُرْآنِ