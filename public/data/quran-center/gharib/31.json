{"10":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَأَلْقى فِي الْأَرْضِ رَواسِيَ","meaning":"مجازه: وجعل فيها رواسى أي جبالا قد رست أي ثبتت.."},{"text":"أَنْ تَمِيدَ بِكُمْ","meaning":"أي أن تحرّك بكم يمينا وشمالا.."},{"text":"وَبَثَّ فِيها مِنْ كُلِّ دابَّةٍ","meaning":"أي فرّق فى الأرض من الدواب وكل ما أكل وشرب فهو دابة.."}]}],"11":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ماذا خَلَقَ الَّذِينَ مِنْ دُونِهِ","meaning":"أي الذين جعلتم معه ﵎ عن ذلك.."}]}],"14":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَهْنًا عَلَى وَهْنٍ","meaning":"ضَعفًا على ضعفٍ"}]}],"15":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَاتَّبِعْ سَبِيلَ مَنْ أَنابَ إِلَيَّ","meaning":"أي طريق من رجع وتاب إلى الله وهذا مما وصّى الله به ثم رجع الخبر إلى لقمان فقال."}]}],"16":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَأْتِ بِهَا اللَّهُ","meaning":"يُظهرْها اللهُ ولا تَخْفَ عليه"}]}],"18":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلا تُصَعِّرْ خَدَّكَ لِلنَّاسِ","meaning":"لا تُعْرِضْ بوجهك وتتكبرْ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلا تُصَعِّرْ خَدَّكَ لِلنَّاسِ","meaning":"مجازه: ولا تقلب وجهك ولا تعرض بوجهك فى ناحية من الكبر ومنه الصعر الذي يأخذ الإبل فى رؤوسها"},{"text":"وَلا تَمْشِ فِي الْأَرْضِ مَرَحًا","meaning":"أي لا تمرح فى مشيك من الكبر."}]}],"32":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"كُلُّ خَتَّارٍ كَفُورٍ","meaning":"الختر أقبح الغدر"}]}],"33":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لا يَجْزِي وَالِدٌ عَنْ وَلَدِهِ","meaning":"لا يُغني عنهُ ولا ينفعُه"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لا يَجْزِي والِدٌ عَنْ وَلَدِهِ","meaning":"قوم يقولون: جزيت عنك كأنه من الجزاء وهو من أغنيت وقوم يقولون لا يجزئ عنك"},{"text":"وَلا يَغُرَّنَّكُمْ بِاللَّهِ الْغَرُورُ","meaning":"مجازه أن كل من غرّك من أمر الله أو من غير ذلك فهو غرور شيطانا كان أو غيره"}]}]}
