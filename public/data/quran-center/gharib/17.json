{"4":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَقَضَيْنا","meaning":"مجازه: أخبرنا."}]}],"5":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَجاسُوا","meaning":"قتلوا."}]}],"6":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"ثُمَّ رَدَدْنَا لَكُمُ الْكَرَّةَ","meaning":"الدَّوْلَة"},{"text":"أَكْثَرَ نَفِيرًا","meaning":"أكثر عددًا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"رَدَدْنا لَكُمُ الْكَرَّةَ","meaning":"أعقبنا لكم الدولة."},{"text":"أَكْثَرَ نَفِيرًا","meaning":"مجازه: من الذين نفروا معه."}]}],"7":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلِيُتَبِّرُوا","meaning":"ليدمِّروا ويخرِّبوا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلِيُتَبِّرُوا","meaning":"وليدمروا"}]}],"8":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"جَهَنَّمَ لِلْكافِرِينَ حَصِيرًا","meaning":"من الحصر"}]}],"11":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَكَانَ الإِنْسَانُ عَجُولا","meaning":"يَعْجَلُ عند الغضب"}]}],"12":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَجَعَلْنَا آيَةَ النَّهَارِ مُبْصِرَةً","meaning":"مُبْصَرًا بها"}]}],"14":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"كَفَى بِنَفْسِكَ الْيَوْمَ عَلَيْكَ حَسِيبًا","meaning":"كافيًا"}]}],"15":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلا تَزِرُ وازِرَةٌ وِزْرَ أُخْرى","meaning":"أي ولا تأثم آثمة إثم أخرى أثمته ولم تأثمه الأولى منهما، ومجاز وزرت تزر: مجاز أثمت"}]}],"16":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَإِذَا أَرَدْنَا أَنْ نُهْلِكَ قَرْيَةً أَمَرْنَا مُتْرَفِيهَا","meaning":"أكْثَرْنَا مُتْرَفِيهَا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَحَقَّ عَلَيْهَا الْقَوْلُ","meaning":"أي فوجب عليها العذاب."}]}],"21":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"على بعض","meaning":"فَلَا يُنكِرُوا تفضَيلَ محمد - ﷺ - وإعطاءَه القرآنَ"}]}],"23":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَقَضى رَبُّكَ أَلَّا تَعْبُدُوا إِلَّا إِيَّاهُ","meaning":"مجازه: وأمر ربّك."}]}],"28":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"قَوْلا مَيْسُورًا","meaning":"لَيِّنا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"قَوْلًا مَيْسُورًا","meaning":"أي ليّنا"}]}],"29":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مَحْسُورًا","meaning":"تَحْسِرُكَ العطيةُ وتقطعك، كما يَحْسِرُ السفر البعير فيبقى منقطعًا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلا تَجْعَلْ يَدَكَ مَغْلُولَةً إِلى عُنُقِكَ","meaning":"مجازه فى موضع قولهم: لا تمسك عما ينبغى لك أن تبذل من الحق وهو مثل وتشبيه."},{"text":"وَلا تَبْسُطْها كُلَّ الْبَسْطِ","meaning":"أي لا تسرف كل السرف، وتبذّر كل التبذير."}]}],"32":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلا تَقْرَبُوا الزِّنى","meaning":"مقصور وقد يمدّ فى كلام أهل نجد"}]}],"34":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مالَ الْيَتِيمِ إِلَّا بِالَّتِي هِيَ أَحْسَنُ","meaning":"مجازه: بالقوت إذا قام به وعمره من غير أن يتأثل منه مالا."},{"text":"حَتَّى يَبْلُغَ أَشُدَّهُ","meaning":"مجازه: منتهاه من بلوغه، ولا واحد له منه فإن أكرهوا على ذلك"}]}],"37":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِنَّكَ لَنْ تَخْرِقَ الْأَرْضَ","meaning":"مجازه: لن تقطع"}]}],"41":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلَقَدْ صَرَّفْنَا","meaning":"وجهنا القول فيه بكل مثل"}]}],"46":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلَّوْا عَلى أَدْبارِهِمْ نُفُورًا","meaning":"أي أعقابهم، نفور: جمع نافر بمنزلة قاعد وقعود وجالس وجلوس."}]}],"47":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"إِلا رَجُلا مَسْحُورًا","meaning":"مَخْدُوعًا؛ لأن السحر حيلة وخديعة"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَإِذْ هُمْ نَجْوى","meaning":"وهى مصدر من ناجيت أو اسم منها فوصف القوم بها والعرب تفعل ذلك"},{"text":"إِنْ تَتَّبِعُونَ إِلَّا رَجُلًا مَسْحُورًا","meaning":"أي ما تتبعون كقولك ما تتبعون إلّا رجلا مسحورا، أي له سحر"}]}],"49":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَإِذا كُنَّا عِظامًا وَرُفاتًا","meaning":"عظاما لم تحطم، ورفاتا أي حطاما."}]}],"51":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَسَيُنْغِضُونَ إِلَيْكَ رُءُوسَهُمْ","meaning":"يحركونها كما يحرك اليائسُ من الشيء المستبعدُ له رأسَه"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَكْبُرُ فِي صُدُورِكُمْ","meaning":"أي يعظم."},{"text":"فَطَرَكُمْ أَوَّلَ مَرَّةٍ","meaning":"أي خلقكم."},{"text":"فَسَيُنْغِضُونَ إِلَيْكَ رُؤُسَهُمْ","meaning":"مجازه: فسيرفعون ويحركون استهزاء منهم"}]}],"57":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَبْتَغُونَ إِلَى رَبِّهِمُ الْوَسِيلَةَ","meaning":"القُرْبة"}]}],"58":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مَسْطُورًا","meaning":"مكتوبا"}]}],"59":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَآتَيْنَا ثَمُودَ النَّاقَةَ مُبْصِرَةً","meaning":"آتينا ثمود آية – وهي الناقة – مبصرة، أي بيِّنة، يريد مُبْصَرًا بها"},{"text":"وَمَا نُرْسِلُ بِالآيَاتِ","meaning":"وما نرسل الرسلَ بالآيات"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَظَلَمُوا بِها","meaning":"مجازه: فكفروا بها."}]}],"60":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"بالناس","meaning":"حال بينهم وبين أنْ يقتلوك أو يَغْلِبُوكَ كما"}]}],"61":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَسَجَدُوا إِلَّا إِبْلِيسَ","meaning":"نصب إبليس على استثناء قليل من كثير، ولم يصرف إبليس لأنه أعجمى."}]}],"62":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"هَذَا الَّذِي كَرَّمْتَ عَلَيَّ","meaning":"فضَّلت"}]}],"64":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَاسْتَفْزِزْ","meaning":"اسْتَخِفَّ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَاسْتَفْزِزْ مَنِ اسْتَطَعْتَ","meaning":"أي استخفف واستجهل."},{"text":"بِخَيْلِكَ وَرَجِلِكَ","meaning":"جميع راجل، بمنزلة تاجر والجميع تجر وصاحب والجميع صحب."}]}],"66":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يُزْجِي لَكُمُ الْفُلْكَ","meaning":"يسيرها"}]}],"68":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَوْ يُرْسِلَ عَلَيْكُمْ حاصِبًا","meaning":"ريحا"}]}],"69":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"تارَةً أُخْرى","meaning":"مرّة أخرى والجميع تارات وتير."},{"text":"فَيُرْسِلَ عَلَيْكُمْ قاصِفًا مِنَ الرِّيحِ","meaning":"أي تقصف كل شىء أي تحطم، يقال: بعث الله عليهم ريحا عاصفا قاصفا لم تبق لهم ثاغية ولا راغية"}]}],"70":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلَقَدْ كَرَّمْنا بَنِي آدَمَ","meaning":"أي أكرمنا إلا أنها أشدّ مبالغة فى الكرامة."}]}],"71":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَوْمَ نَدْعُوا كُلَّ أُنَاسٍ بِإِمَمِهِمْ","meaning":"بكتابهم الذي فيه أعمالهم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلا يُظْلَمُونَ فَتِيلًا","meaning":"وهو المفتّل الذي فى شق بطن النواة."}]}],"72":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَهُوَ فِي الْآخِرَةِ أَعْمى","meaning":"أشدّ عمى."}]}],"73":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَإِنْ كَادُوا لَيَفْتِنُونَكَ","meaning":"يَسْتَزِلُّونَك"},{"text":"وَإِذًا لاتَّخَذُوكَ خَلِيلا","meaning":"لو فعلت ذاك لَوَدُّوك"}]}],"75":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَضِعْفَ الْمَمَاتِ","meaning":"ضِعف عذاب الممات"}]}],"78":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَقُرْآنَ الْفَجْرِ","meaning":"قراءة الفجر"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَقُرْآنَ الْفَجْرِ","meaning":"أي ما يقرأ به فى صلاة الفجر."},{"text":"إِنَّ قُرْآنَ الْفَجْرِ كانَ مَشْهُودًا","meaning":"مجازه: إن ملائكة الليل تشهده وإذا صلّيت الغداة أعقبتها ملائكة النهار"}]}],"79":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَتَهَجَّدْ بِهِ","meaning":"اسْهَرْ به"},{"text":"نَافِلَةً لَكَ","meaning":"تطوعا"}]}],"80":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَدْخِلْنِي مُدْخَلَ صِدْقٍ","meaning":"[من أدخلت] ومن جعله من دخلت"}]}],"84":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"كُلٌّ يَعْمَلُ عَلَى شَاكِلَتِهِ","meaning":"على خَلِيقَتِه وطبيعته"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَعْمَلُ عَلى شاكِلَتِهِ","meaning":"أي على ناحيته وخليقته ومنها قولهم: هذا من شكل هذا"}]}],"88":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلَوْ كَانَ بَعْضُهُمْ لِبَعْضٍ ظَهِيرًا","meaning":"عَوْنًا"},{"text":"ظَهِيرًا","meaning":"عونًا"}]}],"89":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلَقَدْ صَرَّفْنا لِلنَّاسِ فِي هذَا الْقُرْآنِ","meaning":"أي وجّهنا وبيّنا."}]}],"90":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَنْبُوعًا","meaning":"عينا وهو مَفْعُولٌ من نَبَعَ يَنْبَعُ"}]}],"92":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"أَوْ تَأْتِيَ بِاللَّهِ وَالْمَلائِكَةِ قَبِيلا","meaning":"ضُمَنَاء"},{"text":"كِسَفًا","meaning":"قِطَعًا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"عَلَيْنا كِسَفًا","meaning":"من القطع فيجوز أن يكون واحدا أي قطعة، ويجوز أن يكون جميع كسفة فيخرج مخرج سدرة والجميع سدر"}]}],"93":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"بَيْتٌ مِنْ زُخْرُفٍ","meaning":"من ذَهَب"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بَيْتٌ مِنْ زُخْرُفٍ","meaning":"وهو مصدر المزخرف وهو المزيّن."}]}],"97":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"كُلَّمَا خَبَتْ","meaning":"سكنت ي"}]}],"100":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَكَانَ الإِنْسَانُ قَتُورًا","meaning":"ضَيِّقًا بخيلا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"قُلْ لَوْ أَنْتُمْ تَمْلِكُونَ","meaning":"معناه: لو تملكون أنتم."}]}],"102":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يا فِرْعَوْنُ مَثْبُورًا","meaning":"أي مهلكا"}]}],"103":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَأَرَادَ أَنْ يَسْتَفِزَّهُمْ مِنَ الأَرْضِ","meaning":"يَسْتَخِفَّهُمْ حتى يخرجوا"}]}],"104":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"جِئْنَا بِكُمْ لَفِيفًا","meaning":"جميعًا"}]}],"109":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَيَخِرُّونَ لِلْأَذْقانِ","meaning":"واحدها ذقن وهو مجمع اللّحيين."}]}],"110":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلا تُخَافِتْ بِهَا","meaning":"لا تخفها"},{"text":"وَابْتَغِ بَيْنَ ذَلِكَ سَبِيلا","meaning":"بين الجهر وبين الإخفاء طريقا قَصْدًا وَسَطًا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلا تُخافِتْ بِها","meaning":"مجازه: لا تخفت بها، ولا تفوّه بها، ولكن أسمعها نفسك ولا تجهر بها فترفع صوتك"}]}]}
