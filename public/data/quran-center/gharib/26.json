{"2":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"تِلْكَ آياتُ الْكِتابِ","meaning":"الْحَكِيمِ"}]}],"3":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لَعَلَّكَ باخِعٌ نَفْسَكَ","meaning":"أمي مهلك وقاتل"}]}],"4":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَظَلَّتْ أَعْناقُهُمْ لَها خاضِعِينَ","meaning":"» (٢٦/ ٤) حوّل الخبر إلى الكناية التي فى آخر الأعناق"}]}],"7":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مِنْ كُلِّ زَوْجٍ كَرِيمٍ","meaning":"من كل جنس حَسَن"}]}],"14":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلَهُمْ عَلَيَّ ذَنْبٌ","meaning":"عندي ذنبٌ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلَهُمْ عَلَيَّ ذَنْبٌ","meaning":"مجازه ولهم عندى ذنب"}]}],"36":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَرْجِهْ وَأَخاهُ","meaning":"أي أخره.."}]}],"41":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَإِنَّ لَنا لَأَجْرًا","meaning":"أي ثوابا وجزاء.."}]}],"45":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"تَلْقَفُ ما يَأْفِكُونَ","meaning":"أي ما يفترون ويسحرون.."}]}],"50":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"قالُوا لا ضَيْرَ","meaning":"مصدر ضار يضير"}]}],"60":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَأَتْبَعُوهُمْ مُشْرِقِينَ","meaning":"مجاز المشرق مجاز المصبح.."}]}],"63":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"كَالطَّوْدِ الْعَظِيمِ","meaning":"أي كالجبل"}]}],"64":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَأَزْلَفْنا ثَمَّ الْآخَرِينَ","meaning":"أي وجمعنا، ومنه ليلة المزدلفة"}]}],"72":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"هَلْ يَسْمَعُونَكُمْ إِذْ تَدْعُونَ","meaning":"أي يسمعون دعاءكم وفى آية أخرى"}]}],"84":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فِي الآخِرِينَ","meaning":"في الباقين من الأمم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَاجْعَلْ