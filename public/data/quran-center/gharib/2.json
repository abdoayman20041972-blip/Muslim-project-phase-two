{"2":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ذلِكَ الْكِتابُ","meaning":"معناه: هذا القرآن وقد تخاطب العرب الشاهد فتظهر له مخاطبة الغائب"},{"text":"هُدىً لِلْمُتَّقِينَ","meaning":"أي بيانا للمتقين."}]}],"10":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فِي قُلُوبِهِمْ مَرَضٌ","meaning":"أي شكّ ونفاق."}]}],"15":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"اللَّهُ يَسْتَهْزِئُ بِهِمْ","meaning":"يجازيهم جزاء الاستهزاء"}]}],"19":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"كَصَيِّبٍ مِنَ السَّماءِ","meaning":"معناه: كمطر، وتقديره تقدير سيّد من صاب يصوب، معناه: ينزل المطر"}]}],"22":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الَّذِي جَعَلَ لَكُمُ الْأَرْضَ فِراشًا","meaning":"أي مهادا ذللها لكم فصارت مهادا."}]}],"23":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"هَدًّا","meaning":"سقوطا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَأْتُوا بِسُورَةٍ مِنْ مِثْلِهِ","meaning":"أي من مثل القرآن، وإنما سمّيت سورة لأنها مقطوعة من الأخرى. وسمّى القرآن قرآنا لجماعة السور."}]}],"24":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَاتَّقُوا النَّارَ الَّتِي وَقُودُهَا النَّاسُ","meaning":"حطَبُها"}]}],"29":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"ثُمَّ اسْتَوَى إِلَى السَّمَاءِ","meaning":"عمَد لها"}]}],"30":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"نُسَبِّحُ","meaning":"نصلىّ، تقول: قد فرغت من سبحتى، أي من صلاتى."},{"text":"نُقَدِّسُ لَكَ","meaning":"نطهر، التقديس: التطهير"}]}],"31":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"ثُمَّ عَرَضَهُمْ عَلَى الْمَلائِكَةِ","meaning":"عرض أعيان الخلق عليهم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَعَلَّمَ آدَمَ الْأَسْماءَ كُلَّها","meaning":"اسماء الخلق"}]}],"32":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"حَكِيمٌ","meaning":"ذو حكمة فيما أمركم به من أمر اليتامى وغيره"}]}],"35":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَكُلا مِنْهَا رَغَدًا","meaning":"رزقًا واسعًا كثيرًا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَقُلْنا يا آدَمُ","meaning":"هذا شىء تكلمت به العرب، تتكلم بالواحد على لفظ الجميع."}]}],"36":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَأَزَلَّهُمَا الشَّيْطانُ","meaning":"أي استزلهما."},{"text":"وَمَتاعٌ إِلى حِينٍ","meaning":"إلى غاية ووقت."}]}],"40":[{"book":"التبيان في تفسير غريب القرآن","author":"ابن الهائم (ت ٨١٥هـ)","words":[{"text":"إِسْرائِيلَ","meaning":"يعقوب عليه السلام  ممنوع الصّرف للعلميّة والعجمة، وقد ذكروا أنه مركب من إسرا وهو العبد وإيل اسم من  أسماء الله تعالى فكأنّه عبد الله، وذلك باللسان العبراني فيكون مثل جبرئيل وميكائيل وإسرافيل وعزرائيل عليهم السلام، وقيل غير ذلك."}]}],"44":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"أفَلَا تَعْقِلُونَ","meaning":"أفلا تعقلون حجة الله عليكم في هذا"}]}],"48":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلا يُؤْخَذُ مِنْهَا عَدْلٌ","meaning":"أي فِدْيَة"}]}],"51":[{"book":"التبيان في تفسير غريب القرآن","author":"ابن الهائم (ت ٨١٥هـ)","words":[{"text":"وعدنا","meaning":"وعد في الخير والشّر، والوعد في الخير، وأوعد في الشر، وكذلك الإيعاد والوعيد."}]}],"52":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"لعَلَّكُمْ تشْكُرُون","meaning":"في أن بَعَثَكُم بعد الموت"}]}],"54":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَتُوبُوا إِلَى بَارِئِكُمْ","meaning":"خالقكم"},{"text":"فَاقْتُلُوا أَنْفُسَكُمْ","meaning":"ليقتل بعضكم بعضا؛ على ما بينت في كتاب المشكل"},{"text":"فَتَابَ عَلَيْكُمْ","meaning":"ففعلتم فتاب عليكم"},{"text":"قُتِلَ","meaning":"لُعن"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَإِذْ قالَ مُوسى لِقَوْمِهِ","meaning":"معناها: وقال موسى لقومه"}]}],"55":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"نَرَى اللَّهَ جَهْرَةً","meaning":"علانية ظاهرا، لا في نوم ولا في غيره"}]}],"57":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَمَا ظَلَمُونَا","meaning":"ما نقصونا"},{"text":"وَلَكِنْ كَانُوا أَنْفُسَهُمْ يَظْلِمُونَ","meaning":"ينقصون"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الْمَنَّ","meaning":"شىء كان يسقط فى السّحر على شجرهم فيجبتنونه حلوا يأكلونه."}]}],"58":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَقُولُوا حِطَّةٌ","meaning":"رفع، وهى مصدر من حطّ عنا ذنوبنا تقديره مدّة من مددت، حكاية أي قولوا: هذا الكلام، فلذلك رفع."}]}],"59":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَبَدَّلَ الَّذِينَ ظَلَمُوا قَوْلا غَيْرَ الَّذِي قِيلَ لَهُمْ","meaning":"قيل لهم: قولوا: حِطَّةٌ ف"}]}],"60":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فُجِّرَتْ","meaning":"فُجِّر بعضُها إلى بعض"}]}],"61":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"اهْبِطُوا مِصْرًا","meaning":"من الأمصار لأنهم كانوا فى تيه"}]}],"65":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"اعْتَدَوْا مِنْكُمْ فِي السَّبْتِ","meaning":"ظلموا وتَعَدَّوا ما أُمروا به من ترك الصيد في يوم السبت"}]}],"68":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلا بِكْرٌ","meaning":"أي ولا صغيرة لم تلد، ولكنها عَوَانٌ بين تَيْنِك. ومنه ي"}]}],"69":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"صَفْرَاءُ فَاقِعٌ لَوْنُهَا","meaning":"ناصع صاف"},{"text":"صُفْرٌ","meaning":"إبلٌ سود"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فاقِعٌ لَوْنُها","meaning":"أي ناصع."},{"text":"بَقَرَةٌ صَفْراءُ","meaning":"إن شئت صفراء، وإن شئت سوداء"}]}],"71":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"تُثِيرُ الأَرْضَ","meaning":"تُقَلِّبها للزراعة"},{"text":"وَلا تَسْقِي الْحَرْثَ","meaning":"لا يُسْنَى"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِنَّها بَقَرَةٌ لا ذَلُولٌ تُثِيرُ الْأَرْضَ وَلا تَسْقِي الْحَرْثَ مُسَلَّمَةٌ لا شِيَةَ فِيها","meaning":"أي لون سوى لون جميع جلدها."}]}],"73":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَقُلْنَا اضْرِبُوهُ بِبَعْضِهَا","meaning":"اضربوا القتيل ببعض البقرة"}]}],"74":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"قَسَتْ قُلُوبُكُمْ","meaning":"أي جفت، والقاسي: الجافي اليابس."}]}],"79":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَوَيْلٌ لِلَّذِينَ يَكْتُبُونَ الْكِتَابَ بِأَيْدِيهِمْ ثُمَّ يَقُولُونَ هَذَا مِنْ عِنْدِ اللَّهِ","meaning":"يزيدون في كتب الله ما ليس منها؛ لينالوا بذلك غَرَضًا حقيرًا من الدنيا"}]}],"80":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"قُلْ أَتَّخَذْتُمْ عِنْدَ اللَّهِ عَهْدًا","meaning":"أتخذتم بذلك من الله وعدًا"}]}],"83":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَبِالْوَالِدَيْنِ إِحْسَانًا","meaning":"وَصَّيْناهم بالوالدين إحسانًا"}]}],"84":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"ثُمَّ أَقْرَرْتُمْ","meaning":"ثم قبِلتم ذلك وأقررتم به"}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"ثم أقررتم","meaning":"اعترفتم بأن هذا أخذ عليكم في العهد وأخذ على آبائكم"}]}],"91":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"إِنْ كُنْتُمْ مُؤْمِنِينَ","meaning":"إن كنتم مصدقين"}]}],"96":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بِمُزَحْزِحِهِ","meaning":"بمبعده."}]}],"97":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مُصَدِّقًا لِمَا بَيْنَ يَدَيْهِ","meaning":"لما قبله"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مُصَدِّقًا لِما بَيْنَ يَدَيْهِ","meaning":"أي لما كان قبله."}]}],"101":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"كَتَبَ اللَّهُ","meaning":"لَكُمْ يعني من الولد. أمْرُ تأديب لا فرض. وَكُلُوا وَاشْرَبُوا أمرُ إباحة"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"نَبَذَ فَرِيقٌ","meaning":"أي بعض نبذه: تركه، وقال أبو الأسود الدؤلى، قال أبو عبيدة: أخذ من الدألان، واختار الدؤلى"}]}],"102":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يُفْرَقُ","meaning":"يُفصَل"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَاتَّبَعُوا ما تَتْلُوا الشَّياطِينُ","meaning":"أي تتبّع (؟)، وتتلو: تحكى وتكلم به كما تقول: يتلو كتاب الله أي يقرؤه."},{"text":"وَلَبِئْسَ ما شَرَوْا بِهِ","meaning":"أي: باعوا به أنفسهم، وقال ابن مفرغ الحميرى"}]}],"104":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"انْظُرْنَا","meaning":"انتظرنا"}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"وَقُولُوا انْظُرْنَا","meaning":"أمهلنا واسمعوا"}]}],"106":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"نَأْتِ بِخَيْرٍ مِنْها","meaning":"أي نأتيك منها بخير."}]}],"109":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَاعْفُوا وَاصْفَحُوا","meaning":"عن المشركين، وهذا قبل أن يؤمر بالهجرة والقتال فكل أمر نهى عنه عن مجاهدة الكفار فهو قبل أن يؤمر بالقتال"}]}],"114":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لَهُمْ فِي الدُّنْيَا خِزْيٌ","meaning":"هوان"}]}],"115":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِنَّ اللَّهَ واسِعٌ","meaning":"أي جوا يسع لما يسأل."}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"جه الله","meaning":"فاقصدوا وجه اللَّه بِتَيَمُّمِكم القبلة"}]}],"120":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"حَتَّى تَتَّبِعَ مِلَّتَهُمْ","meaning":"أي دينهم، والملل: الأديان."}]}],"124":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَأَتَمَّهُنَّ","meaning":"عمِل بهن كلِّهن"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَإِذِ ابْتَلى إِبْراهِيمَ رَبُّهُ","meaning":"أي اختبره."}]}],"125":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مَثابَةً","meaning":"مصدر"}]}],"127":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَرْفَعُ","meaning":"أي يبنى."}]}],"128":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَأَرِنا مَناسِكَنا","meaning":"أي علّمنا"}]}],"129":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"عَزِيزٌ","meaning":"لا يمتنع عليه ما يريد - حكيم فيما يدبر"}]}],"130":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"إِلا مَنْ سَفِهَ نَفْسَهُ","meaning":"من سَفِهَت نَفْسُه"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"سَفِهَ نَفْسَهُ","meaning":"أي أهلك نفسه وأوبقها"}]}],"132":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"اصْطَفى لَكُمُ الدِّينَ","meaning":"أي أخلص لكم الدين، من الصفوة."}]}],"137":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَإِنَّمَا هُمْ فِي شِقَاقٍ","meaning":"في عداوة ومُباينة"}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"وَإِنْ تَوَلَّوْا فَإِنَّمَا هُمْ فِي شِقَاقٍ","meaning":"في مشاقة وعداوة ومن هذا قول"}]}],"138":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"صِبْغَةَ اللَّهِ","meaning":"أي دين الله، وخلقته التي خلقه عليها، وهى فطرته، من فاطر أي خالق."}]}],"140":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَمْ تَقُولُونَ إِنَّ إِبْراهِيمَ","meaning":"أم فى موضع ألف الاستفهام، ومجازها: أتقولون."}]}],"143":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لِتَكُونُوا شُهَدَاءَ عَلَى النَّاسِ","meaning":"على الأمم المتقدمة لأنبيائهم"}]}],"144":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"شَطْرَ الْمَسْجِدِ الْحَرامِ","meaning":"أي قصد المسجد الحرام"}]}],"145":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بِكُلِّ آيَةٍ","meaning":"أي علامة، وحجة. َ لِكُلٍّ وِجْهَةٌ هُوَ مُوَلِّيها"}]}],"150":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لِئَلَّا يَكُونَ لِلنَّاسِ عَلَيْكُمْ حُجَّةٌ إِلَّا الَّذِينَ ظَلَمُوا مِنْهُمْ","meaning":"موضع"}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"لِئَلَّا يَكُونَ لِلنَّاسِ عَلَيْكُمْ حُجَّةٌ","meaning":"قد عرفكم اللَّه أمر الاحتجاج في القبلة مما قد بيَّنَّاه لئلا يَكون"}]}],"160":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"إِلا الَّذِينَ تَابُوا وَأَصْلَحُوا وَبَيَّنُوا","meaning":"بَيَّنُوا التوبة بالإخلاص والعمل"}]}],"166":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَتَقَطَّعَتْ بِهِمُ الْأَسْبابُ","meaning":"أي الوصلات التي كانوا يتواصلون عليها فى الدنيا، واحدتها"}]}],"167":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لَوْ أَنَّ لَنَا كَرَّةً","meaning":"رَجْعَة"}]}],"173":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَمَنِ اضْطُرَّ غَيْرَ بَاغٍ","meaning":"غير باغ على المسلمين، مُفَارِقٍ لجماعتهم، ولا عَادٍ عليهم بسيفه"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَما أُهِلَّ بِهِ","meaning":"أي وما أريد به، وله مجاز آخر، أي: ما ذكر عليه من أسماء آلهتهم"},{"text":"غَيْرَ باغٍ وَلا عادٍ","meaning":"أي لا يبغى فيأكله غير مضطر إليه، ولا عاد شبعه."}]}],"177":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَالصَّابِرِينَ فِي الْبَأْسَاءِ","meaning":"في الفقر"},{"text":"وَحِينَ الْبَأْسِ","meaning":"حين الشِّدَّة"},{"text":"وَفِي الرِّقَابِ","meaning":"المُكَاتَبِين"}]}],"178":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَاتِّبَاعٌ بِالْمَعْرُوفِ","meaning":"مطالبة بالمعروف"},{"text":"وَأَدَاءٌ إِلَيْهِ بِإِحْسَانٍ","meaning":"لِيُؤَدِ المُطَالَبُ ما عليه أداء بإحسان لا يَبْخَسُه ولا يَمْطُلُه مطل مُدَافِع"},{"text":"فَمَنِ اعْتَدَى بَعْدَ ذَلِكَ","meaning":"قتل بعد أخذ الدية"}]}],"180":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"كُتِبَ عَلَيْكُمْ إِذَا حَضَرَ أَحَدَكُمُ الْمَوْتُ إِنْ تَرَكَ خَيْرًا","meaning":"مالا"}]}],"182":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنْ مُوصٍ جَنَفًا","meaning":"أي جورا عن الحق، وعدولا"}]}],"184":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَمَنْ كَانَ مِنْكُمْ مَرِيضًا أَوْ عَلَى سَفَرٍ فَعِدَّةٌ مِنْ أَيَّامٍ أُخَرَ","meaning":"فعليه عِدّة من أيام أخر مثل عدة ما فاته"}]}],"185":[{"book":"التبيان في تفسير غريب القرآن","author":"ابن الهائم (ت ٨١٥هـ)","words":[{"text":"الْقُرْآنُ","meaning":"اسم كتاب الله عز وجل، فإنه لا يسمّى به غيره، وإنما سمي قرآنا لأنه يجمع السّور فيضمها، ومنه قول الشاعر:هجان اللّون لم تقرأ جنينا «8»أي لم تضم في رحمها ولدا قط.ويكون القرآن مصدرا كالقراءة، يقال: فلان يقرأ قرآنا حسنا، أي قراءة حسنة  ينبغي أن تقول كتاب الله المنزّل على محمد صلّى الله عليه وسلّم ليتميّز بذلك عن المنزّل على موسى وعيسى وغيرهما."}]}],"186":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَلْيَسْتَجِيبُوا لِي","meaning":"أي يجيبونى"}]}],"191":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَاقْتُلُوهُمْ حَيْثُ ثَقِفْتُمُوهُمْ","meaning":"حيث وجدتموهم"}]}],"195":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"التَّهْلُكَةِ","meaning":"والهلاك، والهلك، والهلك واحد."}]}],"196":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَمَا اسْتَيْسَرَ مِنَ الْهَدْيِ","meaning":"فما تَيَسَّرَ من الهَدْي وأمكن"},{"text":"أَوْ نُسُكٍ","meaning":"ذَبْح"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَإِنْ أُحْصِرْتُمْ","meaning":"أي إن قام [بكم] بعير، أو مرضتم، أو ذهبت نفقتكم، أو فاتكم الحجّ، فهذا [كله] محصر"}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"أَوْ نُسُكٍ","meaning":"أو نَسيكة يذبحها"}]}],"197":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلا جِدَالَ","meaning":"لا مِرَاء"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَمَنْ فَرَضَ فِيهِنَّ الْحَجَّ","meaning":"من أو ذم فى الحج: أي فرضه عليه أي ألزمه نفسه."},{"text":"فَلا رَفَثَ","meaning":"أي لا لغا"}]}],"198":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَإِذَا أَفَضْتُمْ","meaning":"دَفَعْتُم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَإِذا أَفَضْتُمْ","meaning":"أي رجعتم من حيث جئتم. [معدودات]"}]}],"201":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"آتِنَا فِي الدُّنْيَا حَسَنَةً","meaning":"نعمة"}]}],"205":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَإِذَا تَوَلَّى","meaning":"فارقك"}]}],"206":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلَبِئْسَ الْمِهَادُ","meaning":"الفِراش"}]}],"210":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَقُضِيَ الأَمْرُ","meaning":"فُرِغَ منه"},{"text":"هَلْ يَنْظُرُونَ","meaning":"هل ينتظرون"}]}],"212":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بِغَيْرِ حِسابٍ","meaning":"بغير محاسبة."}]}],"213":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أُمَّةً واحِدَةً","meaning":"أي ملّة واحدة."}]}],"214":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"أَمْ حَسِبْتَ","meaning":"أحسبت"}]}],"216":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَهُوَ كُرْهٌ لَكُمْ","meaning":"مشقّة"}]}],"217":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"حَبِطَتْ أَعْمالُهُمْ","meaning":"أي بطلت وذهبت."}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"أكبر عند اللَّه","meaning":"أعظم إِثْمًا"}]}],"229":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِلَّا أَنْ يَخافا أَلَّا يُقِيما حُدُودَ اللَّهِ","meaning":"معناها: إلّا أن يوقنا."},{"text":"فَإِنْ خِفْتُمْ","meaning":"هاهنا: فإن أيقنتم."}]}],"230":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"لِقَوْمٍ يَعْلَمُونَ","meaning":"يعلمون أن وعد اللَّه حق وأن ما أتى به رسوله صدق"}]}],"231":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"اذْكُرُوا نِعْمَتَ اللَّهِ عَلَيْكُمْ","meaning":"احفَظُوها"}]}],"232":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"تَراضَوْا بَيْنَهُمْ بِالْمَعْرُوفِ","meaning":"أي تزويجا صحيحا"},{"text":"فَلا تَعْضُلُوهُنَّ","meaning":"أي لا تحبسوهن، ونرى أن أصله من التعضيل."}]}],"233":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"وَعَلَى الْوَارِثِ مِثْلُ ذَلِكَ","meaning":"عليه ترك الإِضرار"}]}],"234":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَإِذَا بَلَغْنَ أَجَلَهُنَّ","meaning":"منتهى العدَّة"}]}],"235":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلا تَعْزِمُوا عُقْدَةَ النِّكَاحِ","meaning":"لا تُوَاقِعوا عُقْدَة النكاح"}]}],"237":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِلَّا أَنْ يَعْفُونَ","meaning":"هن: يتركن، يهبن، عفوت لك عن كذا وكذا: تركته لك."}]}],"246":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"كُتِبَ عَلَيْهِ","meaning":"على شيطانه"}]}],"247":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بَسْطَةً فِي الْعِلْمِ وَالْجِسْمِ","meaning":"أي زيادة، وفضلا وكثرة."}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"وَلَمْ يُؤْتَ سَعَةً مِنَ الْمَالِ","meaning":"لم يؤت ما تَتَمَلَّكُ به الملوك"}]}],"249":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَظُنُّونَ أَنَّهُمْ مُلاقُوا اللَّهِ","meaning":"يوقنون."}]}],"250":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"أَفْرِغْ عَلَيْنَا صَبْرًا","meaning":"صُبَّه علينا، كما يُفرغ الدّلوُ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَفْرِغْ عَلَيْنا صَبْرًا","meaning":"» أي أنزل علينا. «خُلَّةٌ"}]}],"256":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"العروة الوثقى","meaning":"شبّه بالعرى التي يتمسك بها."}]}],"259":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لَمْ يَتَسَنَّهْ","meaning":"»: وفى الداني"}]}],"265":[{"book":"التبيان في تفسير غريب القرآن","author":"ابن الهائم (ت ٨١٥هـ)","words":[{"text":"الطّلّ","meaning":"المطر الصّغير القطر."}]},{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَتَثْبِيتًا مِنْ أَنْفُسِهِمْ","meaning":"تحقيقًا من أنفسهم"}]}],"275":[{"book":"التبيان في تفسير غريب القرآن","author":"ابن الهائم (ت ٨١٥هـ)","words":[{"text":"الرِّبا","meaning":"أصله الزّيادة لأن صاحبه يزيد على ماله، ومنه قولهم: أربى فلان على فلان، إذا زاد عليه في القول."}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الْمَسِّ","meaning":"من الشيطان، والجن، وهو اللّمم، وهو ما ألمّ به، وهو الأولق والألس والزّؤد، هذا كله مثل الجنون."}]}],"282":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"ترضون من الشهداءِ","meaning":"ممن ترضون مذهبه"}]}],"285":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"كُلٌّ آمَنَ بِاللَّهِ","meaning":"صدق بالله وملائكته وكتبه"}]}],"286":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا","meaning":"إلا قدرَ طَاقَتها"}]}]}
