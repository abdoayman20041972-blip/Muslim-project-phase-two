{"5":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَأُهْلِكُوا بِالطَّاغِيَةِ","meaning":"بالطغيان"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَأُهْلِكُوا بِالطَّاغِيَةِ","meaning":"بطغيانهم"}]}],"6":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"بِرِيح صَرْصَرٍ عَاتِيَةٍ","meaning":"بريح شديدة البرد جدًّا"}]}],"7":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"سَخَّرَها عَلَيْهِمْ","meaning":"أدامها عليهم ليس فيها فتور."},{"text":"حُسُومًا","meaning":"متتابعة"},{"text":"أَعْجازُ نَخْلٍ خاوِيَةٍ","meaning":"أصولها، مجازها لغة من أنّث النخل.."}]}],"8":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَهَلْ تَرَى لَهُمْ مِنْ بَاقِيَةٍ","meaning":"أثرٍ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَهَلْ تَرى لَهُمْ مِنْ باقِيَةٍ","meaning":"من بقية ومجازها مجاز الطاغية مصدر"}]}],"9":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"بِالْخَاطِئَةِ","meaning":"بالذنوب"}]}],"10":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَخْذَةً رابِيَةً","meaning":"نامية زائدة شديدة من الرباء.."}]}],"12":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَتَعِيَها أُذُنٌ واعِيَةٌ","meaning":"من وعيت.."}]}],"13":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَإِذا نُفِخَ فِي الصُّورِ نَفْخَةٌ واحِدَةٌ","meaning":"لما جاءت المصادر صفة جرى على مجرى الاسم الذي لم يذكر فاعله ولو جاء بغير صفة لقلت: ضرب"}]}],"36":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنْ غِسْلِينٍ","meaning":"كل جرح غسلته فخرج منه شىء فهو غسلين، فعلين من الغسل من الجراح والوبر"}]}],"46":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الْوَتِينَ","meaning":"نياط القلب"}]}]}
