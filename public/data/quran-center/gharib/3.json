:"أي بل هم أحياء."}]}],"175":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"إِنَّمَا ذَلِكُمُ الشَّيْطَانُ يُخَوِّفُ أَوْلِيَاءَهُ","meaning":"أي يخوفكم بأوليائه كما"}]}],"176":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يُرِيدُ اللَّهُ أَلَّا يَجْعَلَ لَهُمْ حَظًّا","meaning":"أي نصيبا."}]}],"178":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"نُمْلِي لَهُمْ","meaning":"نُطيل لهم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِنَّما نُمْلِي لَهُمْ لِيَزْدادُوا إِثْمًا","meaning":"فكسرت ألف"}]}],"185":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"زُحْزِحَ عَنِ النَّارِ","meaning":"نحِّي عنها وأُبْعِد"}]}],"187":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَنَبَذُوهُ وَراءَ ظُهُورِهِمْ","meaning":"أي لم يلتفتوا إليه يقال: نبذت حاجتى خلف ظهرك، إذا لم يلتفت إليها، قال أبو الأسود الدؤلى"}]}],"188":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"بِمَفَازَةٍ مِنَ الْعَذَابِ","meaning":"بمنجاة ومنه ي"}]}],"191":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"فَقِنَا عَذَابَ النَّارِ","meaning":"فقد صدقنا رسلك وأن لَكَ جَنةً ونَارًا فَقِنَا عَذَابَ النَّارِ"}]}],"196":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لا يَغُرَّنَّكَ تَقَلُّبُ الَّذِينَ كَفَرُوا فِي الْبِلادِ","meaning":"تصرّفهم في التجارات وإصابتهم الأموال"}]}],"198":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"نُزُلا مِنْ عِنْدِ اللَّهِ","meaning":"ثوابا ورزقا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"نُزُلًا مِنْ عِنْدِ اللَّهِ","meaning":"أي ثوابا، ويجوز منزلا من عند الله من قولك: أنزلته منزلا."}]}],"200":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَرابِطُوا","meaning":"أي اثبتوا ودوموا"}]}]}
