{"7":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فِي قُلُوبِهِمْ زَيْغٌ","meaning":"جَوْر"},{"text":"ابْتِغَاءَ الْفِتْنَةِ","meaning":"الكفر"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فِي قُلُوبِهِمْ زَيْغٌ","meaning":"أي جور."}]}],"8":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنْ لَدُنْكَ","meaning":"أي من عندك."}]}],"9":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لا رَيْبَ فِيهِ","meaning":"لا شك فيه."}]}],"11":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"كَدَأْبِ آلِ فِرْعَوْنَ","meaning":"كعادتهم يريد كفر اليهود ككفر مَن قبلهم"}]}],"12":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الْمِهادُ","meaning":"الفراش."}]}],"13":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"قَدْ كانَ لَكُمْ آيَةٌ","meaning":"أي علامة."},{"text":"فِي فِئَتَيْنِ","meaning":"أي فى جماعتين."},{"text":"يُؤَيِّدُ","meaning":"يقوى، من الأيد، وإن شئت من الأد."}]}],"14":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مُسَوَّمَةً","meaning":"مُعَلَّمَةً"}]}],"18":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بِالْقِسْطِ","meaning":"أقسط: مصدر المقسط وهو العادل والقاسط: الجائر."}]}],"27":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَتُخْرِجُ الْحَيَّ مِنَ الْمَيِّتِ","meaning":"أي الطيّب من الخبيث، والمسلم من الكافر."}]}],"32":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَإِنْ تَوَلَّوْا","meaning":"أعرضوا"}]}],"35":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مُحَرَّرًا","meaning":"أي عتيقا لله، أعتقته وحرّرته واحد."}]}],"39":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بِكَلِمَةٍ مِنَ اللَّهِ","meaning":"أي بكتاب من الله تقول العرب للرجل: أنشدنى كلمة كذا وكذا، أي قصيدة"}]}],"40":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَقَدْ بَلَغَنِيَ الْكِبَرُ","meaning":"أي بلغت الكبر، والعرب تصنع مثل هذا، تقول: هذا القميص لا يقطعنى أي أنت لا تقطعه"}]}],"44":[{"b