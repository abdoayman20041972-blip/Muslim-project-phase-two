{"2":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَهُمْ لا يُفْتَنُونَ","meaning":"لا يُقْتَلُون و[لا] يعذَّبُون"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَهُمْ لا يُفْتَنُونَ","meaning":"مجازه: وهم لا يبتلون، من بلوته أي خبرته.."}]}],"3":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلَقَدْ فَتَنَّا الَّذِينَ مِنْ قَبْلِهِمْ","meaning":"ابتليناهم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَلَيَعْلَمَنَّ اللَّهُ الَّذِينَ صَدَقُوا","meaning":"مجازه: فليميزنّ الله لأن الله قد علم ذلك من قبل"}]}],"10":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَإِذا أُوذِيَ فِي اللَّهِ جَعَلَ فِتْنَةَ النَّاسِ كَعَذابِ اللَّهِ","meaning":"مجازه: جعل أذى الناس.."}]}],"11":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلَيَعْلَمَنَّ اللَّهُ الَّذِينَ آمَنُوا وَلَيَعْلَمَنَّ الْمُنافِقِينَ","meaning":"مجازه: وليميزن الله هؤلاء من هؤلاء.."}]}],"12":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"اتَّبِعُوا سَبِيلَنا وَلْنَحْمِلْ خَطاياكُمْ","meaning":"مجازه: اتبعوا ديننا.."}]}],"13":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلَيَحْمِلُنَّ أَثْقالَهُمْ وَأَثْقالًا مَعَ أَثْقالِهِمْ","meaning":"مجازها: وليحملن أوزارهم"},{"text":"عَمَّا كانُوا يَفْتَرُونَ","meaning":"أي يكذبون ويخترعون.."}]}],"14":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الطُّوفانُ","meaning":"مجازه: كل ما طام فاش من سيل كان أو من غيره وهو كذلك من الموت إذا كان جارفا"}]}],"17":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَتَخْلُقُونَ إِفْكًا","meaning":"مجازه: تختلقون وتفترون.."}]}],"19":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَوَلَمْ يَرَوْا كَيْفَ يُبْدِئُ اللَّهُ الْخَلْقَ","meaning":"مجازه: كيف استأنف الخلق الأول.."}]}],"20":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"كَيْفَ بَدَأَ الْخَلْقَ ثُمَّ اللَّهُ يُنْشِئُ النَّشْأَةَ الْآخِرَةَ","meaning":"مجاز"}]}],"21":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَإِلَيْهِ تُقْلَبُونَ","meaning":"أي ترجعون.."}]}],"25":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"الدنيا","meaning":"أُلْفَتُكُمْ واجتماعكم على الأصنَامِ مَوَدَّةٌ بينكم في الحياة"}]}],"26":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَقالَ إِنِّي مُهاجِرٌ إِلى رَبِّي","meaning":"كل من خرج من داره أو قطع شيئا فقد هاجر ومنه: مهاجر والمسلمين.."}]}],"35":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"تَرَكْنا مِنْها آيَةً","meaning":"مجازه: أبقينا منها علامة.."}]}],"36":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَارْجُوا الْيَوْمَ الْآخِرَ","meaning":"مجازه: وأخشو اليوم الآخر"},{"text":"وَلا تَعْثَوْا فِي الْأَرْضِ مُفْسِدِينَ","meaning":"مجازه من: عثبت تعثى عثوّا هو أشد مبالغة من عثيت تعيث."}]}],"40":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَرْسَلْنا عَلَيْهِ حاصِبًا","meaning":"أي ريحا عاصفا فيها حصى ويكون فى كلام العرب: الحاصب من الجليد ونحوه أيضا"}]}],"58":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لَنُبَوِّئَنَّهُمْ مِنَ الْجَنَّةِ غُرَفًا","meaning":"لنُنزلَنَّهم"}]}],"60":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَكَأَيِّنْ مِنْ دَابَّةٍ لا تَحْمِلُ رِزْقَهَا","meaning":"مجازه: وكم من دابة، ومجاز الدابة: أن كل شىء يحتاج إلى الأكل والشرب فهو دابة من إنس أو غيرهم"}]}],"64":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الدَّارَ الْآخِرَةَ لَهِيَ الْحَيَوانُ","meaning":"مجازه: الدار الآخرة هى الحيوان، واللام تزاد للتوكيد"}]}]}
