{"4":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"ذَلِكُمْ قَوْلُكُمْ بِأَفْوَاهِكُمْ","meaning":"قولُكم على التَّشبيهِ والمجازِ، لا على الحقيقة"}]}],"5":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"هُوَ أَقْسَطُ عِنْدَ اللَّهِ","meaning":"أعدلُ وأصحُّ"}]}],"10":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَإِذْ زَاغَتِ الأَبْصَارُ","meaning":"عَدَلتْ"},{"text":"وَبَلَغَتِ الْقُلُوبُ الْحَنَاجِرَ","meaning":"كادت تبلُغ الحُلوقَ من الخوف"}]}],"11":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَزُلْزِلُوا زِلْزَالا شَدِيدًا","meaning":"شُدِّد عليهم وهُوِّل"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"زُلْزِلُوا زِلْزالًا شَدِيدًا","meaning":"أي ابتلوا وفتنوا ومنه الزلازل.."}]}],"13":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"إِنَّ بُيُوتَنَا عَوْرَةٌ","meaning":"خاليةٌ، فقد أمْكَن من أراد دخولَها، وأصل \"العورة\": ما ذهب عنه السِّترُ والحفظُ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَثْرِبَ","meaning":"اسم أرض ومدينة النبي صلى الله عليه فى ناحية من يثرب"},{"text":"لا مُقامَ لَكُمْ","meaning":"مفتوحة الأول ومجازها: لا مكان لكم تقومون فيه"}]}],"14":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلَوْ دُخِلَتْ عَلَيْهِمْ مِنْ أَقْطَارِهَا","meaning":"من جوانبها"},{"text":"ثُمَّ سُئِلُوا الْفِتْنَةَ","meaning":"أي الكفرَ-: لآتَوْهَا أي أعطَوْا ذلك مَن أراده. وَمَا تَلَبَّثُوا بِهَا أي بالمدينة. ومن قرأ: (لأتوها) بقصر الألف"},{"text":"لآتَوْهَا","meaning":"أعطَوْا ذلك مَن أراده"},{"text":"وَمَا تَلَبَّثُوا بِهَا","meaning":"بالمدينة"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنْ أَقْطارِها","meaning":"أي من جوانبها"},{"text":"سُئِلُوا الْفِتْنَةَ لَآتَوْها","meaning":"أي لأعطوها"}]}],"19":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَإِذا ذَهَبَ الْخَوْفُ سَلَقُوكُمْ بِأَلْسِنَةٍ حِدادٍ","meaning":"أي بالغوا فى عيبكم ولا أئمتكم ومنه قولهم خطيب مسلق ومنه الخاطب المسلاق وبالصاد أيضا وقال الأعشى"}]}],"23":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مَنْ قَضَى نَحْبَهُ","meaning":"قُتل"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَمِنْهُمْ مَنْ قَضى نَحْبَهُ","meaning":"أي نذره الذي كان نحب أي نذر والنحب أيضا النفس أي الموت وجعله جرير الخطر العظيم"}]}],"26":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مِنْ صَيَاصِيهِمْ","meaning":"من حُصونهم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الَّذِينَ ظاهَرُوهُمْ","meaning":"أي عاونوهم وهو من التظاهر.."}]}],"31":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَمَنْ يَقْنُتْ مِنْكُنَّ لِلَّهِ وَرَسُولِهِ","meaning":"أي يُطعهْما: وَتَعْمَلْ صَالِحًا نُؤْتِهَا أَجْرَهَا مَرَّتَيْنِ؛ فهذا يدلُّ على أن \"الضِّعفين\" ثَمَّ أيضًا: مِثْلان"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"نُؤْتِها أَجْرَها","meaning":"أي نعطها ثوابها.."}]}],"32":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَلا تَخْضَعْنَ بِالْقَوْلِ","meaning":"فلا تُلِنَّ القولَ"},{"text":"وَقُلْنَ قَوْلا مَعْرُوفًا","meaning":"صحيحًا: لا يُطمع فاجرًا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لَسْتُنَّ كَأَحَدٍ مِنَ النِّساءِ","meaning":"أحد يقع على الذكر والأنثى بلفظ واحد يقع على ما ليس فى الآدميين، يقال: لم أجد فيها أحدا شاة ولا بعيرا"}]}],"37":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَلَمَّا قَضى زَيْدٌ مِنْها وَطَرًا","meaning":"أي أربا وحاجة"}]}],"38":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مَا كَانَ عَلَى النَّبِيِّ مِنْ حَرَجٍ فِيمَا فَرَضَ اللَّهُ لَهُ","meaning":"أحَلَّ الله له"}]}],"42":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بُكْرَةً وَأَصِيلًا","meaning":"ما بين العصر إلى الليل.."}]}],"43":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يُصَلِّي عَلَيْكُمْ","meaning":"يباركُ عليكم"}]}],"50":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"آتَيْتَ أُجُورَهُنَّ","meaning":"مُهورَهن"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَامْرَأَةً مُؤْمِنَةً إِنْ وَهَبَتْ نَفْسَها لِلنَّبِيِّ","meaning":"مجازه: إن تهب والموضع موضع مجازاة والعرب قد تجازى بحرف وتضمر الآخر معهما"}]}],"51":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"تُرْجِي مَنْ تَشاءُ","meaning":"أي تؤخر.."}]}],"52":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"عَلى كُلِّ شَيْءٍ رَقِيبًا","meaning":"أي حفيظا"}]}],"60":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لَنُغْرِيَنَّكَ بِهِمْ","meaning":"لنُسلطَنَّك عليهم، ونُولِعَنَّك بهم"}]}],"63":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لَعَلَّ السَّاعَةَ تَكُونُ قَرِيبًا","meaning":"مجازه مجاز الظرف هاهنا ولو كان وصفا للساعة لكان قريبة وإذا كان ظرفا فإن لفظها فى الواحد والاثنين"}]}],"70":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَقُولُوا قَوْلًا سَدِيدًا","meaning":"قصدا"}]}]}
