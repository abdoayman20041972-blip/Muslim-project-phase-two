{"1":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"عِوَجًا","meaning":"لم يجعل فيه اختلافًا كما"}]}],"2":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لِيُنْذِرَ بَأْسًا شَدِيدًا","meaning":"لينذر ببأس شديد؛ أي عذاب"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنْ لَدُنْهُ","meaning":"من عنده."}]}],"6":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَلَعَلَّكَ باخِعٌ نَفْسَكَ","meaning":"مهلك نفسك"},{"text":"بِهذَا الْحَدِيثِ أَسَفًا","meaning":"أي ندما"}]}],"7":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"زينة لها","meaning":"اختبارًا ومحنة"}]}],"8":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"صَعِيدًا","meaning":"أي مستويا، وجه الأرض."},{"text":"جرزا","meaning":"أي غلظا لا ينبت شيئا والجميع أرضون أجراز"}]}],"9":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَالرَّقِيمِ","meaning":"الوادي"}]}],"10":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"رحمةً","meaning":"للرحمة"}]}],"12":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَحْصى لِما لَبِثُوا أَمَدًا","meaning":"أي غابة."}]}],"14":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"رَبَطْنَا عَلَى قُلُوبِهِمْ","meaning":"ألهمناهم الصبرَ وثَبَّتْنَا قلوبَهم"},{"text":"شَطَطًا","meaning":"غُلُوا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَرَبَطْنا عَلى قُلُوبِهِمْ","meaning":"مجازه: صيّرناهم وألهمناهم الصبر."},{"text":"قُلْنا إِذًا شَطَطًا","meaning":"أي جورا وغلوّا"}]}],"16":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَيُهَيِّئْ لَكُمْ مِنْ أَمْرِكُمْ مِرفَقًا","meaning":"هو ما ارتفق به ويقرؤه قوم مرفقا"}]}],"17":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَهُمْ فِي فَجْوَةٍ","meaning":"متسع وجمعها فَجَوَات وفِجَاءٌ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَهُمْ فِي فَجْوَةٍ مِنْهُ ذلِكَ مِنْ آياتِ اللَّهِ","meaning":"أي متّسع، والجميع فجوات، وفجاء"}]}],"18":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَنُقَلِّبُهُمْ ذاتَ الْيَمِينِ وَذاتَ الشِّمالِ","meaning":"أي على أيمانهم وعلى شمائلهم."},{"text":"باسِطٌ ذِراعَيْهِ بِالْوَصِيدِ","meaning":"على الباب وبفناء الباب جميعا لأن الباب يوصد، أي يغلق، والجميع وصائد ووصد."}]}],"19":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلا يُشْعِرَنَّ بِكُمْ أَحَدًا","meaning":"لا يُعْلمنّ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَيُّها أَزْكى طَعامًا","meaning":"أي أكثر"},{"text":"وَكَذلِكَ بَعَثْناهُمْ","meaning":"أي أحييناهم"}]}],"21":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"أَعْثَرْنَا عَلَيْهِمْ","meaning":"أظهرنا عليهم وأطْلَعْنا، ومنه ي"}]}],"22":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"رَجْمًا بِالْغَيْبِ","meaning":"ظنا غير يقين"}]}],"27":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مُلْتَحَدًا","meaning":"مَعْدِلا"}]}],"28":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلا تَعْدُ عَيْنَاكَ عَنْهُمْ","meaning":"لا تتجاوزهم إلى زينة الحياة الدنيا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلا تَعْدُ عَيْناكَ عَنْهُمْ","meaning":"جزم لأن مجازه مجاز النهى، والموضع: لا تجاوز عيناك، وي"}]}],"29":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَحاطَ بِهِمْ سُرادِقُها","meaning":"كسرادق الفسطاط وهى الحجرة التي تطيف بالفسطاط"}]}],"31":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَساوِرَ مِنْ ذَهَبٍ","meaning":"واحدها: إسوار ومن جعلها سوار فإن جمعه سور وما بين الثلاثة إلى العشرة أسورة."}]}],"33":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَفَجَّرْنا خِلالَهُما نَهَرًا","meaning":"أي وسطهما، وبينهما، وبعضهم يسكّن هاء النهر."}]}],"37":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَهُوَ يُحاوِرُهُ","meaning":"أي يكلّمه، ومعناه من المحاورة."}]}],"38":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لكِنَّا هُوَ اللَّهُ رَبِّي","meaning":"مجازه: لكن أنا هو الله ربى، ثم حذفت الألف الأولى وأدغمت إحدى النونين فى الأخرى فشددت"}]}],"40":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"حُسْبَانًا مِنَ السَّمَاءِ","meaning":"مَرَاميَ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"صَعِيدًا زَلَقًا","meaning":"الصعيد وجه الأرض، والزّلق الذي لا يثبت فيه القدم."},{"text":"حُسْبانًا مِنَ السَّماءِ","meaning":"مجازها: مرامى"}]}],"41":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَوْ يُصْبِحَ ماؤُها غَوْرًا","meaning":"أي غائرا، والعرب قد تصف الفاعل بمصدره وكذلك الاثنين والجميع على لفظ المصدر"}]}],"42":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَأُحِيطَ بِثَمَرِهِ","meaning":"أُهلِك"},{"text":"فَأَصْبَحَ يُقَلِّبُ كَفَّيْهِ","meaning":"نادما وهذا مما يوصف [به] النادم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَأَصْبَحَ يُقَلِّبُ كَفَّيْهِ عَلى ما أَنْفَقَ فِيها","meaning":"أي فأصبح نادما، والعرب تقول ذلك للنادم: أصبح فلان يقلّب كفيه ندما وتلهّفا على ذلك وعلى ما فاته"},{"text":"وَهِيَ خاوِيَةٌ عَلى عُرُوشِها","meaning":"مجازه: خالية على بيوتها."}]}],"44":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَخَيْرٌ عُقْبًا","meaning":"عاقبة"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"هُنالِكَ الْوَلايَةُ لِلَّهِ","meaning":"مصدر الولي، فإذا كسرت الواو فهو مصدر وليت العمل والأمر تليه."},{"text":"خَيْرٌ ثَوابًا وَخَيْرٌ عُقْبًا","meaning":"مجازه مجاز العاقبة والعقبى والعقبة، كلهن واحدة والمعنى الآخرة."}]}],"45":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"تَذْرُوهُ الرِّيَاحُ","meaning":"تنسفه"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"تَذْرُوهُ الرِّياحُ","meaning":"أي تطيّره وتفرقه"}]}],"46":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَخَيْرٌ أَمَلا","meaning":"خير ما تؤمِّلُون"}]}],"47":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَلَمْ نُغَادِرْ مِنْهُمْ أَحَدًا","meaning":"لم نُخَلِّف ي"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَتَرَى الْأَرْضَ بارِزَةً","meaning":"أي ظاهرة."}]}],"50":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَفَسَقَ عَنْ أَمْرِ رَبِّهِ","meaning":"خرج عن طاعته"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَفَسَقَ عَنْ أَمْرِ رَبِّهِ","meaning":"جار عنه وكفر به، وقال رؤبة"}]}],"51":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مُتَّخِذَ الْمُضِلِّينَ عَضُدًا","meaning":"أي أنصارا وعزّا وأعوانا"}]}],"53":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَظَنُّوا أَنَّهُمْ مُوَاقِعُوهَا","meaning":"علموا"},{"text":"وَلَمْ يَجِدُوا عَنْهَا مَصْرِفًا","meaning":"مَعْدِلا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلَمْ يَجِدُوا عَنْها مَصْرِفًا","meaning":"أي معدلا، وقال أبو كبير الهذلي"}]}],"56":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لِيُدْحِضُوا بِهِ الْحَقَّ","meaning":"ليزيلوا به الحق ويذهبوا به"}]}],"60":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"حُقُبًا","meaning":"زمانًا ودهرًا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَوْ أَمْضِيَ حُقُبًا","meaning":"أي زمانا وجميعه أحقاب"}]}],"61":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَاتَّخَذَ سَبِيلَهُ","meaning":"فاتخذ الحوت طريقه في البحر"},{"text":"سَرَبًا","meaning":"مذْهبًا ومَسْلَكَا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فِي الْبَحْرِ سَرَبًا","meaning":"أي مسلكا ومذهبا أي يسرب فيه، وفى آية أخرى"}]}],"64":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"قَصَصًا","meaning":"يَقْتَصَّان الأثَرَ الذي جاء فيه"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَارْتَدَّا عَلى آثارِهِما قَصَصًا","meaning":"مجازه: نكصا على أدبارهما فرجعا قصصا، رجعا يقصان الأثر."}]}],"73":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلا تُرْهِقْنِي","meaning":"لا تُغْشِني"}]}],"74":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"زَكِيَّةً بِغَيْرِ نَفْسٍ","meaning":"أي مطهرّة."}]}],"77":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يُرِيدُ أَنْ يَنْقَضَّ","meaning":"ينكسر ويسقط"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَأَبَوْا أَنْ يُضَيِّفُوهُما","meaning":"أي أن ينزلوهما منزل الأضياف"},{"text":"يُرِيدُ أَنْ يَنْقَضَّ","meaning":"وليس للحائط إرادة ولا للموات ولكنه إذا كان فى هذه الحال من ربه فهو إرادته، وهذا قول العرب"},{"text":"لَوْ شِئْتَ لَاتَّخَذْتَ عَلَيْهِ أَجْرًا","meaning":"الخاء مكسورة، ومعناها معنى أخذت فكان مخرجها مخرج فعلت تفعل"}]}],"80":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَنْ يُرْهِقَهُما","meaning":"أي يغشيهما."}]}],"81":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَأَقْرَبَ رُحْمًا","meaning":"رحمة وعطفا"}]}],"84":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"سَبَبًا","meaning":"عِلْمأ يوصلهُ إلى حَيْثُ يريد"}]}],"85":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَأَتْبَعَ سَبَبًا","meaning":"طريقا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَأَتْبَعَ سَبَبًا","meaning":"أي طريقا وأثرا ومنهجا."}]}],"86":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فِي عَيْنٍ حَمِئَةٍ","meaning":"تقديرها: فعلة ومرسة"}]}],"87":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"عَذَابًا نُكْرًا","meaning":"منكرًا"}]}],"93":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"بَيْنَ السَّدَّيْنِ","meaning":"بين الجبلين"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بَيْنَ السَّدَّيْنِ","meaning":"مضموم إذا جعلوه مخلوقا من فعل الله وإن كان من فعل الآدميين فهو سدّ، مفتوح."}]}],"94":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَأْجُوجَ وَمَأْجُوجَ","meaning":"لا ينصرفان، وبعضهم يهمز ألفيهما وبعضهم لا يهمزها"}]}],"96":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"زُبَرَ الْحَدِيدِ","meaning":"أي قطع الحديد واحدتها زبرة."},{"text":"بَيْنَ الصَّدَفَيْنِ","meaning":"فبعضهم يضمها وبعضهم يفتحها ويحرك الدال، ومجارهما ما بين الناحيتين من الجبلين، وقال"},{"text":"أُفْرِغْ عَلَيْهِ قِطْرًا","meaning":"أي أصب عليه حديدا ذائبا"}]}],"97":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَمَا اسْطاعُوا أَنْ يَظْهَرُوهُ","meaning":"أي أن يعلوه"}]}],"99":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَنُفِخَ فِي الصُّورِ","meaning":"واحدتها صورة خرجت مخرج سورة المدينة والجميع سور المدينة، ومجازه مجاز المختصر المضمر فيه أي نفخ فيها أرواحها."}]}],"104":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يُحْسِنُونَ صُنْعًا","meaning":"أي عملا والصنع والصنعة والصنيع واحد"}]}],"108":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لا يَبْغُونَ عَنْهَا حِوَلا","meaning":"تَحَوُّلا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لا يَبْغُونَ عَنْها حِوَلًا","meaning":"أي لا يريدون ولا يحبّون عنها تحويلا. [تم الجزء الأول من مجاز القرآن]"}]}]}
