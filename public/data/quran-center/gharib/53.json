{"1":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَالنَّجْمِ إِذا هَوى","meaning":"سم والنجم النجوم ذهب إلى لفظ الواحد وهو فى معنى الجميع"}]}],"3":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَما يَنْطِقُ عَنِ الْهَوى","meaning":"أي ما ينطق بالهوى.."}]}],"5":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"شَدِيدُ الْقُوى","meaning":"جماع القوة.."}]}],"6":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"ذُو مِرَّةٍ","meaning":"ذو قوةٍ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ذُو مِرَّةٍ فَاسْتَوى","meaning":"ذو شدة وإحكام"}]}],"9":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"قابَ قَوْسَيْنِ","meaning":"قدر قوسين وقاد، وقيد وقدى قوسين مثلها.."},{"text":"أَوْ أَدْنى","meaning":"أو أقرب.."}]}],"17":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مَا زَاغَ الْبَصَرُ","meaning":"ما عدل"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ما زاغَ الْبَصَرُ","meaning":"ما عدل ولا جار.."}]}],"22":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"تِلْكَ إِذًا قِسْمَةٌ ضِيزَى","meaning":"جائرةٌ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"قِسْمَةٌ ضِيزى","meaning":"ناقصة ضرته حقه، وضزته حقه تضيزه وتضوزه تنقصه"}]}],"32":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الَّذِينَ يَجْتَنِبُونَ كَبائِرَ الْإِثْمِ وَالْفَواحِشَ إِلَّا اللَّمَمَ","meaning":"لم يؤذن لهم فى اللمم وليس هو من الفواحش ولا من كبائر الإثم وقد يستثنى الشيء من الشيء"},{"text":"وَإِذْ أَنْتُمْ أَجِنَّةٌ فِي بُطُونِ أُمَّهاتِكُمْ","meaning":"وهو جمع جنين، تقديره: سرير وأسرّة.."}]}],"34":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَأَعْطَى قَلِيلا وَأَكْدَى","meaning":"قطع"}]}],"39":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَأَنْ لَيْسَ لِلإِنْسَانِ إِلا مَا سَعَى","meaning":"ما عمِل لآخرته"}]}],"40":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"سَوْفَ يُرَى","meaning":"يعلم"}]}],"46":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مِنْ نُطْفَةٍ إِذَا تُمْنَى","meaning":"تقدَّرُ وتُخلَق"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنْ نُطْفَةٍ إِذا تُمْنى","meaning":"إذا تخلق وتقدّر"}]}],"47":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَأَنَّ عَلَيْهِ النَّشْأَةَ الأُخْرَى","meaning":"الخلْق الثانيَ للبعث يوم القيامة"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَأَنَّ عَلَيْهِ النَّشْأَةَ الْأُخْرى","meaning":"يحيى الموتى:."}]}],"53":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَالْمُؤْتَفِكَةَ أَهْوى","meaning":"المؤتفكة المخسوف بها.."}]}],"57":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"أَزِفَتِ الآزِفَةُ","meaning":"قربت القيامة"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَزِفَتِ الْآزِفَةُ","meaning":"أي دنت القيامة.."}]}],"61":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَأَنْتُمْ سامِدُونَ","meaning":"لاهون، يقال: دع عنك سمودك"}]}]}
