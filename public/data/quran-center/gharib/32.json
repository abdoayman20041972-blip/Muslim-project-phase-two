{"5":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"كَانَ مِقْدَارُهُ","meaning":"مسافةُ نزولِه وصعودِه"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ثُمَّ يَعْرُجُ إِلَيْهِ","meaning":"مجازه: ينزل وهو من المعارج أي الدّرج.."}]}],"7":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَحْسَنَ كُلَّ شَيْءٍ خَلَقَهُ","meaning":"مجازه: أحسن خلق كل شىء والعرب تفعل هذا يقدّمون ويؤخرون"}]}],"10":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَقالُوا أَإِذا ضَلَلْنا فِي الْأَرْضِ","meaning":"مجازه: همدنا فلم يوجد لنا لحم ولا عظم.."}]}],"14":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِنَّا نَسِيناكُمْ","meaning":"محازه: إنا تركناكم ولم ننظر إليكم والله ﷿ لا ينسى فيذهب الشيء من ذكره"}]}],"16":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"تَتَجَافَى جُنُوبُهُمْ","meaning":"ترتفعُ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"تَتَجافى جُنُوبُهُمْ عَنِ الْمَضاجِعِ","meaning":"مجازه: ترتفع عنها وتنحّى لأنهم يصلون بالليل"}]}],"24":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَهْدُونَ بِأَمْرِنا","meaning":"أي بما تقوّيهم وبقوتنا.."}]}],"26":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"أَوَلَمْ يَهْدِ لَهُمْ","meaning":"يُبيِّنْ لهم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَوَلَمْ يَهْدِ لَهُمْ","meaning":"الواو مفتوحة لأنها واو الموالاة وليست بواو"}]}],"27":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِلَى الْأَرْضِ الْجُرُزِ","meaning":"أي الغليظة اليابسة التي لم يصبها مطر.."}]}],"28":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَيَقُولُونَ مَتى هذَا الْفَتْحُ","meaning":"مجازه هذا الحكم والثواب والعقاب.."}]}],"30":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَانْتَظِرْ إِنَّهُمْ مُنْتَظِرُونَ","meaning":"هى مكية وكل آية أمر فيها النبي ﷺ بالمكث والانتظار والصّفح والعفو فهى مكية إلى أن أمر بالهجرة"}]}]}
