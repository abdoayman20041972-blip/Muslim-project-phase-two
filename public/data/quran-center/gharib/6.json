"ابن قتيبة","words":[{"text":"وَيَنْعِهِ","meaning":"إدراكه ونُضْجه"},{"text":"طَلْعُهَا","meaning":"حَمْلُها"}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"دَانِيَةٌ","meaning":"قريبة المتناوَل"}]}],"101":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بَدِيعُ السَّماواتِ وَالْأَرْضِ","meaning":"أي مبتدع."}]}],"102":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"عَلى كُلِّ شَيْءٍ وَكِيلٌ","meaning":"أي حفيظ ومحيط."}]}],"104":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"قَدْ جاءَكُمْ بَصائِرُ مِنْ رَبِّكُمْ","meaning":"واحدتها بصيرة، ومجازها: حجج بيّنة واضحة ظاهرة."}]}],"105":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلِيَقُولُوا دَرَسْتَ","meaning":"قرأْت الكتب"}]}],"109":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَما يُشْعِرُكُمْ","meaning":"أي ما يدريكم."}]}],"112":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"زُخْرُفَ الْقَوْلِ غُرُورًا","meaning":"كل شىء حسنته وزيّتته وهو باطل فهو زخرف"}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"وكذلك جعلنا","meaning":"ومثلَ ذلك (جَعَلْنَا فِي كُلِّ قَرْيَةٍ أَكَابِرَ مُجْرِمِيهَا لِيَمْكُرُوا فِيهَا)"}]}],"113":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلِيَقْتَرِفُوا ما هُمْ مُقْتَرِفُونَ","meaning":"مجاز الاقتراف"}]}],"116":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَخْرُصُونَ","meaning":"أي: يظنون ويوقعون"}]}],"123":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَكابِرَ مُجْرِمِيها","meaning":"أي العظماء."},{"text":"لِيَمْكُرُوا فِيها","meaning":"مصدره المكر، وهو الخديعة والحيلة بالفجور والغدر والخلاف"}]}],"125":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الرِّجْسَ","meaning":"سواء، وهما العذاب."}]}],"128":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَبَلَغْنَا أَجَلَنَا","meaning":"الموت"}]}],"135":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"اعْمَلُوا عَلى مَكانَ