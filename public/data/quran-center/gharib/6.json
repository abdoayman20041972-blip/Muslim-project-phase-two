{"1":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَجَعَلَ الظُّلُماتِ وَالنُّورَ","meaning":"أي خلق، والنور الضوء."}]}],"2":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَأَجَلٌ مُسَمًّى عِنْدَهُ","meaning":"مقدم ومؤخر، مجازه وعنده أجل مسمّى، أي وقت مؤقّت."},{"text":"ثُمَّ أَنْتُمْ تَمْتَرُونَ","meaning":"أي تشكّون."}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"تَمتَرَوُنَ","meaning":"تَشكونَ"}]}],"6":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَأَنْشَأْنا","meaning":"أي ابتدأنا، ومنه قولهم: فأنشأ فلان فى ذلك أي ابتدأ فيه."}]}],"9":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لَجَعَلْنَاهُ رَجُلا","meaning":"في صورة رجل"}]}],"14":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فاطِرِ السَّماواتِ","meaning":"أي خالق السموات."}]}],"22":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"أَيْنَ شُرَكَاؤُكُمُ","meaning":"أين آلهتكم التي جعلتموها لي شركاء"}]}],"23":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"ثُمَّ لَمْ تَكُنْ فِتْنَتُهُمْ","meaning":"مقالتهم"}]}],"24":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَضَلَّ عَنْهُمْ مَا كَانُوا يَفْتَرُونَ","meaning":"ذهب عنهم ما كانوا يدعون ويختلقون"}]}],"25":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَساطِيرُ الْأَوَّلِينَ","meaning":"واحدتها أسطورة، وإسطارة لغة، ومجازها مجار الترّهات"}]}],"26":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَهُمْ يَنْهَوْنَ عَنْهُ","meaning":"عن محمد"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَهُمْ يَنْهَوْنَ عَنْهُ وَيَنْأَوْنَ عَنْهُ","meaning":"أي يتباعدون عنه"}]}],"31":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَحْمِلُونَ أَوْزَارَهُمْ عَلَى ظُهُورِهِمْ","meaning":"آثامهم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ما فَرَّطْنا","meaning":"مجازه: ما ضيّعنا."}]}],"33":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَإِنَّ