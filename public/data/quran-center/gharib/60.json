{"1":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"تُلْقُونَ إِلَيْهِمْ بِالْمَوَدَّةِ","meaning":"تُلقون إليهم المودة"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"تُلْقُونَ إِلَيْهِمْ بِالْمَوَدَّةِ","meaning":"مجازها: المودة"},{"text":"تسرّون إليهم بالمودّة","meaning":"مثلها.."}]}],"4":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"قَدْ كَانَتْ لَكُمْ أُسْوَةٌ حَسَنَةٌ","meaning":"عبرةٌ"}]}],"10":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلا تُمْسِكُوا بِعِصَمِ الْكَوَافِرِ","meaning":"بحبالهن"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَامْتَحِنُوهُنَّ","meaning":"أخبروهن، وخبرته وامتحنته.."},{"text":"بِعِصَمِ الْكَوافِرِ","meaning":"العصمة الحبل والسبب.."}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"وَلَا جُنَاحَ عَلَيْكُمْ","meaning":"وَلاَ إِثْمَ عليكم"},{"text":"أَنْ تَنْكِحُوهُنَّ","meaning":"أن تزوجوهُنَّ"}]}],"11":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَعَاقَبْتُمْ","meaning":"أصبتم [منهم] عُقْبَى"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَإِنْ فاتَكُمْ شَيْءٌ مِنْ أَزْواجِكُمْ إِلَى الْكُفَّارِ فعقّبتم","meaning":"وعاقبتم"}]}],"12":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلا يَعْصِينَكَ فِي مَعْرُوفٍ","meaning":"في أمرٍ تأمُرهن به"}]}]}
