{"1":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"هَلْ أَتى عَلَى الْإِنْسانِ","meaning":"مجازها: قد أتى على الإنسان، ليس باستفهام ويحقّق ذلك قول أبى بكر: ليتها كانت تمّت فلم نبتل"}]}],"2":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَمْشاجٍ","meaning":"خلطين"}]}],"10":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَوْمًا عَبُوسًا","meaning":"يومًا تَعْبِسُ فيه الوجوهُ"}]}],"14":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَذُلِّلَتْ قُطُوفُهَا تَذْلِيلا","meaning":"أُدْنِيَتْ منهم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَذُلِّلَتْ قُطُوفُها","meaning":"ثمارها.."}]}],"22":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"سَعْيُكُمْ مَشْكُورًا","meaning":"عملكم.."}]}],"24":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لا تُطِعْ مِنْهُمْ آثِمًا أَوْ كَفُورًا","meaning":"ليس هاهنا تخيير أراد آثما وكفورا.."}]}],"27":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَراءَهُمْ يَوْمًا ثَقِيلًا","meaning":"أي قدّامهم"}]}],"28":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَشَدَدْنَا أَسْرَهُمْ","meaning":"خَلْقَهُم"}]}]}
