{"3":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"هَلْ تَرى مِنْ فُطُورٍ","meaning":"صدوع.."}]}],"4":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَهُوَ حَسِيرٌ","meaning":"كَلِيلٌ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"خاسِئًا","meaning":"مبعّدا.."},{"text":"وَهُوَ حَسِيرٌ","meaning":"لا يبصر"}]}],"8":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"تَكَادُ تَمَيَّزُ مِنَ الْغَيْظِ","meaning":"تنشقُّ"}]}],"11":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَسُحْقًا","meaning":"بُعدًا"}]}],"15":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَامْشُوا فِي مَنَاكِبِهَا","meaning":"جوانبها"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فِي مَناكِبِها","meaning":"فى جوانبها"}]}],"16":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَإِذَا هِيَ تَمُورُ","meaning":"تدور، كما يمور السحاب: إذا دار وجاء وذهب"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَإِذا هِيَ تَمُورُ","meaning":"كما يمور السحاب.."}]}],"19":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِلَى الطَّيْرِ فَوْقَهُمْ صافَّاتٍ","meaning":"باسطات أجنحتهن ويقبضن فيضربن بأجنحتهن.."}]}],"23":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"قَلِيلًا ما تَشْكُرُونَ","meaning":"تشكرون قليلا.."}]}],"27":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَلَمَّا رَأَوْهُ زُلْفَةً","meaning":"قريبًا منهم"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"رَأَوْهُ زُلْفَةً","meaning":"قربة"}]}],"30":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَصْبَحَ ماؤُكُمْ غَوْرًا","meaning":"مجازها: غائرا والغور مصدر وقد تفعل العرب ذلك"}]}]}
