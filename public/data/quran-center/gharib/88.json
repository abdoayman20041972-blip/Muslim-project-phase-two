{"5":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنْ عَيْنٍ آنِيَةٍ","meaning":"مثل حميم.."}]}],"6":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِلَّا مِنْ ضَرِيعٍ","meaning":"الضريع عند العرب الشّبرق شجر.."}]}],"15":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"نَمارِقُ مَصْفُوفَةٌ","meaning":"واحدها نمرقة وهى الوسائد.."}]}],"16":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَزَرابِيُّ مَبْثُوثَةٌ","meaning":"الزرابي البسط واحدتها زربية وزربى، والزرابي فى لغة أخرى: الشّوىّ ذكيت"}]}],"19":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"كَيْفَ نُصِبَتْ","meaning":"رفعت.."}]}],"20":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"سُطِحَتْ","meaning":"بُسِطَتْ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"كَيْفَ سُطِحَتْ","meaning":"بسطت، يقال: جبل مسطح، إذا كان فى أعلاه استواء"}]}],"22":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لَسْتَ عَلَيْهِمْ بِمُصَيْطِرٍ","meaning":"بمسلَّط"}]}]}
