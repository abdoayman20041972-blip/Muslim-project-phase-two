{"1":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"اقْتَرَبَ لِلنَّاسِ حِسَابُهُمْ","meaning":"قربتْ القيامةُ"}]}],"3":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَأَسَرُّوا النَّجْوَى الَّذِينَ ظَلَمُوا","meaning":"خرج تقدير فعل الجميع هاهنا على غير المستعمل فى المنطق لأنهم يقولون فى الكلام وأسروا النّجوى الذين ظلموا"}]}],"11":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"قَصَمْنَا مِنْ قَرْيَةٍ","meaning":"أهلكنا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"قَصَمْنا","meaning":"أهلكنا.."}]}],"12":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"إِذَا هُمْ مِنْهَا يَرْكُضُونَ","meaning":"يَعْدُون"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِذا هُمْ مِنْها يَرْكُضُونَ","meaning":"أي يهربون ويسرعون ويعدون ويعجلون، والمرأة تركض ذيلها برجليها إذا مشت، أي تحرّكه"},{"text":"فَلَمَّا أَحَسُّوا بَأْسَنا","meaning":"أي لقوه ورأوه، يقال: هل أحسست فلانا، أي هل وجدته ورأيته ولقيته"}]}],"17":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لَوْ أَرَدْنَا أَنْ نَتَّخِذَ لَهْوًا","meaning":"ولدًا"},{"text":"لاتَّخَذْنَاهُ مِنْ لَدُنَّا","meaning":"مِنْ عندِنا لا عندِكم"}]}],"18":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَيَدْمَغُهُ","meaning":"يكسره"},{"text":"فَإِذَا هُوَ زَاهِقٌ","meaning":"زائلٌ ذاهب"}]}],"19":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلا يَسْتَحْسِرُونَ","meaning":"لا يعيون"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لا يَسْتَحْسِرُونَ","meaning":"أي لا يفترون ولا يعيون ولا يملّون"}]}],"21":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"هُمْ يُنْشِرُونَ","meaning":"يُحيون الموتى"}]}],"30":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"كَانَتَا رَتْقًا","meaning":"كانتا شيئا واحدًا مُلْتَئِمًا، ومنه ي"}]}],"33":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"كُلٌّ فِي فَلَكٍ يَسْبَحُونَ","meaning":"الفلك: القطب الذي تدور به النجوم"}]}],"3