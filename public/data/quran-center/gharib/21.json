 واختلفوا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَتَقَطَّعُوا أَمْرَهُمْ بَيْنَهُمْ","meaning":"مجازه واختلفوا وتفرقوا.."}]}],"94":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَلا كُفْرَانَ لِسَعْيِهِ","meaning":"لا نجْحَدُ ما عَمِل"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَلا كُفْرانَ لِسَعْيِهِ","meaning":"أي فلا كفر لعمله، وقال"}]}],"96":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَهُمْ مِنْ كُلِّ حَدَبٍ","meaning":"من كل نَشْزٍ من الأرض وأكَمَةٍ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَنْسِلُونَ","meaning":"يعجلون فى مشيهم كما ينسل الذئب ويعسل"}]}],"98":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"حَصَبُ جَهَنَّمَ","meaning":"كل شىء ألقيته فى نار فقد حصبتها"}]}],"99":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لَوْ كانَ هؤُلاءِ آلِهَةً ما وَرَدُوها","meaning":"فهو من الموات الذي خرج مخرج الآدميين.."}]}]}
