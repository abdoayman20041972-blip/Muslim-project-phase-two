{"1":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"النور","meaning":"من ظلمات الكفر إلى نور الِإسلام"}]}],"3":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَيَبْغُونَها عِوَجًا","meaning":"يلتمسون، ويحتالون لها عوجا، مكسور الأول مفتوح الثاني وذلك فى الدّين وغيره"}]}],"6":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَسُومُونَكُمْ","meaning":"أي يولونكم ويبلونكم."}]}],"9":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فردّوا أيديهم فى أفواههم","meaning":"مجازه مجاز المثل، وموضعه موضع كفّوا عما أمروا بقوله من الحق ولم يؤمنوا به ولم يسلموا، وي"}]}],"10":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فاطِرِ","meaning":"أي خالق."}]}],"13":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَأَوْحَى إِلَيْهِمْ","meaning":"أَوْمَأَ"}]}],"14":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"خافَ مَقامِي","meaning":"مجازه: حيث أقيمه بين يدى للحساب."}]}],"15":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"عَنِيدٍ","meaning":"وعاند كلها، واحد والمعنى جائر عاند عن الحق"},{"text":"وَاسْتَفْتَحُوا","meaning":"مجازه: واستنصروا"}]}],"19":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَلَمْ تَرَ أَنَّ اللَّهَ خَلَقَ","meaning":"ألم تعلم، ليس رؤية عين."}]}],"25":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"تُؤْتِي أُكُلَها كُلَّ حِينٍ","meaning":"أي تخرج تمرتها، والحين هاهنا ستة أشهر أو نحو ذلك."}]}],"28":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"دارَ الْبَوارِ","meaning":"أي الهلاك والفناء"}]}],"30":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَجَعَلُوا لِلَّهِ أَنْدادًا","meaning":"أي أضدادا، واحدهم ندّ ونديد"}]}],"33":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الشَّمْسَ وَالْقَمَرَ دائِبَيْنِ","meaning":"والشمس أثنى والقمر ذكر فإذا جمعا ذكّر صفتهما لأنّ صفة المذكر تغلب صفة المؤنث."}]}],"43":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مُهْطِعِينَ","meaning":"أي مسرعين"},{"text":"مُقْنِعِي رُؤُسِهِمْ","meaning":"مجازه: رافعى رؤوسهم"}]}],"46":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَإِنْ كانَ مَكْرُهُمْ لِتَزُولَ مِنْهُ الْجِبالُ","meaning":"أي ما كان مكرهم لتزول منه الجبال، فى قول من كسر لام"}]}],"47":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"ذو انتقام","meaning":"بَيَنهُمْ يوم تبدل الأرض غير الأرض"}]}]}
