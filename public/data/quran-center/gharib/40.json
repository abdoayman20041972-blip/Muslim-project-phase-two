{"3":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"غافِرِ الذَّنْبِ وَقابِلِ التَّوْبِ","meaning":"مجازها أن يكون مصدرا وجماعا.."},{"text":"ذِي الطَّوْلِ","meaning":"ذى التفضل تقول العرب للرجل: إنه لذو طول على قومه أي ذو فضل عليهم"}]}],"4":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَلا يَغْرُرْكَ تَقَلُّبُهُمْ فِي الْبِلادِ","meaning":"تصرُّفهم في البلاد للتجارةِ وما يكسبون"}]}],"5":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَهَمَّتْ كُلُّ أُمَّةٍ بِرَسُولِهِمْ لِيَأْخُذُوهُ","meaning":"ليُهلكوه"}]}],"15":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يُلْقِي الرُّوحَ مِنْ أَمْرِهِ","meaning":"الوحيَ"}]}],"32":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَوْمَ التَّنَادِ","meaning":"يوم يَتَنَادى الناسُ: يُنادي بعضهم بعضًا"}]}],"37":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فِي تَبَابٍ","meaning":"بطلان"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فِي تَبابٍ","meaning":"فى هلكة.."}]}],"40":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يُرْزَقُونَ فِيهَا بِغَيْرِ حِسَابٍ","meaning":"بغير تقدير"}]}],"49":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لِخَزَنَةِ جَهَنَّمَ","meaning":"خازن وخزنة مثل ظالم وظلمة وفاعل وفعله."}]}],"60":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"دَاخِرِينَ","meaning":"صاغرين"}]}],"67":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ثُمَّ يُخْرِجُكُمْ طِفْلًا","meaning":"مجازها أطفالا والعرب قد تضع لفظ الواحد على معنى الجميع"}]}],"75":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"ذَلِكُمْ بِمَا كُنْتُمْ تَفْرَحُونَ فِي الأَرْضِ","meaning":"تَبطَرون"}]}],"83":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَرِحُوا بِمَا عِنْدَهُمْ مِنَ الْعِلْمِ","meaning":"رضوا به"}]}],"85":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"سُنَّتَ اللَّهِ الَّتِي قَدْ خَلَتْ فِي عِبادِهِ","meaning":"نصبها على مصدر ما جاء من فعل على غير لفظها."}]}]}
