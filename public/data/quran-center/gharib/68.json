{"1":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَمَا يَسْطُرُونَ","meaning":"يكتبون"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ن وَالْقَلَمِ","meaning":"كسائر فواتح السور.."},{"text":"وَما يَسْطُرُونَ","meaning":"وما يكتبون"}]}],"3":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَإِنَّ لَكَ لأَجْرًا غَيْرَ مَمْنُونٍ","meaning":"غير مقطوع [ولا منقوص]"}]}],"6":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"بِأَيِّيكُمُ الْمَفْتُونُ","meaning":"أيُّكم المفتونُ"}]}],"9":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لَوْ تُدْهِنُ","meaning":"من المداهنة.."}]}],"13":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"عُتُلٍّ","meaning":"العتلّ الفظّ الكافر فى هذا الموضع وهو الشديد فى كل شىء"},{"text":"بَعْدَ ذلِكَ","meaning":"مع ذلك.."},{"text":"زَنِيمٍ","meaning":"الزنيم المعلّق فى القوم ليس منهم"}]}],"20":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَأَصْبَحَتْ كَالصَّرِيمِ","meaning":"سوداءَ كالليل مُحْتَرِقَةً"}]}],"23":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَهُمْ يَتَخافَتُونَ","meaning":"أي يتسارّون.."}]}],"25":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَغَدَوْا عَلَى حَرْدٍ","meaning":"منعٍ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَغَدَوْا عَلى حَرْدٍ قادِرِينَ","meaning":"مجازها: على منع"}]}],"28":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"قَالَ أَوْسَطُهُمْ","meaning":"أَلَمْ أَقُلْ لَكُمْ لَوْلا تُسَبِّحُونَ"},{"text":"أَلَمْ أَقُلْ لَكُمْ لَوْلا تُسَبِّحُونَ","meaning":"هلا تسبحون"}]}],"40":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"أَيُّهُمْ بِذَلِكَ زَعِيمٌ","meaning":"كفيل"}]}],"42":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَوْمَ يُكْشَفُ عَنْ سَاقٍ","meaning":"عن شدةٍ من الأمر"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَوْمَ يُكْشَفُ عَنْ ساقٍ","meaning":"إذا اشتد الحرب والأمر قيل: قد كشف الأمر عن ساقه"}]}],"43":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"تَرْهَقُهُمْ","meaning":"تغشاهم.."}]}],"48":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"إِذْ نَادَى وَهُوَ مَكْظُومٌ","meaning":"مملوء غَمًّا وكربًا"}]}],"49":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لَنُبِذَ بِالْعَراءِ","meaning":"لألقى بوجه الأرض"}]}]}
