{"5":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَهِيَ تُمْلى عَلَيْهِ","meaning":"أي تقرأ عليه وهى من أمليته عليه"}]}],"10":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"لَكَ قُصُورًا","meaning":"سيعطيك اللَّه في الآخرةِ أكْثَرَ مِمَّا قالوا"}]}],"11":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَأَعْتَدْنا لِمَنْ كَذَّبَ بِالسَّاعَةِ سَعِيرًا","meaning":"ثم جاء بعده"}]}],"12":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِذا رَأَتْهُمْ مِنْ مَكانٍ بَعِيدٍ سَمِعُوا لَها تَغَيُّظًا وَزَفِيرًا","meaning":"والسعير مذكر وهو ما تسعّر من سمار النار، ثم جاء بعده فعل مؤنثة مجازها أنها النار"}]}],"13":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"دَعَوْا هُنالِكَ ثُبُورًا","meaning":"أي هلكة"}]}],"18":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَكَانُوا قَوْمًا بُورًا","meaning":"هَلْكى، وهو من \"بَارَ يَبُور\": إذا هلَك وبطَل"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلكِنْ مَتَّعْتَهُمْ وَآباءَهُمْ","meaning":"أي أنسأتهم وأخّرتهم ومددت لهم.."},{"text":"وَكانُوا قَوْمًا بُورًا","meaning":"واحدهم بائر أي هالك ومنه قولهم: نعوذ بالله من بوار الأيّم"}]}],"19":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَمَنْ يَظْلِمْ مِنْكُمْ","meaning":"يكفرْ"}]}],"21":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَقالَ الَّذِينَ لا يَرْجُونَ لِقاءَنا","meaning":"مجازه لا يخافون ولا يخشون. وقال أبو ذؤيب"}]}],"22":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَيَقُولُونَ حِجْرًا مَحْجُورًا","meaning":"أي حراما محرّما"}]}],"23":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَقَدِمْنَا إِلَى مَا عَمِلُوا مِنْ عَمَلٍ","meaning":"عَمَدْنا إليه"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَقَدِمْنا إِلى ما عَمِلُوا مِنْ عَمَلٍ","meaning":"مجازه وعمدنا إلى ما عملوا"}]}],"25":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"تَشَقَّقُ السَّمَاءُ بِالْغَمَامِ","meaning":"تتشقق عن الغمام"}]}],"26":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَوْمًا عَلَى الْكافِرِينَ عَسِيرًا","meaning":"أي شديدا صعبا.."}]}],"27":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مَعَ الرَّسُولِ سَبِيلًا","meaning":"أي سببا ووصلة"}]}],"36":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"كَذَّبُوا بِآياتِنا","meaning":"أي بكتبنا وعلاماتنا عن الحق."}]}],"38":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَصْحابَ الرَّسِّ","meaning":"أي المعدن"}]}],"39":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"تَبَّرْنَا تَتْبِيرًا","meaning":"أهلَكْنا ودمَّرْنا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَكُلًّا تَبَّرْنا تَتْبِيرًا","meaning":"أي أهلكنا واستأصلنا.."}]}],"40":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"أتَوْا","meaning":"مشركو مَكَّة"}]}],"42":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِنْ كادَ لَيُضِلُّنا عَنْ آلِهَتِنا","meaning":"كاد هاهنا فى موضع المقاربة وقد فرغنا فوق هذا من مواضع"}]}],"43":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"أَفَأَنْتَ تَكُونُ عَلَيْهِ وَكِيلا","meaning":"كَفِيلا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"تَكُونُ عَلَيْهِ وَكِيلًا","meaning":"أي حفيظا.."}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"أَفَأَنْتَ تَكُونُ عَلَيْهِ وَكِيلًا","meaning":"حفيظًا"}]}],"46":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"ثُمَّ قَبَضْنَاهُ إِلَيْنَا قَبْضًا يَسِيرًا","meaning":"خفيًّا"}]}],"47":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَالنَّوْمَ سُبَاتًا","meaning":"راحةً"},{"text":"وَجَعَلَ النَّهَارَ نُشُورًا","meaning":"ينتشِرُون فيه"}]}],"49":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"بَلْدَةً مَيْتًا","meaning":"مخففة بمنزلة تخفيف هيّن وليّن وضيّق: هين ولين وضيق ولم تدخل الهاء فيها"}]}],"53":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَهُوَ الَّذِي مَرَجَ الْبَحْرَيْنِ","meaning":"خَلاهما"},{"text":"وَجَعَلَ بَيْنَهُمَا بَرْزَخًا","meaning":"حاجزا -وكذلك الحَجْز والحِجَاز-: لئلا يختلطا"},{"text":"بَيْنَهُمَا بَرْزَخٌ","meaning":"حاجز: لئلا يحملَ أحدهما على الآخر؛ فيختلطان"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَهُوَ الَّذِي مَرَجَ الْبَحْرَيْنِ","meaning":"إذا تركت الشيء وخلّيته فقد مرجته، ومنه قولهم مرج الأمير الناس أي خلّاهم بعضهم على بعض مرجت دابتك"},{"text":"هذا عَذْبٌ فُراتٌ","meaning":"أي شديد العذوبة.."},{"text":"أُجاجٌ","meaning":"والأجاج أملح الملوحة وما بين ذلك المسوس والزّعاق الذي يحرق كل شىء من ملوحته"},{"text":"وَجَعَلَ بَيْنَهُما بَرْزَخًا","meaning":"كل ما بين شيئين برزخ وما بين الدنيا والآخرة برزخ.."}]}],"59":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الَّذِي خَلَقَ السَّماواتِ وَالْأَرْضَ وَما بَيْنَهُما","meaning":"والسموات جميع فجاءت على تقدير الواحد والعرب إذا جمعوا جميع موات ثم أشركوا بينه وبين واحد جعلوا خبر"}]}],"61":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَجَعَلَ فِيها سِراجًا","meaning":"أي شمسا وضياء"}]}],"63":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَعِبَادُ الرَّحْمَنِ","meaning":"عبيدُ الرحمن"},{"text":"يَمْشُونَ عَلَى الأَرْضِ هَوْنًا","meaning":"مشيًا رُوَيْدًا"}]}],"65":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"كَانَ غَرَامًا","meaning":"هَلَكةً"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِنَّ عَذابَها كانَ غَرامًا","meaning":"أي هلاكا ولزاما لهم ومنه رجل مغرم بالحب حب النساء من الغرم والدّين"}]}],"66":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ساءَتْ مُسْتَقَرًّا وَمُقامًا","meaning":"أي قرارا وإقامة لأنه من أقام أي مخلدا ومنزلا، وقال جرير"}]}],"68":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَلْقَ أَثامًا","meaning":"أي عقوبة."}]}],"69":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يضعّف له العذاب يوم القيامة","meaning":"أي يلق عقوبة وعقابا كما وصف"}]}],"72":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"اللغو","meaning":"كل كلام ليس بحسن وهو فى اليمين لا والله وبلى والله.."}]}],"73":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لَمْ يَخِرُّوا عَلَيْهَا صُمًّا وَعُمْيَانًا","meaning":"لم يتغافلوا عنها: فكأنهم صمٌّ لم يسمعُوها، عميٌ لم يَرَوْها"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لَمْ يَخِرُّوا عَلَيْها صُمًّا وَعُمْيانًا","meaning":"مجازه لم يقيموا عليها تاركين لها لم يقبلوها.."}]}],"77":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"قُلْ ما يَعْبَؤُا بِكُمْ رَبِّي","meaning":"ومنه قولهم ما عبأت بك شيئا"},{"text":"فَسَوْفَ يَكُونُ لِزامًا","meaning":"أي جزاء وهو الفيصل"}]}]}
