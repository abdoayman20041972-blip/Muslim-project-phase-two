{"8":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِلَى الْأَذْقانِ","meaning":"لذقن مجتمع اللحيين.."},{"text":"فَهُمْ مُقْمَحُونَ","meaning":"المقمح والمقنع واحد، تفسيره أي يجذب الذقن حتى يصير فى الصدر ثم يرفع رأسه"}]}],"10":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"سَواءٌ عَلَيْهِمْ أَأَنْذَرْتَهُمْ أَمْ لَمْ تُنْذِرْهُمْ لا يُؤْمِنُونَ","meaning":"لها ثلاثة مواضع، لفظها لفظ الاستفهام وليس باستفهام"}]}],"12":[{"book":"تذكرة الأريب في تفسير الغريب","author":"ابن الجوزي (ت ٥٩٧هـ)","words":[{"text":"وآثارهم","meaning":"خطاهم"}]}],"14":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَعَزَّزْنَا بِثَالِثٍ","meaning":"قوَّيْنَا وشدَّدْنَا"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَعَزَّزْنا بِثالِثٍ","meaning":"أي قوّينا وشددنا"}]}],"19":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"قالُوا طائِرُكُمْ مَعَكُمْ","meaning":"أي حظكم من الخير والشر.."}]}],"20":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"قالَ يا قَوْمِ اتَّبِعُوا الْمُرْسَلِينَ","meaning":"بعض العرب"}]}],"25":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِنِّي آمَنْتُ بِرَبِّكُمْ فَاسْمَعُونِ","meaning":"مثل ذلك ومجازها: اسمعونى اسمعوا منى.."}]}],"31":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَنَّهُمْ إِلَيْهِمْ لا يَرْجِعُونَ","meaning":"عمل الفعل الذي قبلها فيها"}]}],"32":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَإِنْ كُلٌّ","meaning":"إذا خففت"}]}],"33":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الْأَرْضُ الْمَيْتَةُ","meaning":"مخففة الميت والميّت"}]}],"37":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَإِذَا هُمْ مُظْلِمُونَ","meaning":"داخلون في الظلام"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"نَسْلَخُ مِنْهُ النَّهارَ","meaning":"نميّزه منه فنجىء بالظلمة"},{"text":"فَإِذا هُمْ مُظْلِمُونَ","meaning":"أي يقال للرجل: سلخه الله من دينه"}]}],"38":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَالشَّمْسُ تَجْرِي لِمُسْتَقَرٍّ لَهَا","meaning":"موضعٍ تنتهي إليهُ فلا تُجَاوزُه؛ ثم ترجع"}]}],"39":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"حَتَّى عادَ كَالْعُرْجُونِ الْقَدِيمِ","meaning":"هو الإهان إهان العذق الذي فى أعلاه العثاكيل"}]}],"40":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَكُلٌّ فِي فَلَكٍ يَسْبَحُونَ","meaning":"مجاز هذا مجاز الموات الذي أجرى مجرى الناس فى القرآن"}]}],"43":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَلا صَرِيخَ لَهُمْ","meaning":"لا مُغيثَ لهم ولا مُجِيرَ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَلا صَرِيخَ لَهُمْ","meaning":"لا مغيث لهم.."}]}],"49":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَخِصِّمُونَ","meaning":"يَخْتَصِمون"}]}],"51":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَنُفِخَ فِي الصُّورِ","meaning":"جميع صورة فخرجت مخرج بسرة وبسر ولم"},{"text":"مِنَ الْأَجْداثِ","meaning":"واحدها جدث وهى لغة أهل العالية، وأهل نجد يقولون"},{"text":"يَنْسِلُونَ","meaning":"يسرعون، والذئب يعسل وينسل.."}]}],"52":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"هذا ما وَعَدَ الرَّحْمنُ وَصَدَقَ الْمُرْسَلُونَ","meaning":"استئناف.."}]}],"53":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مُحْضَرُونَ","meaning":"مشهدون."}]}],"55":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فى شغل فكهون","meaning":"الفكه الذي يتفكه تقول العرب للرجل إذ كان يتفكه بالطعام أو بالفاكهة أو بأعراض الناس: إن فلانا لفكه"}]}],"57":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلَهُمْ مَا يَدَّعُونَ","meaning":"ما يَتَمَنَّوْن"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ما يَدَّعُونَ","meaning":"أي ما يتمنون"}]}],"59":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَامْتَازُوا الْيَوْمَ أَيُّهَا الْمُجْرِمُونَ","meaning":"انقطِعُوا عن المؤمنين وتَميَّزُوا منهم"}]}],"62":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَلَقَدْ أَضَلَّ مِنْكُمْ جِبِلا كَثِيرًا","meaning":"خَلْقًا"}]}],"66":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَأَنَّى يُبْصِرُونَ","meaning":"فكيف يبصرون؟!"}]}],"67":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"عَلى مَكانَتِهِمْ","meaning":"المكان والمكانة واحد.."}]}],"68":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَمَنْ نُعَمِّرْهُ نُنَكِّسْهُ فِي الْخَلْقِ","meaning":"نَرُدَّه إلى أرذلِ العُمُرِ"}]}],"69":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"وَمَا يَنْبَغِي لَهُ","meaning":"ما يتسهل له ذلك"}]}],"70":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لِيُنْذِرَ مَنْ كَانَ حَيًّا","meaning":"مؤمنًا"}]}],"72":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَمِنْهَا رَكُوبُهُمْ","meaning":"ما يَرْكَبون"}]}],"78":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"وَهِيَ رَمِيمٌ","meaning":"باليةٌ"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَهِيَ رَمِيمٌ","meaning":"الرّفات.."}]}]}
