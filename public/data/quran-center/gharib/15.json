{"4":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِلَّا وَلَها كِتابٌ مَعْلُومٌ","meaning":"أي أجل ومدّة، معلوم: موقّت معروف."}]}],"10":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فِي شِيَعِ الْأَوَّلِينَ","meaning":"فى أمم الأولين واحدتها شيعة والأولياء أيضا شيع."}]}],"14":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فِيهِ يَعْرُجُونَ","meaning":"أي يصعدون والمعارج الدّرج."}]}],"16":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلَقَدْ جَعَلْنا فِي السَّماءِ بُرُوجًا","meaning":"أي منازل للشمس والقمر."}]}],"18":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"شِهَابٌ مُبِينٌ","meaning":"كوكب مضيء"}]}],"19":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَأَلْقَيْنا فِيها رَواسِيَ","meaning":"أي جعلنا وأرسينا، ورست هى أي ثبتت."},{"text":"مِنْ كُلِّ شَيْءٍ مَوْزُونٍ","meaning":"بقدر."}]}],"22":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَأَرْسَلْنَا الرِّياحَ لَواقِحَ","meaning":"مجازها مجاز ملاقح لأن الريح ملقحة للسحاب، والعرب قد تفعل هذا فتلقى الميم لأنها تعيده إلى أصل الكلام"}]}],"39":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"قالَ رَبِّ بِما أَغْوَيْتَنِي","meaning":"مجازه مجاز القسم: بالذي أغويتنى."}]}],"47":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ما فِي صُدُورِهِمْ مِنْ غِلٍّ","meaning":"أي من عداوة وشحناء."},{"text":"سُرُرٍ مُتَقابِلِينَ","meaning":"مضمومة السين والراء الأولى وهذا الأصل، وبعضهم يضمّ السين ويفتح الراء الأولى"}]}],"52":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَجِلُونَ","meaning":"أي خائفون."}]}],"54":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَبِمَ تُبَشِّرُونَ","meaning":"» (١٥/ ٥٤)"}]}],"72":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَعْمَهُونَ","meaning":"أي يجورون ويضلّون"}]}],"75":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لِلْمُتَوَسِّمِينَ","meaning":"أي المتبصرين"}]}],"76":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَإِنَّها لَبِسَبِيلٍ مُقِيمٍ","meaning":"أي بطريق."}]}],"79":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَإِنَّهُما لَبِإِمامٍ مُبِينٍ","meaning":"الإمام كلما ائتممت واهتديت به.»"}]}],"83":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَأَخَذَتْهُمُ الصَّيْحَةُ مُصْبِحِينَ","meaning":"أي الهلكة"}]}],"87":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مَثَانِيَ","meaning":"تُثَنَّى فيه الأنباءُ والقصصُ وذكْرُ الثواب والعقاب"}]}],"91":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"جَعَلُوا الْقُرْآنَ عِضِينَ","meaning":"أي عضوه أعضاء، أي فرّقوه فرقا"}]}],"94":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَاصْدَعْ بِما تُؤْمَرُ","meaning":"أي افرق وامضه"}]}]}
