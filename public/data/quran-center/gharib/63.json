{"4":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"يَحْسَبُونَ كُلَّ صَيْحَةٍ عَلَيْهِمْ","meaning":"كلّما صاح صائح، ظنُّوا أن ذاك أمرٌ عليهم: جُبْنًا [منهم]"},{"text":"هُمُ الْعَدُوُّ فَاحْذَرْهُمْ","meaning":"فهم الأعداء"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"كَأَنَّهُمْ خُشُبٌ مُسَنَّدَةٌ","meaning":"جماعة خشب.."}]}],"7":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"حَتَّى يَنْفَضُّوا","meaning":"حتى يتفرقوا"}]}],"10":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَيَقُولَ رَبِّ لَوْلا أَخَّرْتَنِي","meaning":"مجازها: هلّا.."},{"text":"فَأَصَّدَّقَ","meaning":"نصبت على جواب بالفاء للاستفهام منصوب تقول: من عندك فآتيك"},{"text":"وَأَكُنْ مِنَ الصَّالِحِينَ","meaning":"بغير الواو"}]}]}
