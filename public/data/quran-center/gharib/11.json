{"1":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنْ لَدُنْ","meaning":"أي هذا قرآن من عند لدن ولدن ولدا سواء ولد."}]}],"2":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"آلاءَ اللَّهِ","meaning":"أي نعم الله، وواحدها فى قول بعضهم"}]}],"5":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لِيَسْتَخْفُوا مِنْهُ أَلا حِينَ يَسْتَغْشُونَ ثِيابَهُمْ","meaning":"والعرب تدخل"}]}],"7":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لِيَبْلُوَكُمْ أَيُّكُمْ أَحْسَنُ عَمَلا","meaning":"ليختبرَكم"}]}],"8":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَلا يَوْمَ يَأْتِيهِمْ","meaning":"ألا توكيد وإيجاب وتنبيه."},{"text":"وَحاقَ بِهِمْ","meaning":"أي نزل بهم وأصابهم."}]}],"9":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لَيَؤُسٌ كَفُورٌ","meaning":"مجازه: فعول من يئست."}]}],"10":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلَئِنْ أَذَقْناهُ نَعْماءَ","meaning":"أي أمسناه نعماء."}]}],"37":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الْفُلْكَ","meaning":"واحد وجميع وهى السفينة والسّفن مثل السلام واحدها السلامة مثل نعام ونعامة، وقتاد وقتادة."}]}],"40":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مِنْ كُلٍّ زَوْجَيْنِ اثْنَيْنِ","meaning":"من كلِّ ذكرٍ وأنثى اثنين"},{"text":"وَأَهْلَكَ إِلا مَنْ سَبَقَ عَلَيْهِ الْقَوْلُ","meaning":"سبق القول بِهَلَكَتِهِ"}]}],"44":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"الْجُودِيِّ","meaning":"اسم جبل"}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"وَقُضِيَ الأمْرُ","meaning":"هلاك قوم نوح"},{"text":"بُعْدًا","meaning":"بُعْدًا من رحمة اللَّه"}]}],"55":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"فَكِيدُونِ","meaning":"فاحتالوا"}]}],"56":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِلَّا هُوَ آخِذٌ بِناصِيَتِها","meaning":"مجازه إلا هو فى قبضته وملكه وسلطانه."}]}],"61":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"هُوَ أَنْشَأَكُمْ مِنَ الْأَرْضِ","meaning":"أي ابتدأكم فخلقكم منها."}]}],"70":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"نَكِرَهُمْ","meaning":"وأنكرهم سواء"},{"text":"وَأَوْجَسَ مِنْهُمْ خِيفَةً","meaning":"أي أحسّ وأضمر فى نفسه خوفا."}]}],"73":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"حَمِيدٌ مَجِيدٌ","meaning":"أي محمود ماجد."}]}],"75":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مُنِيبٌ","meaning":"أي راجع تائب."}]}],"77":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"سِيءَ بِهِمْ","meaning":"وهو فعل بهم السوء."}]}],"83":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مُسَوَّمَةً","meaning":"أي معلمة بالسيماء وكانت عليها أمثال الخواتيم."}]}],"92":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَاتَّخَذْتُمُوهُ وَراءَكُمْ ظِهْرِيًّا","meaning":"مجازه: ألقيتموه خلف ظهوركم فلم تلتفتوا إليه"}]}],"108":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"عَطاءً غَيْرَ مَجْذُوذٍ","meaning":"أي غير مقطوع، وي"}]}],"113":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَلا تَرْكَنُوا إِلَى الَّذِينَ ظَلَمُوا","meaning":"أي لا تعدلوا ولا تنزعوا إليهم ولا تميلوا"}]}],"116":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَلَوْلا كانَ مِنَ الْقُرُونِ مِنْ قَبْلِكُمْ أُولُوا بَقِيَّةٍ","meaning":"مجازه: فهلا"}]}]}
