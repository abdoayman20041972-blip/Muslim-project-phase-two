{"6":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَكَذلِكَ يَجْتَبِيكَ رَبُّكَ","meaning":"أي يختارك."}]}],"18":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"فَصَبْرٌ جَمِيلٌ","meaning":"مرفوعان لأن"},{"text":"سَوَّلَتْ لَكُمْ أَنْفُسُكُمْ","meaning":"أي زينت وحسنت"}]}],"20":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَشَرَوْهُ بِثَمَنٍ بَخْسٍ","meaning":"أي باعوه، فإذا بعته أنت قلت: اشتريته"},{"text":"بِثَمَنٍ بَخْسٍ دَراهِمَ مَعْدُودَةٍ","meaning":"جررته على التكرير والبدل."}]}],"21":[{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"وَكَذَلِكَ مَكَّنَّا لِيُوسُفَ فِي الْأَرْضِ","meaning":"ومثل الذي وصفنا مَكنا ليوسف في الأرضِ"}]}],"31":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَكْبَرْنَهُ","meaning":"أجللنه وأعظمنه، ومن زعم أن أكبرنه"},{"text":"وَقُلْنَ حاشَ لِلَّهِ","meaning":"الشين مفتوحة ولا ياء فيه وبعضهم يدخل الياء فى آخره"}]}],"33":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَصْبُ إِلَيْهِنَّ","meaning":"أي أهواهنّ وأميل إليهن"}]}],"45":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَادَّكَرَ بَعْدَ أُمَّةٍ","meaning":"أي افتعل من ذكرت فأدغم التاء فى الذال فحوّلوها دالا ثقيلة"}]}],"48":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"إِلَّا قَلِيلًا مِمَّا تُحْصِنُونَ","meaning":"أي مما تحرزون."}]}],"49":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَفِيهِ يَعْصِرُونَ","meaning":"أي به ينجون"}]}],"65":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَنَمِيرُ أَهْلَنا","meaning":"من مرت تمير ميرا وهى الميرة، أي نأتيهم ونشترى لهم طعومهم"},{"text":"كَيْلَ بَعِيرٍ","meaning":"أي حمل بعير يكال له ما حمل بعير."}]}],"69":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"آوى إِلَيْهِ أَخاهُ","meaning":"وهو يؤوى إليه إيواء، أي ضمّه إليه."}]}],"73":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"تَاللَّهِ","meaning":"التاء بمنزلة واو القسم لأن الواو تحوّل تاء"}]}],"80":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"اسْتَيْأَسُوا مِنْهُ","meaning":"استفعلوا من يئست."},{"text":"خَلَصُوا نَجِيًّا","meaning":"أي اعتزلوا نجيا يتناجون، والنجى يقع لفظه على الواحد والجميع أيضا وقد يجمع، فيقال: بحي وأنجية، وقال لبيد"}]}],"84":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يا أَسَفى عَلى يُوسُفَ","meaning":"خرج مخرج النّدبة، وإذا وقفت عندها قلت: يا أسفاه، فإذا اتصلت ذهبت الياء كما"}]},{"book":"معاني القرآن وإعرابه","author":"الزجاج","words":[{"text":"فَهُوَ كَظِيمٌ","meaning":"محزون"}]}],"85":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"تَفْتَؤُا تَذْكُرُ يُوسُفَ","meaning":"أي لا تزال تذكره"},{"text":"أَوْ تَكُونَ مِنَ الْهالِكِينَ","meaning":"أي من الميّتين. ِنَّما أَشْكُوا بَثِّي وَحُزْنِي إِلَى اللَّهِ"}]}],"87":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"اذْهَبُوا فَتَحَسَّسُوا","meaning":"أي تخبّروا والتمسوا فى المظان."}]}],"92":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لا تَثْرِيبَ عَلَيْكُمُ الْيَوْمَ","meaning":"أي لا تخليط ولا شغب ولا إفساد ولا معاقبة."}]}],"93":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يَأْتِ بَصِيرًا","meaning":"أي يعد بصيرا أي يعد مبصرا."}]}],"100":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"عَلَى الْعَرْشِ","meaning":"أي السرير."},{"text":"مِنَ الْبَدْوِ","meaning":"وهو مصدر بدوت فى البادية."},{"text":"مِنْ بَعْدِ أَنْ نَزَغَ الشَّيْطانُ","meaning":"أي أفسد وحمل بعضنا على بعض."}]}],"107":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"أَوْ تَأْتِيَهُمُ السَّاعَةُ بَغْتَةً","meaning":"أي فجأة"}]}]}
