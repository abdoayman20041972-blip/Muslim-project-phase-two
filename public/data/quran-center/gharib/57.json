{"16":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"أَلَمْ يَأْنِ لِلَّذِينَ آمَنُوا","meaning":"ألم يَحِن"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"وَكَثِيرٌ مِنْهُمْ فاسِقُونَ","meaning":"يقع خبره على لفظ الجميع وعلى الواحد.."}]}],"20":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"كَمَثَلِ غَيْثٍ أَعْجَبَ الْكُفَّارَ نَبَاتُهُ","meaning":"الزُّرَّاع"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ثُمَّ يَهِيجُ","meaning":"ييبس.."}]}],"21":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"عَرْضُهَا كَعَرْضِ السَّمَاءِ وَالأَرْضِ","meaning":"سَعتُها كسعةِ السماء والأرض"}]}],"22":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"مِنْ قَبْلِ أَنْ نَبْرَأَهَا","meaning":"نخلقَها"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"مِنْ قَبْلِ أَنْ نَبْرَأَها","meaning":"نخلقها، الخالق البارئ.."}]}],"23":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لِكَيْلا تَأْسَوْا عَلَى مَا فَاتَكُمْ","meaning":"لا تحزنوا"}]}],"25":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لِيَقُومَ النَّاسُ بِالْقِسْطِ","meaning":"بالعدل"}]}],"27":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"ثُمَّ قَفَّيْنا عَلى آثارِهِمْ","meaning":"أتبعناه.."}]}],"28":[{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"يُؤْتِكُمْ كِفْلَيْنِ مِنْ رَحْمَتِهِ","meaning":"أي مثلين.."}]}],"29":[{"book":"غريب القرآن","author":"ابن قتيبة","words":[{"text":"لِئَلا يَعْلَمَ أَهْلُ الْكِتَابِ أَلا يَقْدِرُونَ","meaning":"ليعلموا أنهم لا يقدرون"}]},{"book":"مجاز القرآن","author":"أبو عبيدة","words":[{"text":"لِئَلَّا يَعْلَمَ أَهْلُ الْكِتابِ","meaning":"مجازها ليعلم أهل الكتاب"}]}]}
